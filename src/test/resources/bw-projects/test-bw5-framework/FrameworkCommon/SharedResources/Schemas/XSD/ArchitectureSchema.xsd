				<xs:element name="CallJMS" type="xs:string" form="unqualified"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="CLEHeaderType">
		<xs:complexContent>
			<xs:extension base="eai:BaseCommonHeader">
				<xs:sequence>
					<xs:element name="EventCode" type="eai:EventCodeType" form="unqualified">
						<xs:annotation>
							<xs:documentation>Código del evento CLE lanzado. Dicho código tiene un máximo de 50 caracteres y determina unívocamente el mensaje que se ha emitido dentro del espacio de tipos de eventos. 
Existen múltitud de códigos en función de la información que se incluya en el mensaje.  </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EventType" type="eai:EventTypes" form="unqualified">
						<xs:annotation>
							<xs:documentation>Tipo de evento lanzado. 
Se distinguen actualmente 4 tipos:
-Auditoría
-Error
-TrazaAplicativa
-Custom</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Timestamp" type="xs:dateTime" form="unqualified">
						<xs:annotation>
							<xs:documentation>Momento en el cual se ha lanzado este mensaje. Debe tener representación hasta milisegundos y estar en UTC. 
Estas restricciones deben aplicarse a nivel de código debido a la imposibilidad de establecer patrones en el tipo de datos DateTime</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ServiceId" type="eai:ServiceIdType" form="unqualified">
						<xs:annotation>
							<xs:documentation>Identificador único del servicio. Este servicio debe tener este identificador definido al pedir un nuevo proyecto de integración. </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InstanceId" type="eai:UUIDType" form="unqualified">
						<xs:annotation>
							<xs:documentation>Identificador único de la instancia de ejecución. </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProjectName" type="xs:string" form="unqualified">
						<xs:annotation>
							<xs:documentation>Nombre de proyecto BW</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProcessName" type="xs:string" form="unqualified">
						<xs:annotation>
							<xs:documentation>Nombre de proceso Bussiness Works. </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EngineName" type="xs:string" form="unqualified">
						<xs:annotation>
							<xs:documentation>Nombre del Engine que está ejecutando el componente que ha lanzado este mensaje</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MachineName" type="xs:string" form="unqualified">
						<xs:annotation>
							<xs:documentation>Nombre DNS de la máquina donde se ejecutó el componente</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageHeader" type="eai:MessageHeaderType" form="unqualified" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Cabecera que contiene los datos del mensaje</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AuditHeader" type="eai:AuditTypeHeader" form="unqualified" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Cabecera que contiene los datos opcionales mensajes de auditoría.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ECSHeader" form="unqualified" minOccurs="0">
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="eai:ECSHeaderType">
									<xs:sequence>
										<xs:element name="namespace" type="xs:string" form="unqualified"/>
										<xs:element name="mrId" type="xs:string" form="unqualified"/>
									</xs:sequence>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element name="ErrorHeader" type="eai:ErrorHeaderType" form="unqualified" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Cabecera opcional que contiene los datos del error</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MetaDataHeader" type="eai:MetaDataServiceTypeHeader" form="unqualified" minOccurs="0"/>
					<xs:element name="FunEventHeader" type="eai:FunEventTypeHeader" form="unqualified" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="BodyType">
		<xs:sequence>
			<xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="CLEMessage">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CLEHeader" type="eai:CLEHeaderType" form="unqualified"/>
				<xs:element name="Body" type="xs:string" form="unqualified" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="MetaDataServiceTypeHeader">
		<xs:sequence>
			<xs:element name="ServiceMetaData" form="unqualified" maxOccurs="unbounded">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="MetaDataPropertyName" type="xs:string"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AuditTypeHeader">
		<xs:annotation>
			<xs:documentation>Cabecera utilizada para la información de los eventos de auditoría. En el caso de que no se trate de eventos de auditoría, estos datos no tienen porque rellenarse. </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ParentInstanceId" type="eai:UUIDType" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identificador único de la instancia de servicio padre que llamo al servicio emisor del mensaje CLE. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RetriesNumber" type="xs:nonNegativeInteger" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
        				Número de reintento en el cual el componente se
        				está ejecutando.
        			</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumMessagesSent" type="xs:nonNegativeInteger" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
        				Número de mensajes enviados por parte del
        				componente. Este valor será necesario en los
        				adaptadores de exportación, ya que podrán emitir
        				múltiples mensajes.
        			</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClientExternalId" type="xs:string" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
        				Identificador de la petición SOA que ha generado
        				un nuevo E2E. Este identificador es externo al
        				sistema y no es generado por el Framework. Si
        				existe, debe existir en el mensaje de auditoría
        				que establece el inicio de un componente.
        			</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceType" form="unqualified">
				<xs:annotation>
					<xs:documentation>
        				Identificador de los tipos de servicio que
        				emiten los eventos de auditoría. Será un código
        				alfanumérico de 4 caracteres.
        			</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginalInstanceId" type="eai:UUIDType" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identificador de la instancia original que produjo el primer relanzamiento. Este campo sólo existirá cuando la instancia del servicio sea un relanzamiento concreto. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TraceLevel" type="xs:nonNegativeInteger" form="unqualified">
				<xs:annotation>
					<xs:documentation>Nivel de traza establecido para el servicio emisor de este mensaje. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StarterServiceId" type="eai:ServiceIdType" form="unqualified"/>
			<xs:element name="StarterTimestamp" type="xs:dateTime" form="unqualified"/>
			<xs:element name="ServiceDestinations" type="eai:ServiceIdType" form="unqualified" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="LightActive" type="xs:boolean" form="unqualified" minOccurs="0"/>
			<xs:element name="E2EControl" type="xs:boolean" form="unqualified" minOccurs="0"/>
			<xs:element name="ParentE2EControl" type="xs:boolean" form="unqualified" minOccurs="0"/>
			<xs:element name="StartServiceTimeStamp" type="xs:dateTime" form="unqualified" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MessageHeaderType">
		<xs:sequence>
			<xs:element name="IsResponse" type="xs:boolean" form="unqualified">
				<xs:annotation>
					<xs:documentation>
						Valor que si es True indica que el mensaje es de
						respuesta en un servicio síncrono. False si es
						un mensaje de entrada.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageType" type="eai:MessageTypes" form="unqualified">
				<xs:annotation>
					<xs:documentation>
						Tipo de mensaje contenido en el Body del
						CLEMessage. Puedes ser Modelo común de datos y
						modelo propio de datos.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BusinessObject" type="xs:string" form="unqualified"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FunEventTypeHeader">
		<xs:sequence>
			<xs:element name="EventName" type="xs:string" form="unqualified"/>
			<xs:element name="EventType" type="xs:string" form="unqualified"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BaseCommonHeader" abstract="true">
		<xs:sequence>
			<xs:element name="E2EId" type="eai:UUIDType" form="unqualified">
				<xs:annotation>
					<xs:documentation>Identificador único de la ejecución End to End a la cual pertenece la instancia del componente que está emitiendo el mensaje.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="E2EDeepness" type="xs:nonNegativeInteger" form="unqualified">
				<xs:annotation>
					<xs:documentation>Profundidad de la ejecución End to End en la cual se encuentra el componente.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InvocationUser" type="eai:UserType" form="unqualified">
				<xs:annotation>
					<xs:documentation>Usuario que ha invocado el componente. Este usuario es un código de 8 caracteres. 

Falta terminar de definir esto por seguridad lógica. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BatchId" type="eai:BatchIdType" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identificador del batch al cual pertenece el componente. </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InternalCLEHeader">
		<xs:complexContent>
			<xs:extension base="eai:CLEHeaderType">
				<xs:sequence>
					<xs:element name="ErrorInfo" type="eai:ErrorInfoEventType" form="unqualified" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Elemento que contiene los datos que
								permiten conocer si un evento es de
								reprocesamiento y como tratarlo
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
