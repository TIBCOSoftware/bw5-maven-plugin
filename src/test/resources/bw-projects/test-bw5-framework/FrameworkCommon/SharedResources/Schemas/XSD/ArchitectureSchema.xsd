						</xs:sequence>
						<xs:attribute name="PatternGroupName" type="xs:string" use="required"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="EventPattern" form="unqualified" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Event" form="unqualified" maxOccurs="unbounded">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="Pattern" type="xs:string"/>
											<xs:attribute name="EventType" type="xs:string"/>
											<xs:attribute name="ErrorStopFlow" type="xs:boolean"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="EventPatternName" type="xs:string" use="required"/>
						<xs:attribute name="DestinationType" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="Queue"/>
									<xs:enumeration value="Topic"/>
									<xs:enumeration value="Psi"/>
									<xs:enumeration value="Upsilon"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="DestinationName" type="xs:string" use="required"/>
