		<xs:complexType>
			<xs:sequence>
				<xs:element name="CLEInternalHeader" type="eai:InternalCLEHeader" form="unqualified"/>
				<xs:choice>
					<xs:element name="Body" type="xs:string" form="unqualified" minOccurs="0"/>
					<xs:element name="BodyCompress" type="xs:base64Binary" form="unqualified" minOccurs="0"/>
					<xs:element name="BodyComplex" form="unqualified" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Header" type="xs:string" form="unqualified" minOccurs="0"/>
								<xs:element name="Functional" type="xs:base64Binary" form="unqualified" minOccurs="0"/>
								<xs:element name="Hash" type="xs:string" form="unqualified" minOccurs="0"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
