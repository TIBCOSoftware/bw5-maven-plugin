				</xs:annotation>
			</xs:element>
			<xs:element name="ExpirationTime" type="xs:nonNegativeInteger" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tiempo de expiración establecido para un
						reprocesamiento concreto. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReprocessType" type="xs:string" form="unqualified" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tipo de reprocesado. </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
