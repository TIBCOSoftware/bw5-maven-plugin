    <pd:activity name="Obtener Queues JMS">
        <pd:type>com.tibco.plugin.java.JavaActivity</pd:type>
        <pd:resourceType>ae.javapalette.javaActivity</pd:resourceType>
        <pd:x>238</pd:x>
        <pd:y>119</pd:y>
        <config>
            <fullsource>package ArchitectureServices.Business.InitProcess.Process.InitGlobalQueues;
import java.util.*;
import java.io.*;
import com.tibco.tibjms.admin.*;
import com.tibco.pe.plugin.PluginProperties;

public class InitGlobalQueuesObtenerQueuesJMS{
/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected String url_JMS = "";
	protected String proyect = "";
	protected String[] queues = null;
	protected String error = "";
	public String geturl_JMS() {
		return url_JMS;
	}
	public void seturl_JMS(String val) {
		url_JMS = val;
	}
	public String getproyect() {
		return proyect;
	}
	public void setproyect(String val) {
		proyect = val;
	}
	public String[] getqueues() {
		return queues;
	}
	public void setqueues(String[] val) {
		queues = val;
	}
	public String geterror() {
		return error;
	}
	public void seterror(String val) {
		error = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public InitGlobalQueuesObtenerQueuesJMS() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	In  : String url_JMS
	In  : String proyect
	Out : String[] queues
	Out : String error
* Available Variables: DO NOT MODIFY *****/

		org.apache.log4j.Logger logger = org.apache.log4j.Logger.getLogger("bw.logger");

		try
		{
			TibjmsAdmin admin = new TibjmsAdmin(url_JMS,
                                                                                                    PluginProperties.getProperty("tibco.clientVar.CFG/ARCHITECTURE/JMS/MONITOR/CFG_JMS_USER", ""),
                                                                                                    PluginProperties.getProperty("tibco.clientVar.CFG/ARCHITECTURE/JMS/MONITOR/CFG_JMS_PASSWORD", ""));
			ConnectionInfo[] conns = admin.getConnections();
			long connectionID = 1;
	
			for (ConnectionInfo conn : conns) {
				if (conn.getClientID()!= null &amp;&amp; conn.getClientID().contains("BW-BusinessConnection-queue-" + proyect))
				{
					connectionID = conn.getID();
					break;
				}
			}
			
			QueueInfo queue = new QueueInfo("&gt;");
			ConsumerInfo[] consumers = admin.getConsumers(connectionID, null, queue, false, 0);

			String[] colas = new String[consumers.length];

			int i = 0;
			for (ConsumerInfo consumer : consumers) {
				if (consumer.getConnectionID()!= 0 &amp;&amp; consumer.getConnectionID() == connectionID)
				{
					colas[i] = consumer.getDestinationName();
					i++;
				}
			}

			queues =  colas;

		}catch (Exception e) {
			error = e.toString();
			logger.info("Error Java Code inesperado: " + e);
		}
}
}
</fullsource>
