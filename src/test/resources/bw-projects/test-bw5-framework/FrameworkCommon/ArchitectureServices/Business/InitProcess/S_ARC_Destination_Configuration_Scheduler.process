<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
    <pd:name>ArchitectureServices/Business/InitProcess/S_ARC_Destination_Configuration_Scheduler.process</pd:name>
    <pd:startName>Run every Hour</pd:startName>
    <pd:startX>0</pd:startX>
    <pd:startY>0</pd:startY>
    <pd:returnBindings/>
    <pd:starter name="Run every Hour">
        <pd:type>com.tibco.plugin.timer.TimerEventSource</pd:type>
        <pd:resourceType>ae.activities.timer</pd:resourceType>
        <pd:x>118</pd:x>
        <pd:y>127</pd:y>
        <config>
            <StartTime>1331225628000</StartTime>
            <Frequency>false</Frequency>
            <TimeInterval>1</TimeInterval>
            <FrequencyIndex>Hour</FrequencyIndex>
        </config>
        <pd:inputBindings/>
    </pd:starter>
    <pd:endName>End</pd:endName>
    <pd:endX>517</pd:endX>
    <pd:endY>127</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1331225595496</pd:targetNamespace>
    <pd:activity name="LoadQueueListCache">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>326</pd:x>
        <pd:y>127</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Queues/ARC_QueuesManagement/LoadQueueListCache.process</processName>
        </config>
        <pd:inputBindings>
            <FindQueuesIn/>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Run every Hour</pd:from>
        <pd:to>LoadQueueListCache</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>LoadQueueListCache</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>