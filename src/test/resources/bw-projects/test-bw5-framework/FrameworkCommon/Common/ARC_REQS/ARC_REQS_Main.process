        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$Start/ARC_REQS_Main_IN/ns12:ResquestServiceParameters/applyXSLT="true" and not(empty($ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:Body/*))</pd:xpath>
    </pd:transition>
