    <pd:activity name="applyXSTL">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>1057</pd:x>
        <pd:y>346</pd:y>
        <config>
            <processNameXPath>$XSLTParameters/ProcessParameters/XSLTPath</processNameXPath>
            <processName>/Common/ARC_IMPA/Internal/ARC_IMPA/Functional/FUN_IMPA_ApplyXSLT.process</processName>
        </config>
        <pd:inputBindings>
            <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:Body/*"/>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="XSLTPathName">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>1051</pd:x>
        <pd:y>236</pd:y>
        <config>
            <variableName>XSLTParameters</variableName>
        </config>
        <pd:inputBindings>
            <ProcessParameters>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_REQS_Main_IN/ns12:ResquestServiceParameters/applyXSLT =&quot;true&quot;  and $Start/ARC_REQS_Main_IN/ns12:ResquestServiceParameters/applyXSLTDynamicName!=&quot;&quot;">
                        <XSLTPath>
                            <xsl:value-of select="concat($GetServiceIdAndPath/Data/Path ,$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Filter/GLB_FLTR_Folder,&quot;/&quot;,$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Filter/GLB_FLTR_XSLTFilterPrefix,&quot;-&quot;, $Start/ARC_REQS_Main_IN/ns12:ResquestServiceParameters/applyXSLTDynamicName,&quot;.process&quot;)"/>
                        </XSLTPath>
                    </xsl:when>
                    <xsl:otherwise>
                        <XSLTPath>
                            <xsl:value-of select="concat($GetServiceIdAndPath/Data/Path ,$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Filter/GLB_FLTR_Folder,&quot;/&quot;,$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Filter/GLB_FLTR_XSLTFilterPrefix,&quot;-&quot;, $Start/ARC_REQS_Main_IN/ns12:ResquestServiceParameters/ServiceId,&quot;.process&quot;)"/>
                        </XSLTPath>
                    </xsl:otherwise>
                </xsl:choose>
            </ProcessParameters>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetParentTraceLevel">
