<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:UUID1="java://Framework.CommonResources.CustomFunctions.UUIDGenerator.UUIDGenerator" xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx2="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:ns="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Public/Schemas/XSD/MCD/Schema.xsd" xmlns:GetIP="java://EAIFramework.Processes.Private.Common.HeaderManagement.IPAddress.IPAddress" xmlns:pfx3="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx4="http://www.tibco.com/pe/WriteToLogActivitySchema" xmlns:pfx5="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tibco.com/pe/DeployedVarsType" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns3="http://www.bbva.com/EAIFramework" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns21="com/tibco/pe/commands" xmlns:UUID="java://EAIFramework.Processes.Private.Common.HeaderManagement.UUIDGenerator.UUIDGenerator" xmlns:generate="java://EAIFramework.Processes.Private.Common.HeaderManagement.UIDGenerator.UIDGeneratorUIDGenerator" xmlns:Inc="java://EAIFramework.Processes.Private.Common.HeaderManagement.Incrementator.Incrementator">
   
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_EPUB/PreActions/ARC_EPUB_FrameworkHeaderPreGoingAction.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Message">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element ref="ns3:ArchitectureHeader" minOccurs="0"/>
                                <xsd:element name="Body">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:any processContents="skip"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                    <xsd:element name="E2EControl" type="xsd:boolean" minOccurs="0"/>
                    <xsd:element ref="ns3:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="ns3:ECSServiceHeader" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>35</pd:startX>
    <pd:startY>68</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$Map-Data/ns3:Message/ns3:ArchitectureHeader"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType ref="ns3:ArchitectureHeader"/>
    <pd:endX>991</pd:endX>
    <pd:endY>73</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns3:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <Time>
            <xsd:element name="TimeStamp" type="xsd:dateTime"/>
        </Time>
        <NewUUID>
            <xsd:element name="UUID" type="xsd:string"/>
        </NewUUID>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1324369888043</pd:targetNamespace>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>773</pd:x>
        <pd:y>73</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:coercions>
            <pd:coercion xpath="$Start/group/Message/Body/*" element="ns3:Event"/>
        </pd:coercions>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Audit/GLB_Initial"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Audit"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="false()"/>
                    </isResponse>
                    <xsl:choose>
                        <xsl:when test="$Start/group/ns3:TraceLevel">
                            <TraceLevel>
                                <xsl:value-of select="$Start/group/ns3:TraceLevel"/>
                            </TraceLevel>
                        </xsl:when>
                        <xsl:otherwise>
                            <TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </TraceLevel>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:if test="local-name($Start/group/Message/Body/*)=&quot;Event&quot;">
                        <NameValue>
                            <Name>
                                <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTNAME"/>
                            </Name>
                            <Value>
                                <xsl:value-of select="$Start/group/Message/Body/ns3:Event/EventName"/>
                            </Value>
                        </NameValue>
                        <NameValue>
                            <Name>
                                <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTYPE"/>
                            </Name>
                            <Value>
                                <xsl:value-of select="$Start/group/Message/Body/ns3:Event/EventType"/>
                            </Value>
                        </NameValue>
                    </xsl:if>
                </CLETraceData>
                <Body>
                    <xsl:value-of select="tib:render-xml($Map-Data/ns3:Message)"/>
                </Body>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FrameworkHeaderManagement">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>350</pd:x>
        <pd:y>71</pd:y>
        <config>
            <processName>/Common/ARC/ARC_HeaderManagement/ARC_FrameworkHeaderManagement.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_FHM_IN>
                <ns3:ArchitectureHeader>
                    <ns3:AuditHeader>
                        <xsl:choose>
                            <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader">
                                <ns3:E2EId>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EId"/>
                                </ns3:E2EId>
                            </xsl:when>
                            <xsl:when test="local-name($Start/group/Message/Body/*)=&quot;Event&quot;">
                                <ns3:E2EId>
                                    <xsl:value-of select="$Start/group/Message/Body/ns3:Event/EventUUID"/>
                                </ns3:E2EId>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns3:E2EId>
                                    <xsl:value-of select="$NewUUID/UUID"/>
                                </ns3:E2EId>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:if test="string-length($Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId)>0">
                            <xsl:if test="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId">
                                <ns3:ParentInstanceId>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId"/>
                                </ns3:ParentInstanceId>
                            </xsl:if>
                        </xsl:if>
                        <xsl:choose>
                            <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader">
                                <ns3:InstanceId>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:InstanceId"/>
                                </ns3:InstanceId>
                            </xsl:when>
                            <xsl:when test="local-name($Start/group/Message/Body/*)=&quot;Event&quot;">
                                <ns3:InstanceId>
                                    <xsl:value-of select="$Start/group/Message/Body/ns3:Event/EventUUID"/>
                                </ns3:InstanceId>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns3:InstanceId>
                                    <xsl:value-of select="$NewUUID/UUID"/>
                                </ns3:InstanceId>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader">
                                <ns3:Deepness>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:Deepness"/>
                                </ns3:Deepness>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns3:Deepness>
                                    <xsl:value-of select="0"/>
                                </ns3:Deepness>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ServiceId">
                                <ns3:ServiceId>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ServiceId"/>
                                </ns3:ServiceId>
                            </xsl:when>
                            <xsl:when test="local-name($Start/group/Message/Body/*)=&quot;Event&quot;">
                                <ns3:ServiceId>
                                    <xsl:value-of select="$Start/group/Message/Body/ns3:Event/EventEmitter"/>
                                </ns3:ServiceId>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns3:ServiceId>
                                    <xsl:value-of select="$Start/group/ServiceId"/>
                                </ns3:ServiceId>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader">
                                <ns3:ServiceType>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ServiceType"/>
                                </ns3:ServiceType>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns3:ServiceType>
                                    <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_EventPublication"/>
                                </ns3:ServiceType>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:if test="string-length($Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl)>0">
                            <xsl:if test="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl">
                                <ns3:E2EControl>
                                    <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl"/>
                                </ns3:E2EControl>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentE2EControl)>0">
                            <ns3:ParentE2EControl>
                                <xsl:value-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentE2EControl"/>
                            </ns3:ParentE2EControl>
                        </xsl:if>
                    </ns3:AuditHeader>
                    <xsl:if test="$Start/group/Message/ns3:ArchitectureHeader/ns3:ECSHeader&#xA;or&#xA;(local-name($Start/group/Message/Body/*)=&quot;Event&quot;&#xA;and&#xA;string-length($Start/group/ns3:ECSServiceHeader/ns3:traceData/ns3:traceId)=0)">
                        <xsl:choose>
                            <xsl:when test="local-name($Start/group/Message/Body/*)=&quot;Event&quot;&#xA;and &#xA;not($Start/group/Message/ns3:ArchitectureHeader/ns3:ECSHeader)&#xA;and&#xA;string-length($Start/group/ns3:ECSServiceHeader/ns3:traceData/ns3:traceId)=0">
                                <xsl:variable name="timeStampECS" select="tib:timestamp()"/>
                                <ns3:ECSHeader>
                                    <ns3:traceId>
                                        <xsl:value-of select="concat($_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/TracePrefix,$timeStampECS,&quot;-&quot;,$Start/group/Message/Body/ns3:Event/EventUUID)"/>
                                    </ns3:traceId>
                                    <ns3:spanId>
                                        <xsl:value-of select="concat($_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/SpanPrefix,$timeStampECS,&quot;-&quot;,$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/ESBToken,&quot;-&quot;,$Start/group/Message/Body/ns3:Event/EventUUID)"/>
                                    </ns3:spanId>
                                </ns3:ECSHeader>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:ECSHeader"/>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:if>
                    <xsl:choose>
                        <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader/ns3:RequestHeader">
                            <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:RequestHeader"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns3:RequestHeader>
                                <ns3:BBVAUser>
                                    <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_Generic_User"/>
                                </ns3:BBVAUser>
                                <ns3:StartTimestamp>
                                    <xsl:value-of select="$Time/TimeStamp"/>
                                </ns3:StartTimestamp>
                                <ns3:ServiceIdStarter>
                                    <xsl:value-of select="$Start/group/ServiceId"/>
                                </ns3:ServiceIdStarter>
                            </ns3:RequestHeader>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="$Start/group/Message/ns3:ArchitectureHeader/ns3:ErrorHeader">
                            <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:ErrorHeader"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns3:ErrorHeader>
                                <ns3:IsError>
                                    <xsl:value-of select="0"/>
                                </ns3:IsError>
                            </ns3:ErrorHeader>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:ReprocessingHeader"/>
                    <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:SecurityHeader"/>
                    <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:RoutingHeader"/>
                    <xsl:copy-of select="$Start/group/Message/ns3:ArchitectureHeader/ns3:FunctionalData"/>
                </ns3:ArchitectureHeader>
                <ServiceId>
                    <xsl:value-of select="$Start/group/ServiceId"/>
                </ServiceId>
                <ServiceType>
                    <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_EventPublication"/>
                </ServiceType>
                <StarTimestamp>
                    <xsl:value-of select="$Time/TimeStamp"/>
                </StarTimestamp>
                <xsl:if test="$Start/group/E2EControl">
                    <E2EControl>
                        <xsl:value-of select="$Start/group/E2EControl"/>
                    </E2EControl>
                </xsl:if>
                <xsl:copy-of select="$Start/group/ns3:ECSServiceHeader"/>
            </ARC_FHM_IN>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_SaveContexts">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>601</pd:x>
        <pd:y>70</pd:y>
        <config>
            <processName>/Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</processName>
        </config>
        <pd:inputBindings>
            <SaveContexts>
                <xsl:copy-of select="$Map-Data/ns3:Message/ns3:ArchitectureHeader"/>
            </SaveContexts>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>207</pd:x>
        <pd:y>257</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>213</pd:x>
        <pd:y>359</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate Error">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>430</pd:x>
        <pd:y>359</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx3:ActivityInput>
                <data>
                    <ns3:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/group)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                        </MessageType>
                    </ns3:ErrorMessage>
                </data>
            </pfx3:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>476</pd:x>
        <pd:y>71</pd:y>
        <config>
            <element ref="ns3:Message"/>
        </config>
        <pd:inputBindings>
            <ns3:Message>
                <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns3:ArchitectureHeader"/>
                <ns3:Body>
                    <xsl:copy-of select="$Start/group/Message/Body/ancestor-or-self::*/namespace::node()"/>
                    <xsl:copy-of select="$Start/group/Message/Body/@*"/>
                    <xsl:copy-of select="$Start/group/Message/Body/node()"/>
                </ns3:Body>
            </ns3:Message>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>564</pd:x>
        <pd:y>250</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="TimeStamp">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>134</pd:x>
        <pd:y>69</pd:y>
        <config>
            <variableName>Time</variableName>
        </config>
        <pd:inputBindings>
            <TimeStamp>
                <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
            </TimeStamp>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="getUUID">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>231</pd:x>
        <pd:y>71</pd:y>
        <config>
            <variableName>NewUUID</variableName>
        </config>
        <pd:inputBindings>
            <UUID>
                <xsl:value-of select="UUID1:generateUUID()"/>
            </UUID>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>TimeStamp</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>TimeStamp</pd:from>
        <pd:to>getUUID</pd:to>
        <pd:xpathDescription/>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FrameworkHeaderManagement</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_CLESenderAPI</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
