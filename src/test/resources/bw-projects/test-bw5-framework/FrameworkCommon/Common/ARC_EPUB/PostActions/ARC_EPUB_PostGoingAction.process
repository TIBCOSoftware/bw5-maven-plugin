    <pd:activity name="RoutingFromFile By BusinessObject">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>277</pd:x>
        <pd:y>305</pd:y>
        <config>
            <processName>/Common/ARC/ARC_RoutingHelper/ARC_RoutingFromFileByServiceId.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_RoutingFromFileByServiceId>
                <ServiceId>
                    <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ServiceId"/>
                </ServiceId>
                <FileFolderRoute>
                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ADAPTERS/EVENTPUBLICATION/CFG_EPUB_XSL_FOLDER_ROUTE"/>
                </FileFolderRoute>
                <BusinessObject>
                    <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                </BusinessObject>
            </ARC_RoutingFromFileByServiceId>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="RoutingFromFile By EventName">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>359</pd:x>
