                </BusinessObject>
            </ARC_RoutingFromFileByServiceId>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>ARC_FindQueues</pd:from>
        <pd:to>JMS Transaction</pd:to>
        <pd:xpathDescription>All target services are the same type</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType="Queue"])=count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination) or count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType="Topic"])=count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination)</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>JMS Transaction</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
