<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:pfx2="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns="http://www.tibco.com/pe/DeployedVarsType" xmlns:pfx3="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:ns12="http://www.bbva.com/EAIFramework" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd">
    
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_FLTR/PreActions/ARC_FLTR_NoFrameworkHeaderPreGoingAction.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="SpecificFormatMessage">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:any processContents="skip"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                    <xsd:element name="BatchId" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="E2EControl" type="xsd:boolean" minOccurs="0"/>
                    <xsd:element ref="ns12:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="ns12:ECSServiceHeader" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>52</pd:startX>
    <pd:startY>61</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns12:ArchitectureHeader"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType ref="ns12:ArchitectureHeader"/>
    <pd:endX>941</pd:endX>
    <pd:endY>66</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns12:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <Time>
            <xsd:element name="TimeStamp" type="xsd:dateTime"/>
        </Time>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1324369888043</pd:targetNamespace>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>724</pd:x>
        <pd:y>61</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Audit/GLB_Initial"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Audit"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="false()"/>
                    </isResponse>
                    <xsl:choose>
                        <xsl:when test="$Start/group/ns12:TraceLevel">
                            <TraceLevel>
                                <xsl:value-of select="$Start/group/ns12:TraceLevel"/>
                            </TraceLevel>
                        </xsl:when>
                        <xsl:otherwise>
                            <TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </TraceLevel>
                        </xsl:otherwise>
                    </xsl:choose>
                </CLETraceData>
                <Body>
                    <xsl:value-of select="tib:render-xml($Map-Data/ns12:Message)"/>
                </Body>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FrameworkHeaderManagement">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:description/>
        <pd:x>283</pd:x>
        <pd:y>59</pd:y>
        <config>
            <processName>/Common/ARC/ARC_HeaderManagement/ARC_FrameworkHeaderManagement.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_FHM_IN>
                <ServiceId>
                    <xsl:value-of select="$Start/group/ServiceId"/>
                </ServiceId>
                <ServiceType>
                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_FilterAdapter"/>
                </ServiceType>
                <xsl:if test="string-length($Start/group/BatchId)>0">
                    <xsl:if test="$Start/group/BatchId">
                        <BatchId>
                            <xsl:value-of select="$Start/group/BatchId"/>
                        </BatchId>
                    </xsl:if>
                </xsl:if>
                <StarTimestamp>
                    <xsl:value-of select="$Time/TimeStamp"/>
                </StarTimestamp>
                <xsl:if test="$Start/group/E2EControl">
                    <E2EControl>
                        <xsl:value-of select="$Start/group/E2EControl"/>
                    </E2EControl>
                </xsl:if>
                <xsl:copy-of select="$Start/group/ns12:ECSServiceHeader"/>
            </ARC_FHM_IN>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_SaveContexts">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>560</pd:x>
        <pd:y>62</pd:y>
        <config>
            <processName>/Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</processName>
        </config>
        <pd:inputBindings>
            <SaveContexts>
                <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns12:ArchitectureHeader"/>
            </SaveContexts>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>229</pd:x>
        <pd:y>178</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>231</pd:x>
        <pd:y>263</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate Error">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>469</pd:x>
        <pd:y>263</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx2:ActivityInput>
                <data>
                    <ns12:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/group)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                        </MessageType>
                    </ns12:ErrorMessage>
                </data>
            </pfx2:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>412</pd:x>
        <pd:y>61</pd:y>
        <config>
            <element ref="ns12:Message"/>
        </config>
        <pd:inputBindings>
            <ns12:Message>
                <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns12:ArchitectureHeader"/>
                <ns12:Body>
                    <xsl:copy-of select="$Start/group/SpecificFormatMessage/ancestor-or-self::*/namespace::node()"/>
                    <xsl:copy-of select="$Start/group/SpecificFormatMessage/@*"/>
                    <xsl:copy-of select="$Start/group/SpecificFormatMessage/node()"/>
                </ns12:Body>
            </ns12:Message>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>384</pd:x>
        <pd:y>170</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="TimeStamp">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>159</pd:x>
        <pd:y>62</pd:y>
        <config>
            <variableName>Time</variableName>
        </config>
        <pd:inputBindings>
            <TimeStamp>
                <xsl:value-of xmlns:xsl="http://www.w3.org/1999/XSL/Transform" select="tib:current-dateTime-timezone(0,0)"/>
            </TimeStamp>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>TimeStamp</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>TimeStamp</pd:from>
        <pd:to>ARC_FrameworkHeaderManagement</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FrameworkHeaderManagement</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Map Data</pd:from>
        <pd:to>ARC_SaveContexts</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_CLESenderAPI</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_SaveContexts</pd:from>
        <pd:to>ARC_CLESenderAPI</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>