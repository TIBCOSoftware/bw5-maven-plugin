                            </ns12:AuditHeader>
                            <xsl:if test="string(((tib:tokenize($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader, &quot;,&quot;)=$ARC_FindQueue/ns12:Destination/@ServiceId)))=$_globalVariables/ns1:GlobalVariables/GeneralConstants/BooleanConstants/False&#xA;and&#xA;$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader!=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/ALLServices&#xA;and&#xA;string-length($GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId)>0">
                                <ns12:ECSHeader>
