                                    </ns12:spanId>
                                    <xsl:copy-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties"/>
                                </ns12:ECSHeader>
                            </xsl:if>
                            <ns12:RequestHeader>
                                <xsl:choose>
                                    <xsl:when test="string-length($Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/BBVAUser)>0">
