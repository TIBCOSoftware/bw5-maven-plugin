                            <ns12:ErrorHeader>
                                <ns12:IsError>
                                    <xsl:value-of select="0"/>
                                </ns12:IsError>
                            </ns12:ErrorHeader>
                            <xsl:copy-of select="$Start/Inbound_FLTR_Postaction/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                            <xsl:choose>
                                <xsl:when test="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:FunctionalData">
                                    <xsl:copy-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                                </xsl:when>
                                <xsl:otherwise>
                                    <xsl:copy-of select="$Start/Inbound_FLTR_Postaction/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                                </xsl:otherwise>
                            </xsl:choose>
                        </ns12:ArchitectureHeader>
                        <ns12:Body>
