                                    <ns12:ParentE2EControl>
                                        <xsl:value-of select="ns12:ParentE2EControl"/>
                                    </ns12:ParentE2EControl>
                                </xsl:if>
                                <xsl:if test="ns12:isLight">
                                    <ns12:isLight>
                                        <xsl:value-of select="ns12:isLight"/>
                                    </ns12:isLight>
                                </xsl:if>
                                <xsl:if test="ns12:SaveMessage">
                                    <ns12:SaveMessage>
                                        <xsl:value-of select="ns12:SaveMessage"/>
                                    </ns12:SaveMessage>
                                </xsl:if>
                            </ns12:AuditHeader>
                        </xsl:for-each>
                        <xsl:if test="string(((tib:tokenize($_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader, &quot;,&quot;)=$ARC_CA_PostGoingAction/group/TargetServiceId)))=$_globalVariables/ns5:GlobalVariables/GeneralConstants/BooleanConstants/False&#xA;and&#xA;$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader!=$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/ALLServices&#xA;and&#xA;string-length($ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId)>0">
                            <xsl:for-each select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader">
