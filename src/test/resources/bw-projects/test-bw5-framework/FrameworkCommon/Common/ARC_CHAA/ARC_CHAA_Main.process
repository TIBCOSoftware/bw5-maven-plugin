                </Body>
                <TargetServiceId>
                    <xsl:value-of select="$Start/Root/ns12:AdapterChannelParameters/TargetServiceId"/>
                </TargetServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/Root/ns12:TraceLevel">
                        <xsl:if test="$Start/Root/ns12:TraceLevel">
                            <ns12:TraceLevel>
                                <xsl:value-of select="$Start/Root/ns12:TraceLevel"/>
                            </ns12:TraceLevel>
                        </xsl:if>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
            </CDMMessage>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_CA_PreBackAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>726</pd:x>
        <pd:y>328</pd:y>
        <config>
            <processName>/Common/ARC_CHAA/PreActions/ARC_CHAA_PreBackAction.process</processName>
        </config>
        <pd:inputBindings>
            <group>
                <ns12:Message>
                    <ns12:ArchitectureHeader>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:AuditHeader"/>
                        <xsl:if test="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader">
                            <ns12:ECSHeader>
                                <ns12:traceId>
                                    <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId"/>
                                </ns12:traceId>
                                <xsl:if test="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:parentSpan">
                                    <ns12:parentSpan>
                                        <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:parentSpan"/>
                                    </ns12:parentSpan>
                                </xsl:if>
                                <ns12:spanId>
                                    <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:spanId"/>
                                </ns12:spanId>
                                <xsl:if test="count($ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property)>0&#xA;or&#xA;count($ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property)>0">
                                    <ns12:properties>
                                        <xsl:for-each-group select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property" group-by="ns12:key">
                                            <xsl:copy-of select="."/>
                                        </xsl:for-each-group>
                                        <xsl:for-each-group select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property" group-by="ns12:key">
                                            <xsl:if test="count($ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property[ns12:key=current-group()/ns12:key])=0">
                                                <xsl:copy-of select="."/>
                                            </xsl:if>
                                        </xsl:for-each-group>
                                    </ns12:properties>
                                </xsl:if>
                            </ns12:ECSHeader>
                        </xsl:if>
                        <ns12:RequestHeader>
                            <ns12:BBVAUser>
                                <xsl:value-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BBVAUser"/>
                            </ns12:BBVAUser>
                            <xsl:if test="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId">
                                <ns12:ExternalId>
                                    <xsl:value-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId"/>
                                </ns12:ExternalId>
                            </xsl:if>
                            <xsl:if test="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId">
                                <ns12:BatchId>
                                    <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId"/>
                                </ns12:BatchId>
                            </xsl:if>
                            <xsl:if test="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject">
                                <ns12:BusinessObject>
                                    <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                                </ns12:BusinessObject>
                            </xsl:if>
                            <ns12:StartTimestamp>
                                <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:StartTimestamp"/>
                            </ns12:StartTimestamp>
                            <ns12:ServiceIdStarter>
                                <xsl:value-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ServiceIdStarter"/>
                            </ns12:ServiceIdStarter>
                        </ns12:RequestHeader>
                        <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ErrorHeader"/>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:ReprocessingHeader"/>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                        <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                    </ns12:ArchitectureHeader>
                    <ns12:Body>
                        <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:Body/ancestor-or-self::*/namespace::node()"/>
                        <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:Body/@*"/>
                        <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:Body/node()"/>
                    </ns12:Body>
                </ns12:Message>
                <xsl:choose>
                    <xsl:when test="$Start/Root/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/Root/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$_globalVariables/ns5:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit">
                            <ns12:TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </ns12:TraceLevel>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_CA_PreGoingAction">
