        <pd:x>192</pd:x>
        <pd:y>447</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorCode"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="0"/>
                    </isResponse>
                    <TraceLevel>
                        <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/TraceLevels/GLB_Trace"/>
                    </TraceLevel>
                </CLETraceData>
                <xsl:choose>
                    <xsl:when test="string-length($Catch-Error-message/ns12:ErrorMessage/ErrorCode)>0">
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorCode"/>
                            </ErrorCode>
                            <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/ErrorDescription">
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/NativeErrorCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/NativeErrorDescription">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorDate"/>
                            </ErrorDate>
                            <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/StackProcess">
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/Severity"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/Root)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/Category"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ProcessInputMessage"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/IsResponse"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/MessageType"/>
                            </MessageType>
                            <PreviousErrorMessage>
                                <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/ancestor-or-self::*/namespace::node()"/>
                                <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/@*"/>
                                <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/node()"/>
                            </PreviousErrorMessage>
                            <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/FunctionalErrorData"/>
                        </ns12:ErrorMessage>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </ErrorCode>
                            <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                                <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:if>
                            <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                                <xsl:if test="$_error/ns2:ErrorReport/Msg">
                                    <NativeErrorDescription>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                    </NativeErrorDescription>
                                </xsl:if>
                            </xsl:if>
                            <xsl:if test="string-length($_error/ns2:ErrorReport/StackTrace)>0">
                                <xsl:if test="$_error/ns2:ErrorReport/StackTrace">
                                    <StackTrace>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                    </StackTrace>
                                </xsl:if>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                            </ErrorDate>
                            <xsl:if test="string-length($_error/ns2:ErrorReport/ProcessStack)>0">
                                <xsl:if test="$_error/ns2:ErrorReport/ProcessStack">
                                    <StackProcess>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                    </StackProcess>
                                </xsl:if>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/Root)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="tib:render-xml($Start/Root)"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="0"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                            </MessageType>
                        </ns12:ErrorMessage>
                    </xsl:otherwise>
                </xsl:choose>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_CLESenderAPI-1">
