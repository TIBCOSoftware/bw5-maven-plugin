                                    </ns12:traceId>
                                    <xsl:if test="string-length($Start/Root/ns12:ECSServiceHeader/ns12:namespace)>0">
                                        <ns12:parentSpan>
                                            <xsl:value-of select="concat($_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/NSToken,$Start/Root/ns12:ECSServiceHeader/ns12:namespace,$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/MRSToken,$Start/Root/ns12:ECSServiceHeader/ns12:mrId,$_globalVariables/ns5:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/SpansToken,current()/ns12:spanId)"/>
                                        </ns12:parentSpan>
                                    </xsl:if>
                                    <ns12:spanId>
                                        <xsl:value-of select="ns12:spanId"/>
                                    </ns12:spanId>
                                    <xsl:copy-of select="ns12:properties" copy-namespaces="no"/>
                                </ns12:ECSHeader>
                            </xsl:for-each>
                        </xsl:if>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:RequestHeader"/>
                        <ns12:ErrorHeader>
                            <ns12:IsError>
                                <xsl:value-of select="0"/>
                            </ns12:IsError>
                        </ns12:ErrorHeader>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                        <xsl:copy-of select="$ARC_CA_PostGoingAction/group/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                    </ns12:ArchitectureHeader>
                    <ns12:Body>
