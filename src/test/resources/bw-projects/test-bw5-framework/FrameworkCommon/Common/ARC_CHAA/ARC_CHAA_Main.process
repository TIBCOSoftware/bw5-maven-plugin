                    <xsd:element ref="ns12:ECSServiceHeader" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>144</pd:startX>
    <pd:startY>58</pd:startY>
    <pd:returnBindings>
