    <pd:activity name="ARC_CA_PostBackAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>364</pd:x>
        <pd:y>326</pd:y>
        <config>
            <processName>/Common/ARC_CHAA/PostActions/ARC_CHAA_PostBackAction.process</processName>
        </config>
        <pd:inputBindings>
            <root>
                <ns12:Message>
                    <xsl:copy-of select="$ARC_CA_PreBackAction/ns12:ArchitectureHeader"/>
                    <ns12:Body>
                        <xsl:copy-of select="$FUN_CA_OutboundFunctional/*"/>
                    </ns12:Body>
                </ns12:Message>
                <xsl:choose>
                    <xsl:when test="$Start/Root/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/Root/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns5:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
            </root>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_CA_PostGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>723</pd:x>
        <pd:y>58</pd:y>
        <config>
