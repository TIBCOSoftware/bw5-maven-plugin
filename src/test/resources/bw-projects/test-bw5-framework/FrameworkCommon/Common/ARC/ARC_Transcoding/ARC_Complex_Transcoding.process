    <pd:activity name="InputHashProcess">
        <pd:type>com.tibco.plugin.java.JavaActivity</pd:type>
        <pd:resourceType>ae.javapalette.javaActivity</pd:resourceType>
        <pd:x>400</pd:x>
        <pd:y>294</pd:y>
        <config>
            <fileName>ARC_Complex_TranscodingInputHashProcess</fileName>
            <packageName>Common.ARC.ARC_Transcoding.ARC_Complex_Transcoding</packageName>
            <fullsource>package Common.ARC.ARC_Transcoding.ARC_Complex_Transcoding;
import java.util.*;
import java.io.*;

import java.util.HashMap;
import java.util.SortedSet;
import java.util.TreeSet;

public class ARC_Complex_TranscodingInputHashProcess{
/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected String[] keys = null;
	protected String[] values = null;
	protected String entity = "";
	protected String sourceApp = "";
	protected String targetApp = "";
	protected String HashValue = "";
	public String[] getkeys() {
		return keys;
	}
	public void setkeys(String[] val) {
		keys = val;
	}
	public String[] getvalues() {
		return values;
	}
	public void setvalues(String[] val) {
		values = val;
	}
	public String getentity() {
		return entity;
	}
	public void setentity(String val) {
		entity = val;
	}
	public String getsourceApp() {
		return sourceApp;
	}
	public void setsourceApp(String val) {
		sourceApp = val;
	}
	public String gettargetApp() {
		return targetApp;
	}
	public void settargetApp(String val) {
		targetApp = val;
	}
	public String getHashValue() {
		return HashValue;
	}
	public void setHashValue(String val) {
		HashValue = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public ARC_Complex_TranscodingInputHashProcess() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	In  : String[] keys
	In  : String[] values
	In  : String entity
	In  : String sourceApp
	In  : String targetApp
	Out : String HashValue
* Available Variables: DO NOT MODIFY *****/

				StringBuffer hashKey=new StringBuffer();


		if (keys.length!=values.length)
			throw new Exception("Not all the keys contain values. This is not allowed.");

		//create the hashMap &lt;key, value&gt;
		HashMap&lt;String, String&gt; hash= new HashMap&lt;String, String&gt;();
		int length = keys.length;
		for(int i=0; i&lt; length; i++){
			hash.put(keys[i], values[i]);
		}

		//sort keys by alphabetical order
		SortedSet&lt;String&gt; set= new TreeSet&lt;String&gt;(hash.keySet());
		//create the hash key from entity and the pair &lt;key,value&gt; ordered alphabetically
		hashKey.append(sourceApp);
		hashKey.append(targetApp);
		hashKey.append(entity);
		
		for(Object ob:set){
			hashKey.append(ob);
			hashKey.append(hash.get((String)ob));
		}

		HashValue= hashKey.toString();


}
}
</fullsource>
