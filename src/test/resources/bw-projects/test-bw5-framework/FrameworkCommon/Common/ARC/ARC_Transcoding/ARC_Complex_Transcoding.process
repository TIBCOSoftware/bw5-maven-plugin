    <pd:activity name="getDestinationXML">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>823</pd:x>
        <pd:y>225</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Transcoding/interface/complexTranscodingIfz.process</processName>
            <processNameXPath>concat($GetServiceIdAndPath/Data/Path, $_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Transcoding/GLB_COMPLEX_IMPL)</processNameXPath>
        </config>
        <pd:inputBindings>
