        </pd:transition>
        <pd:activity name="Render JSON Functional">
            <pd:type>com.tibco.plugin.json.activities.JSONRenderActivity</pd:type>
            <pd:resourceType>ae.activities.JSONRenderActivity</pd:resourceType>
            <pd:x>195</pd:x>
            <pd:y>780</pd:y>
            <config>
                <SchemaType>generic</SchemaType>
                <BadgerfishCheck>false</BadgerfishCheck>
                <removeRootElementForInput>true</removeRootElementForInput>
                <ActivityInputEditor/>
            </config>
            <pd:inputBindings>
                <ns4:ActivityInputClass>
                    <xmlString>
                        <xsl:value-of select="tib:render-xml($Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:Body/*)"/>
                    </xmlString>
                </ns4:ActivityInputClass>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Put Record Stream">
            <pd:type>com.tibco.pe.core.CallCustomProcessActivity</pd:type>
            <pd:resourceType>ae.process.customsubprocess</pd:resourceType>
            <pd:x>441</pd:x>
            <pd:y>772</pd:y>
            <config>
                <referedProcessImageData></referedProcessImageData>
                <referedProcess>/Process_v2.0/UPSILON/PutRecordStream.process</referedProcess>
                <referedProcessResourcesByteArray></referedProcessResourcesByteArray>
            </config>
            <pd:inputBindings>
                <ECSActivityInput>
                    <requestTimeout>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ECS/UPSILON/Request_Timeout"/>
                    </requestTimeout>
                    <namespace>
                        <xsl:value-of select="tib:trim(substring-before(tib:substring-after-last($Start/IN_SendReply2QueueOrTopic/TargetName, $_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/NSToken), &quot;/&quot;))"/>
                    </namespace>
                    <stream>
                        <xsl:value-of select="tib:trim(tib:substring-after-last($Start/IN_SendReply2QueueOrTopic/TargetName,&quot;/&quot;))"/>
                    </stream>
                    <payload>
                        <xsl:value-of select="$Render-JSON-Message-Upsilon/ns4:ActivityOutputClass/jsonString"/>
                    </payload>
                    <xsl:if test="exists($Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:ArchitectureHeader/pfx2:ECSHeader)">
                        <traceability>
                            <xsl:if test="$Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:ArchitectureHeader/pfx2:ECSHeader/pfx2:traceId">
                                <x-rho-traceid>
                                    <xsl:value-of select="$Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:ArchitectureHeader/pfx2:ECSHeader/pfx2:traceId"/>
                                </x-rho-traceid>
                            </xsl:if>
                            <xsl:if test="$Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:ArchitectureHeader/pfx2:ECSHeader/pfx2:parentSpan">
                                <x-rho-parentspanid>
                                    <xsl:value-of select="$Start/IN_SendReply2QueueOrTopic/pfx2:Message/pfx2:ArchitectureHeader/pfx2:ECSHeader/pfx2:parentSpan"/>
                                </x-rho-parentspanid>
                            </xsl:if>
                        </traceability>
                    </xsl:if>
                </ECSActivityInput>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Render JSON Message Upsilon">
            <pd:type>com.tibco.plugin.json.activities.JSONRenderActivity</pd:type>
            <pd:resourceType>ae.activities.JSONRenderActivity</pd:resourceType>
            <pd:x>312</pd:x>
            <pd:y>779</pd:y>
            <config>
                <SchemaType>xsdType</SchemaType>
                <BadgerfishCheck>false</BadgerfishCheck>
                <removeRootElementForInput>true</removeRootElementForInput>
                <ActivityInputEditor>
                    <xsd:element name="root">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="message" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </ActivityInputEditor>
            </config>
            <pd:inputBindings>
                <ns4:ActivityInputClass>
                    <root>
                        <message>
                            <xsl:value-of select="$Render-JSON-Functional/ns4:ActivityOutputClass/jsonString"/>
                        </message>
                    </root>
                </ns4:ActivityInputClass>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
