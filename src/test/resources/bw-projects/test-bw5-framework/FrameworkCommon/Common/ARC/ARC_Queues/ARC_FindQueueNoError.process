<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_Queues/ARC_FindQueueNoError.process</pd:name>
    <pd:startName>Receive N Service Ids</pd:startName>
    <pd:startType>
        <xsd:element name="FindQueueIn">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="ServiceId" type="pfx:ServiceIdType"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>80</pd:startX>
    <pd:startY>202</pd:startY>
    <pd:returnBindings>
        <Data>
            <ServiceIDQueue>
                <xsl:value-of select="$ProcessVariables/Queue/Name"/>
            </ServiceIDQueue>
        </Data>
    </pd:returnBindings>
    <pd:endName>Give Queue</pd:endName>
    <pd:endType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="ServiceIDQueue" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>640</pd:endX>
    <pd:endY>194</pd:endY>
    <pd:errorSchemas>
        <ErrorQueueNotFound ref="pfx:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <ProcessVariables>
            <xsd:element name="Queue">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="Name" type="xsd:string"/>
                        <xsd:element name="ServiceId" type="xsd:string"/>
                        <xsd:element name="DestinationType" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </ProcessVariables>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1331218077342</pd:targetNamespace>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>201</pd:x>
        <pd:y>535</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch Controlled Error">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>201</pd:x>
        <pd:y>458</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generic Error  QueueNotFound">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>416</pd:x>
        <pd:y>543</pd:y>
        <config>
            <faultName>ErrorQueueNotFound</faultName>
        </config>
        <pd:inputBindings>
            <ns:ActivityInput>
                <data>
                    <pfx:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_QueueNotFound"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="concat($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Some_problem_getting_queu..., $Receive-N-Service-Ids/FindQueueIn/ServiceId)"/>
                        </ErrorDescription>
                        <StackTrace>
                            <xsl:value-of select="BW:getCurrentActivityName($_processContext/ns2:ProcessContext/ProcessId)"/>
                        </StackTrace>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <StackProcess>
                            <xsl:value-of select="BW:getCurrentActivityName($_processContext/ns2:ProcessContext/ProcessId)"/>
                        </StackProcess>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Receive-N-Service-Ids/FindQueueIn )"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx:ErrorMessage>
                </data>
            </ns:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Get queues in Service Id list">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>418</pd:x>
        <pd:y>201</pd:y>
        <config>
            <variableName>ProcessVariables</variableName>
        </config>
        <pd:inputBindings>
            <xsl:choose>
                <xsl:when test="$GetVariable-1/pfx:QueuesCacheList">
                    <Queue>
                        <Name>
                            <xsl:value-of select="$GetVariable-1/pfx:QueuesCacheList/pfx:Destination[ @ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]"/>
                        </Name>
                        <ServiceId>
                            <xsl:value-of select="$GetVariable-1/pfx:QueuesCacheList/pfx:Destination[ @ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]/@ServiceId"/>
                        </ServiceId>
                        <DestinationType>
                            <xsl:value-of select="$GetVariable-1/pfx:QueuesCacheList/pfx:Destination[@ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]/@DestinationType"/>
                        </DestinationType>
                    </Queue>
                </xsl:when>
                <xsl:otherwise>
                    <Queue>
                        <Name>
                            <xsl:value-of select="$GetVariable/pfx:QueuesCacheList/pfx:Destination[ @ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]"/>
                        </Name>
                        <ServiceId>
                            <xsl:value-of select="$GetVariable/pfx:QueuesCacheList/pfx:Destination[ @ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]/@ServiceId"/>
                        </ServiceId>
                        <DestinationType>
                            <xsl:value-of select="$GetVariable/pfx:QueuesCacheList/pfx:Destination[@ServiceId= $Receive-N-Service-Ids/FindQueueIn/ServiceId]/@DestinationType"/>
                        </DestinationType>
                    </Queue>
                </xsl:otherwise>
            </xsl:choose>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetVariable">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>201</pd:x>
        <pd:y>194</pd:y>
        <config>
            <variableConfig>/SharedResources/SharedVariables/Queues-Service List.sharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="GetVariable-1">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>415</pd:x>
        <pd:y>358</pd:y>
        <config>
            <variableConfig>/SharedResources/SharedVariables/Queues-Service List.sharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="LoadQueueListCache">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>201</pd:x>
        <pd:y>357</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Queues/ARC_QueuesManagement/LoadQueueListCache.process</processName>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>416</pd:x>
        <pd:y>450</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Receive N Service Ids</pd:from>
        <pd:to>GetVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetVariable</pd:from>
        <pd:to>Get queues in Service Id list</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Get queues in Service Id list</pd:from>
        <pd:to>Give Queue</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetVariable</pd:from>
        <pd:to>LoadQueueListCache</pd:to>
        <pd:xpathDescription>No hay Service Ids cargados</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($GetVariable/pfx:QueuesCacheList/pfx:Destination)=0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>LoadQueueListCache</pd:from>
        <pd:to>GetVariable-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetVariable-1</pd:from>
        <pd:to>Get queues in Service Id list</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Generic Error  QueueNotFound</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Controlled Error</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:label>
        <pd:name>Label</pd:name>
        <pd:description>No service Ids</pd:description>
        <pd:x>317</pd:x>
        <pd:y>38</pd:y>
        <pd:width>199</pd:width>
        <pd:height>33</pd:height>
        <pd:fontColor>-16737895</pd:fontColor>
        <pd:color>-3407872</pd:color>
        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
</pd:ProcessDefinition>