<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.bbva.com/EAIFramework" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <pd:name>Common/ARC/ARC_SetAdditionalArchitectureHeaderData/ARC_UpdateSecurityHeader.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="User" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Password" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>151</pd:startX>
    <pd:startY>65</pd:startY>
    <pd:returnBindings>
        <Output>
            <xsl:if test="$GetVariable/FrameworkData/InvocationsNumber">
                <InvocationsNumber>
                    <xsl:value-of select="$GetVariable/FrameworkData/InvocationsNumber"/>
                </InvocationsNumber>
            </xsl:if>
            <ns:ArchitectureHeader>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:AuditHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ErrorHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ReprocessingHeader"/>
                <ns:SecurityHeader>
                    <xsl:choose>
                        <xsl:when test="$Start/Data/User">
                            <ns:User>
                                <xsl:value-of select="$Start/Data/User"/>
                            </ns:User>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns:User>
                                <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader/ns:User"/>
                            </ns:User>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="$Start/Data/Password">
                            <ns:Password>
                                <xsl:value-of select="$Start/Data/Password"/>
                            </ns:Password>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns:Password>
                                <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader/ns:Password"/>
                            </ns:Password>
                        </xsl:otherwise>
                    </xsl:choose>
                </ns:SecurityHeader>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RoutingHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:FunctionalData"/>
            </ns:ArchitectureHeader>
            <xsl:if test="$GetVariable/FrameworkData/SaveMessage">
                <SaveMessage>
                    <xsl:value-of select="$GetVariable/FrameworkData/SaveMessage"/>
                </SaveMessage>
            </xsl:if>
        </Output>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Output">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="InvocationsNumber" type="xsd:string" minOccurs="0"/>
                    <xsd:element ref="ns:ArchitectureHeader"/>
                    <xsd:element name="SaveMessage" type="xsd:boolean" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>573</pd:endX>
    <pd:endY>67</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1334302660977</pd:targetNamespace>
    <pd:activity name="GetVariable">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>282</pd:x>
        <pd:y>65</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="SetVariable">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>422</pd:x>
        <pd:y>65</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <FrameworkData>
                <xsl:if test="$GetVariable/FrameworkData/InvocationsNumber">
                    <InvocationsNumber>
                        <xsl:value-of select="$GetVariable/FrameworkData/InvocationsNumber"/>
                    </InvocationsNumber>
                </xsl:if>
                <ns:ArchitectureHeader>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:AuditHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ECSHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ErrorHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ReprocessingHeader"/>
                    <ns:SecurityHeader>
                        <xsl:choose>
                            <xsl:when test="$Start/Data/User">
                                <ns:User>
                                    <xsl:value-of select="$Start/Data/User"/>
                                </ns:User>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns:User>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader/ns:User"/>
                                </ns:User>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$Start/Data/Password">
                                <ns:Password>
                                    <xsl:value-of select="$Start/Data/Password"/>
                                </ns:Password>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns:Password>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader/ns:Password"/>
                                </ns:Password>
                            </xsl:otherwise>
                        </xsl:choose>
                    </ns:SecurityHeader>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RoutingHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:FunctionalData"/>
                </ns:ArchitectureHeader>
                <xsl:if test="$GetVariable/FrameworkData/SaveMessage">
                    <SaveMessage>
                        <xsl:value-of select="$GetVariable/FrameworkData/SaveMessage"/>
                    </SaveMessage>
                </xsl:if>
            </FrameworkData>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetVariable</pd:from>
        <pd:to>SetVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetVariable</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>