        <pd:x>245</pd:x>
        <pd:y>99</pd:y>
        <config>
            <fileName>ARC_GetEARVersionEarVersion</fileName>
            <packageName>Common.ARC.ARC_Utilities.ARC_GetEARVersion</packageName>
            <fullsource>package Common.ARC.ARC_Utilities.ARC_GetEARVersion;
import java.util.*;
import java.io.*;
import com.tibco.pe.plugin.PluginProperties;

public class ARC_GetEARVersionEarVersion{
/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected String EarVersion = "";
	public String getEarVersion() {
		return EarVersion;
	}
	public void setEarVersion(String val) {
		EarVersion = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public ARC_GetEARVersionEarVersion() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	Out : String EarVersion
* Available Variables: DO NOT MODIFY *****/

PluginProperties.getProperty("__EAR_FILE_VERSION__");

}
}
</fullsource>
            <outputData>
                <row>
                    <fieldName>EarVersion</fieldName>
                    <fieldType>string</fieldType>
                    <fieldRequired>optional</fieldRequired>
                </row>
            </outputData>
            <byteCode>
                <class>
                    <name>ARC_GetEARVersionEarVersion</name>
                    <byteCode></byteCode>
                </class>
            </byteCode>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
