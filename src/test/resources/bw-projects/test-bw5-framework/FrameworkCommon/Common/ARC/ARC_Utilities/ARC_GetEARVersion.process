                </xsl:when>
                <xsl:otherwise>
                    <EarVersion>
                        <xsl:value-of select="&quot;&quot;"/>
                    </EarVersion>
                </xsl:otherwise>
            </xsl:choose>
        </Data>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="EarVersion" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>442</pd:endX>
    <pd:endY>101</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1390838876553</pd:targetNamespace>
    <pd:activity name="EarVersion">
