<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx2="http://www.bbva.com/EAIFramework" xmlns:pfx="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd">
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_BatchN1/ARC_IMPA_GetBatchId/ARC_IMPA_GetInternalBatchId.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="ARC_IMPA_GetBatchId">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                    <xsd:element name="TraceLevel" type="xsd:string" minOccurs="0"/>
                    <xsd:element ref="pfx2:ArchitectureHeader" minOccurs="0"/>
                    <xsd:element name="Body" minOccurs="0">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:any processContents="skip"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>61</pd:startX>
    <pd:startY>106</pd:startY>
    <pd:returnBindings>
        <OUT_GetInternalBatchId>
            <BatchId>
                <xsl:value-of select="$ARC_FindBatchId/group/BatchId"/>
            </BatchId>
            <TimeStampUUID>
                <xsl:value-of select="$ARC_FindBatchId/group/TimeStampUUID"/>
            </TimeStampUUID>
        </OUT_GetInternalBatchId>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="OUT_GetInternalBatchId">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="BatchId" type="xsd:string"/>
                    <xsd:element name="TimeStampUUID" type="xsd:long"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>806</pd:endX>
    <pd:endY>111</pd:endY>
    <pd:errorSchemas>
        <Schema0 ref="pfx2:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1328870223787</pd:targetNamespace>
    <pd:activity name="ARC_FindBatchId">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>292</pd:x>
        <pd:y>109</pd:y>
        <config>
            <processName>/Common/ARC/ARC_BatchN1/UsingBatchIdVariable/ARC_FindBatchId.process</processName>
        </config>
        <pd:inputBindings>
            <ServiceId>
                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/ServiceId"/>
            </ServiceId>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IMPA_SendNewBatch">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>452</pd:x>
        <pd:y>38</pd:y>
        <config>
            <processName>/Common/ARC/ARC_BatchN1/BatchAudit/ARC_IMPA_SendInternalNewBatch.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_IMPA_SendEndBatch>
                <pfx2:ArchitectureHeader>
                    <pfx2:AuditHeader>
                        <pfx2:E2EId>
                            <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:E2EId"/>
                        </pfx2:E2EId>
                        <xsl:if test="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ParentInstanceId">
                            <pfx2:ParentInstanceId>
                                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ParentInstanceId"/>
                            </pfx2:ParentInstanceId>
                        </xsl:if>
                        <pfx2:InstanceId>
                            <xsl:value-of select="$ARC_FindBatchId/group/BatchId"/>
                        </pfx2:InstanceId>
                        <pfx2:Deepness>
                            <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:Deepness"/>
                        </pfx2:Deepness>
                        <pfx2:ServiceId>
                            <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ServiceId"/>
                        </pfx2:ServiceId>
                        <pfx2:ServiceType>
                            <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ServiceType"/>
                        </pfx2:ServiceType>
                        <xsl:if test="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:E2EControl">
                            <pfx2:E2EControl>
                                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:E2EControl"/>
                            </pfx2:E2EControl>
                        </xsl:if>
                        <xsl:if test="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ParentE2EControl">
                            <pfx2:ParentE2EControl>
                                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:ParentE2EControl"/>
                            </pfx2:ParentE2EControl>
                        </xsl:if>
                        <xsl:if test="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:isLight">
                            <pfx2:isLight>
                                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:isLight"/>
                            </pfx2:isLight>
                        </xsl:if>
                        <xsl:if test="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:SaveMessage">
                            <pfx2:SaveMessage>
                                <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:SaveMessage"/>
                            </pfx2:SaveMessage>
                        </xsl:if>
                    </pfx2:AuditHeader>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:ECSHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:RequestHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:ErrorHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:ReprocessingHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:SecurityHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:RoutingHeader"/>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/pfx2:ArchitectureHeader/pfx2:FunctionalData"/>
                </pfx2:ArchitectureHeader>
                <BatchId>
                    <xsl:value-of select="$ARC_FindBatchId/group/BatchId"/>
                </BatchId>
                <ServiceId>
                    <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/ServiceId"/>
                </ServiceId>
                <xsl:if test="$Start/ARC_IMPA_GetBatchId/TraceLevel">
                    <TraceLevel>
                        <xsl:value-of select="$Start/ARC_IMPA_GetBatchId/TraceLevel"/>
                    </TraceLevel>
                </xsl:if>
                <Body>
                    <xsl:copy-of select="$Start/ARC_IMPA_GetBatchId/Body/*"/>
                </Body>
                <TimeStampUUID>
                    <xsl:value-of select="$ARC_FindBatchId/group/TimeStampUUID"/>
                </TimeStampUUID>
            </ARC_IMPA_SendEndBatch>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>309</pd:x>
        <pd:y>241</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Null">
        <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
        <pd:resourceType>ae.activities.null</pd:resourceType>
        <pd:x>586</pd:x>
        <pd:y>109</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Error in GetBatchId">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>475</pd:x>
        <pd:y>250</pd:y>
        <config>
            <faultName>Schema0</faultName>
        </config>
        <pd:inputBindings>
            <ns:ActivityInput>
                <data>
                    <pfx2:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_GetBatchId"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_GetBatchIdDescription"/>
                        </ErrorDescription>
                        <NativeErrorCode>
                            <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                        </NativeErrorCode>
                        <xsl:if test="$_error/ns2:ErrorReport/Msg">
                            <NativeErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </NativeErrorDescription>
                        </xsl:if>
                        <xsl:if test="$_error/ns2:ErrorReport/StackTrace">
                            <StackTrace>
                                <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                            </StackTrace>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="$_error/ns2:ErrorReport/ProcessStack">
                            <StackProcess>
                                <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                            </StackProcess>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/ARC_IMPA_GetBatchId)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx2:ErrorMessage>
                </data>
            </ns:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>ARC_FindBatchId</pd:from>
        <pd:to>ARC_IMPA_SendNewBatch</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$ARC_FindBatchId/group/IsNew="true"</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_IMPA_SendNewBatch</pd:from>
        <pd:to>Null</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FindBatchId</pd:from>
        <pd:to>Null</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Null</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Error in GetBatchId</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_FindBatchId</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>