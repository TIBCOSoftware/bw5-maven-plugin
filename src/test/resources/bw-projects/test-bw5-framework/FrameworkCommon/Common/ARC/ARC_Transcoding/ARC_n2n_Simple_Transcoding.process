<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_Transcoding/ARC_n2n_Simple_Transcoding.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="root">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="appSource" type="xsd:string"/>
                    <xsd:element name="appDestination" type="xsd:string"/>
                    <xsd:element name="uniqueParameters" maxOccurs="unbounded">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="entity" type="xsd:string"/>
                                <xsd:element name="code" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>138</pd:startX>
    <pd:startY>237</pd:startY>
    <pd:returnBindings>
        <root>
            <xsl:copy-of select="$codeList/AccumulatedOutput/codeDestinationList"/>
        </root>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="root">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="codeDestinationList" maxOccurs="unbounded">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="entityName" type="xsd:string"/>
                                <xsd:element name="destinationCode" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>841</pd:endX>
    <pd:endY>236</pd:endY>
    <pd:errorSchemas>
        <Schema0 ref="pfx:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1336719240233</pd:targetNamespace>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>287</pd:x>
        <pd:y>68</pd:y>
        <pd:width>449</pd:width>
        <pd:height>322</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>inputLoop</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:over>$Start/root/uniqueParameters</pd:over>
            <pd:indexSlot>i</pd:indexSlot>
            <pd:outSlot>codeList</pd:outSlot>
            <pd:activityOutputName>Map Data</pd:activityOutputName>
            <pd:accumulateOutput>true</pd:accumulateOutput>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Null</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Map Data</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Null</pd:from>
            <pd:to>ARC_Simple_transcoding</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_Simple_transcoding</pd:from>
            <pd:to>Map Data</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="ARC_Simple_transcoding">
            <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
            <pd:resourceType>ae.process.subprocess</pd:resourceType>
            <pd:x>478</pd:x>
            <pd:y>240</pd:y>
            <config>
                <processName>/Common/ARC/ARC_Transcoding/ARC_Simple_Transcoding.process</processName>
            </config>
            <pd:inputBindings>
                <interface>
                    <simpleInterface>
                        <appSource>
                            <xsl:value-of select="$Start/root/appSource"/>
                        </appSource>
                        <appDestination>
                            <xsl:value-of select="$Start/root/appDestination"/>
                        </appDestination>
                        <entity>
                            <xsl:value-of select="$Start/root/uniqueParameters[$i]/entity"/>
                        </entity>
                        <code>
                            <xsl:value-of select="$Start/root/uniqueParameters[$i]/code"/>
                        </code>
                    </simpleInterface>
                </interface>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Null">
            <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
            <pd:resourceType>ae.activities.null</pd:resourceType>
            <pd:x>354</pd:x>
            <pd:y>236</pd:y>
            <config/>
            <pd:inputBindings/>
        </pd:activity>
        <pd:activity name="Map Data">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:x>591</pd:x>
            <pd:y>239</pd:y>
            <config>
                <element>
                    <xsd:element name="codeDestinationList">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="entityName" type="xsd:string"/>
                                <xsd:element name="destinationCode" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <codeDestinationList>
                    <entityName>
                        <xsl:value-of select="$Start/root/uniqueParameters[$i]/entity"/>
                    </entityName>
                    <destinationCode>
                        <xsl:value-of select="$ARC_Simple_transcoding/destinationCode"/>
                    </destinationCode>
                </codeDestinationList>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:activity name="CatchArchError">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>202</pd:x>
        <pd:y>429</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>321</pd:x>
        <pd:y>428</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CatchArchError</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:label>
        <pd:name>Label</pd:name>
        <pd:description>Invoke n times to
simple process.</pd:description>
        <pd:x>359</pd:x>
        <pd:y>127</pd:y>
        <pd:width>120</pd:width>
        <pd:height>47</pd:height>
        <pd:fontName>Dialog.bold-plain-12</pd:fontName>
        <pd:fontColor>-16777216</pd:fontColor>
        <pd:color>-39322</pd:color>
        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
    <pd:label>
        <pd:name>Label (1)</pd:name>
        <pd:description>Map @entity and
destination code
for each query</pd:description>
        <pd:x>591</pd:x>
        <pd:y>316</pd:y>
        <pd:width>113</pd:width>
        <pd:height>63</pd:height>
        <pd:fontName>Dialog.bold-plain-12</pd:fontName>
        <pd:fontColor>-16777216</pd:fontColor>
        <pd:color>-6684775</pd:color>
        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
</pd:ProcessDefinition>