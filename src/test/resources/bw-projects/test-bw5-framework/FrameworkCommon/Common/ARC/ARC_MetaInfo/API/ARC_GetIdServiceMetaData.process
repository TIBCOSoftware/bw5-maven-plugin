<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_MetaInfo/API/ARC_GetIdServiceMetaData.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Name" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>126</pd:startX>
    <pd:startY>70</pd:startY>
    <pd:returnBindings>
        <ServiceMetaData>
            <xsl:choose>
                <xsl:when test="string-length($GetMetaDataVariable/ServiceMetaData/Data[ Name = $Start/Data/Name ]/Value)>0">
                    <Data>
                        <Name>
                            <xsl:value-of select="$Start/Data/Name"/>
                        </Name>
                        <Value>
                            <xsl:value-of select="$GetMetaDataVariable/ServiceMetaData/Data[ Name = $Start/Data/Name    ]/Value"/>
                        </Value>
                    </Data>
                </xsl:when>
                <xsl:otherwise>
                    <Data>
                        <Name>
                            <xsl:value-of select="$Start/Data/Name"/>
                        </Name>
                        <Value>
                            <xsl:value-of select="&quot;&quot;"/>
                        </Value>
                    </Data>
                </xsl:otherwise>
            </xsl:choose>
        </ServiceMetaData>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="ServiceMetaData">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Data" maxOccurs="unbounded">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="Name" type="xsd:string"/>
                                <xsd:element name="Value" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>552</pd:endX>
    <pd:endY>68</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1334302660977</pd:targetNamespace>
    <pd:activity name="GetMetaDataVariable">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>295</pd:x>
        <pd:y>69</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceMetaData.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetMetaDataVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetMetaDataVariable</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>