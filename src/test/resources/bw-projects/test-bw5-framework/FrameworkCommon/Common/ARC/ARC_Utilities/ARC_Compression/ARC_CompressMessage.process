    <pd:targetNamespace>http://xmlns.example.com/1547731902699</pd:targetNamespace>
    <pd:activity name="Java Code Compress Message and Hash">
        <pd:type>com.tibco.plugin.java.JavaActivity</pd:type>
        <pd:resourceType>ae.javapalette.javaActivity</pd:resourceType>
        <pd:x>227</pd:x>
        <pd:y>146</pd:y>
        <config>
            <fileName>ARC_CompressMessageJavaCodeCompressMessageandHash</fileName>
            <packageName>Common.ARC.ARC_Utilities.ARC_Compression.ARC_CompressMessage</packageName>
            <fullsource>package Common.ARC.ARC_Utilities.ARC_Compression.ARC_CompressMessage;
import java.io.BufferedReader;
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.zip.GZIPInputStream;
import java.util.zip.GZIPOutputStream;
import java.math.BigInteger;
import java.security.MessageDigest;

public class ARC_CompressMessageJavaCodeCompressMessageandHash{

public static byte[]  compress(String data) throws IOException {
		ByteArrayOutputStream bos = new ByteArrayOutputStream(data.length());
		GZIPOutputStream gzip = new GZIPOutputStream(bos);
		gzip.write(data.getBytes("UTF-8"));
		gzip.close();
		byte [] compressed = bos.toByteArray();
		bos.close();
		return compressed;
	}

public static String getSHA256(String input){

	String toReturn = null;
	try {
	    MessageDigest digest = MessageDigest.getInstance("SHA-256");
	    digest.reset();
	    digest.update(input.getBytes("utf8"));
	    toReturn = String.format("%064x", new BigInteger(1, digest.digest()));
	} catch (Exception e) {
	    e.printStackTrace();
	}
	
	return toReturn;
    }


/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected String message_in = "";
	protected byte[] message_out = null;
	protected String message_out_hash = "";
	public String getmessage_in() {
		return message_in;
	}
	public void setmessage_in(String val) {
		message_in = val;
	}
	public byte[] getmessage_out() {
		return message_out;
	}
	public void setmessage_out(byte[] val) {
		message_out = val;
	}
	public String getmessage_out_hash() {
		return message_out_hash;
	}
	public void setmessage_out_hash(String val) {
		message_out_hash = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public ARC_CompressMessageJavaCodeCompressMessageandHash() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	In  : String message_in
	Out : byte[] message_out
	Out : String message_out_hash
* Available Variables: DO NOT MODIFY *****/

message_out = compress(message_in);
message_out_hash = getSHA256(message_in);}
}
</fullsource>
            <inputData>
                <row>
                    <fieldName>message_in</fieldName>
                    <fieldType>string</fieldType>
                    <fieldRequired>optional</fieldRequired>
                </row>
            </inputData>
            <outputData>
                <row>
                    <fieldName>message_out</fieldName>
                    <fieldType>byte</fieldType>
                    <fieldRequired>repeating</fieldRequired>
                </row>
                <row>
                    <fieldName>message_out_hash</fieldName>
                    <fieldType>string</fieldType>
                    <fieldRequired>optional</fieldRequired>
                </row>
            </outputData>
            <byteCode>
                <class>
                    <name>ARC_CompressMessageJavaCodeCompressMessageandHash</name>
                    <byteCode></byteCode>
                </class>
            </byteCode>
        </config>
        <pd:inputBindings>
            <javaCodeActivityInput>
                <message_in>
                    <xsl:value-of select="$Start/Input/OriginalMessage"/>
                </message_in>
            </javaCodeActivityInput>
        </pd:inputBindings>
    </pd:activity>
