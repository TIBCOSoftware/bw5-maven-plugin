    </pd:startType>
    <pd:startX>83</pd:startX>
    <pd:startY>138</pd:startY>
    <pd:returnBindings>
        <xsl:choose>
            <xsl:when test="string-length($Start/Input/OriginalMessage)=0">
                <Output/>
            </xsl:when>
            <xsl:otherwise>
                <Output>
                    <CompressMessage>
                        <xsl:value-of select="$Java-Code-Compress-Message-and-Hash/javaCodeActivityOutput/message_out"/>
                    </CompressMessage>
                    <HashMessage>
                        <xsl:value-of select="$Java-Code-Compress-Message-and-Hash/javaCodeActivityOutput/message_out_hash"/>
                    </HashMessage>
                </Output>
            </xsl:otherwise>
        </xsl:choose>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Output">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="CompressMessage" type="xsd:base64Binary" minOccurs="0"/>
                    <xsd:element name="HashMessage" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>380</pd:endX>
    <pd:endY>138</pd:endY>
