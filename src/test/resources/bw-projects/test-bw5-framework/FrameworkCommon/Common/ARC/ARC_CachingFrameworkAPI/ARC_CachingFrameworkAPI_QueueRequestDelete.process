<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pfx="http://www.tibco.com/ns/no_namespace_schema_location/SharedResources/Schemas/XSD/CachingFramework/esb-querys-structure.xsd" xmlns:pfx2="http://www.bbva.com/EAIFramework" xmlns:ns="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns2="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://schemas.tibco.com/bw/plugins/jms/5.0/jmsExceptions" xmlns:ns3="http://www.tibco.com/pe/EngineTypes" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns02="www.tibco.com/plugin/Sleep" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema">
    <xsd:import namespace="http://www.tibco.com/ns/no_namespace_schema_location/SharedResources/Schemas/XSD/CachingFramework/esb-querys-structure.xsd" schemaLocation="/SharedResources/Schemas/XSD/CachingFramework/esb-querys-structure.xsd"/>
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_CachingFrameworkAPI/ARC_CachingFrameworkAPI_QueueRequestDelete.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Operation">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:choice>
                                    <xsd:element name="DeleteByIdMessage">
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="cacheName" type="xsd:string"/>
                                                <xsd:element name="Id" type="xsd:string" maxOccurs="unbounded"/>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="DeleteMessage">
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element ref="pfx:query"/>
                                                <xsd:element name="cacheName" type="xsd:string"/>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                </xsd:choice>
                                <xsd:element name="QueueName" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>42</pd:startX>
    <pd:startY>153</pd:startY>
    <pd:returnBindings>
        <Output>
            <NumRec>
                <xsl:value-of select="$CacheQueueReq/ns0:ActivityOutput/Body/CachingMSG/ReturnList/Result"/>
            </NumRec>
            <xsl:copy-of select="$CacheQueueReq/ns0:ActivityOutput/Body/CachingMSG/pfx2:ErrorMessage"/>
        </Output>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Output">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="NumRec" type="xsd:string"/>
                    <xsd:element ref="pfx2:ErrorMessage" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>852</pd:endX>
    <pd:endY>153</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx2:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1442906338168</pd:targetNamespace>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>336</pd:x>
        <pd:y>21</pd:y>
        <pd:width>339</pd:width>
        <pd:height>245</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>errorLoop</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:indexSlot>i</pd:indexSlot>
            <pd:errorCondition>$i &gt;= $_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/CACHING/Reintento/Num_Intentos_Conexion</pd:errorCondition>
            <pd:suspendAfterErrorRetry>false</pd:suspendAfterErrorRetry>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Null</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>CacheQueueReq</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Null</pd:from>
            <pd:to>Sleep</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>$i&gt;1</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>Null</pd:from>
            <pd:to>CacheQueueReq</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Sleep</pd:from>
            <pd:to>CacheQueueReq</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Null">
            <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
            <pd:resourceType>ae.activities.null</pd:resourceType>
            <pd:x>412</pd:x>
            <pd:y>89</pd:y>
            <config/>
            <pd:inputBindings/>
        </pd:activity>
        <pd:activity name="Sleep">
            <pd:type>com.tibco.plugin.timer.SleepActivity</pd:type>
            <pd:resourceType>ae.activities.sleep</pd:resourceType>
            <pd:x>487</pd:x>
            <pd:y>173</pd:y>
            <config/>
            <pd:inputBindings>
                <ns02:SleepInputSchema>
                    <xsl:choose>
                        <xsl:when test="$i=2">
                            <IntervalInMillisec>
                                <xsl:value-of select="$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/CACHING/Reintento/Intervalo_Primera_Reconexion"/>
                            </IntervalInMillisec>
                        </xsl:when>
                        <xsl:otherwise>
                            <IntervalInMillisec>
                                <xsl:value-of select="$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/CACHING/Reintento/Intervalo_Resto_Reconexiones"/>
                            </IntervalInMillisec>
                        </xsl:otherwise>
                    </xsl:choose>
                </ns02:SleepInputSchema>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="CacheQueueReq">
            <pd:type>com.tibco.plugin.jms.JMSQueueRequestReplyActivity</pd:type>
            <pd:resourceType>ae.activities.JMSQueueRequestReplyActivity</pd:resourceType>
            <pd:x>581</pd:x>
            <pd:y>97</pd:y>
            <config>
                <PermittedMessageType>XML Text</PermittedMessageType>
                <SessionAttributes>
                    <transacted>false</transacted>
                    <acknowledgeMode>1</acknowledgeMode>
                    <maxSessions>1</maxSessions>
                </SessionAttributes>
                <ConfigurableHeaders>
                    <JMSDeliveryMode>PERSISTENT</JMSDeliveryMode>
                    <JMSExpiration>0</JMSExpiration>
                    <JMSPriority>4</JMSPriority>
                </ConfigurableHeaders>
                <ConnectionReference>/SharedResources/Connections/JMSConnections/Business/BusinessConnection.sharedjmscon</ConnectionReference>
                <InDataxsdString>
                    <xsd:element name="Operation">
                        <xsd:complexType>
                            <xsd:choice>
                                <xsd:element name="DeleteByIdMessage">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="cacheName" type="xsd:string"/>
                                            <xsd:element name="Id" type="xsd:string" maxOccurs="unbounded"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                                <xsd:element name="DeleteMessage">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element ref="pfx:query"/>
                                            <xsd:element name="cacheName" type="xsd:string"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:choice>
                        </xsd:complexType>
                    </xsd:element>
                </InDataxsdString>
                <OutDataxsdString>
                    <xsd:element name="CachingMSG">
                        <xsd:complexType>
                            <xsd:choice>
                                <xsd:element name="ReturnList">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="Result" type="xsd:string"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                                <xsd:element ref="pfx2:ErrorMessage"/>
                            </xsd:choice>
                        </xsd:complexType>
                    </xsd:element>
                </OutDataxsdString>
            </config>
            <pd:inputBindings>
                <ns0:ActivityInput>
                    <destinationQueue>
                        <xsl:value-of select="concat($Start/Data/Operation/QueueName,&#xA;$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/CACHING/TokenQueues/Caching_FrameWork_OPS)"/>
                    </destinationQueue>
                    <JMSExpiration>
                        <xsl:value-of select="$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_CachingRequestTimeout"/>
                    </JMSExpiration>
                    <requestTimeout>
                        <xsl:value-of select="$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_CachingRequestTimeout"/>
                    </requestTimeout>
                    <Body>
                        <Operation>
                            <xsl:choose>
                                <xsl:when test="exists($Start/Data/Operation/DeleteByIdMessage/Id)">
                                    <DeleteByIdMessage>
                                        <cacheName>
                                            <xsl:value-of select="$Start/Data/Operation/DeleteByIdMessage/cacheName"/>
                                        </cacheName>
                                        <xsl:for-each select="$Start/Data/Operation/DeleteByIdMessage/Id">
                                            <Id>
                                                <xsl:value-of select="."/>
                                            </Id>
                                        </xsl:for-each>
                                    </DeleteByIdMessage>
                                </xsl:when>
                                <xsl:otherwise>
                                    <DeleteMessage>
                                        <xsl:copy-of select="$Start/Data/Operation/DeleteMessage/query"/>
                                        <cacheName>
                                            <xsl:value-of select="$Start/Data/Operation/DeleteMessage/cacheName"/>
                                        </cacheName>
                                    </DeleteMessage>
                                </xsl:otherwise>
                            </xsl:choose>
                        </Operation>
                    </Body>
                    <DynamicProperties>
                        <property>
                            <name>
                                <xsl:value-of select="$_globalVariables/ns:GlobalVariables/CFG/ARCHITECTURE/CACHING/JMS_PROPERTY_INSTANCEID"/>
                            </name>
                            <value>
                                <xsl:value-of select="$ARC_GetArchitectureHeader/pfx2:ArchitectureHeader/pfx2:AuditHeader/pfx2:InstanceId"/>
                            </value>
                        </property>
                    </DynamicProperties>
                </ns0:ActivityInput>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:activity name="Catch Controlled Error">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>53</pd:x>
        <pd:y>348</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>271</pd:x>
        <pd:y>338</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Error JMS">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>503</pd:x>
        <pd:y>341</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <xsl:choose xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
                        <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns2:ActivityTimedOutException)">
                            <pfx2:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_Timeout"/>
                                </ErrorCode>
                                <ErrorDescription>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_ARC_RequestMessage2QueueOrTopicTimeout"/>
                                </ErrorDescription>
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/ProcessStack"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Severities/GLB_Warning"/>
                                </Severity>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Technical"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="tib:render-xml($Start/Data)"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </pfx2:ErrorMessage>
                        </xsl:when>
                        <xsl:otherwise>
                            <pfx2:ErrorMessage>
                                <xsl:choose>
                                    <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns1:JMSInvalidInputException)">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_InvalidInput"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns1:JMSMessageCreateException)">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_MessageCreate"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns1:JMSSessionCreateException)">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_SessionCreate"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns1:JMSSendException)">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_Send"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="exists($_error_CacheQueueReq/ActivityErrors/ns1:JMSReceiveException)">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_Receive"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                        </ErrorCode>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/Msg"/>
                                </ErrorDescription>
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns3:ErrorReport/ProcessStack"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                </Severity>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Technical"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="tib:render-xml($Start/Data)"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </pfx2:ErrorMessage>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_GetArchitectureHeader">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>190</pd:x>
        <pd:y>152</pd:y>
        <config>
            <processName>/Common/ARC/ARC_GetArchitectureData/ARC_GetArchitectureHeader.process</processName>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_GetArchitectureHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Controlled Error</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>Error JMS</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_GetArchitectureHeader</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>