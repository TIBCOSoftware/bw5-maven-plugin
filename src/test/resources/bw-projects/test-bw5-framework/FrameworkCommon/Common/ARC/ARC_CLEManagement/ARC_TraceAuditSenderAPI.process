        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
    <pd:label>
        <pd:name>Label (1)</pd:name>
        <pd:description>Los eventos que se envian asociados a auditoria deben ser considerados como hijos del adaptador que los envia. Esto exige cambios en el mapeo del parentId en el auditheader dentro del mensaje</pd:description>
