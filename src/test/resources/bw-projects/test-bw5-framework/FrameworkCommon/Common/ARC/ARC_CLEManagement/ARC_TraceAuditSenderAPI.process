                            <MessageHeader>
                                <IsResponse>
                                    <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/isResponse"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/MessageType"/>
                                </MessageType>
                                <xsl:choose>
                                    <xsl:when test="count($Start/ARC_TraceSenderAPI/CLETraceData/NameValue[ Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_GenericBusinessObjectKey ]/Value)>0">
                                        <BusinessObject>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[ Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_GenericBusinessObjectKey ]/Value"/>
                                        </BusinessObject>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <BusinessObject>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:BusinessObject"/>
                                        </BusinessObject>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </MessageHeader>
                            <AuditHeader>
                                <xsl:if test="string-length($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId)>0">
                                    <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId">
                                        <ParentInstanceId>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentInstanceId"/>
                                        </ParentInstanceId>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ReprocessingHeader">
                                    <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ReprocessingHeader/ns3:RetriesNumber">
                                        <RetriesNumber>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ReprocessingHeader/ns3:RetriesNumber"/>
                                        </RetriesNumber>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:choose>
                                    <xsl:when test="count($Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_GW_POST_NUM_MSGSENT])>0">
                                        <NumMessagesSent>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_GW_POST_NUM_MSGSENT]/Value"/>
                                        </NumMessagesSent>
                                    </xsl:when>
                                    <xsl:when test="count($Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/BATCH1N_NUM_MSG_SENT])>0">
                                        <NumMessagesSent>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/BATCH1N_NUM_MSG_SENT]/Value"/>
                                        </NumMessagesSent>
                                    </xsl:when>
                                    <xsl:when test="count($Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GENERIC_E2E_NUM_CHILDS])>0">
                                        <xsl:if test="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GENERIC_E2E_NUM_CHILDS]/Value">
                                            <NumMessagesSent>
                                                <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GENERIC_E2E_NUM_CHILDS]/Value"/>
                                            </NumMessagesSent>
                                        </xsl:if>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <NumMessagesSent>
                                            <xsl:value-of select="0"/>
                                        </NumMessagesSent>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <xsl:if test="string-length($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:ExternalId)>0">
                                    <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:ExternalId">
                                        <ClientExternalId>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:ExternalId"/>
                                        </ClientExternalId>
                                    </xsl:if>
                                </xsl:if>
                                <ServiceType>
                                    <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ServiceType"/>
                                </ServiceType>
                                <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ReprocessingHeader">
                                    <OriginalInstanceId>
                                        <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ReprocessingHeader/ns3:OriginalInstanceId"/>
                                    </OriginalInstanceId>
                                </xsl:if>
                                <xsl:choose>
                                    <xsl:when test="exists($Start/ARC_TraceSenderAPI/CLETraceData/TraceLevel)">
                                        <TraceLevel>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/TraceLevel"/>
                                        </TraceLevel>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <TraceLevel>
                                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/TraceLevels/GLB_Critical"/>
                                        </TraceLevel>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <StarterServiceId>
                                    <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:ServiceIdStarter"/>
                                </StarterServiceId>
                                <StarterTimestamp>
                                    <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:RequestHeader/ns3:StartTimestamp"/>
                                </StarterTimestamp>
                                <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:isLight">
                                    <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:isLight">
                                        <LightActive>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:isLight"/>
                                        </LightActive>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:choose>
                                    <xsl:when test="string-length($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl)>0">
                                        <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl">
                                            <E2EControl>
                                                <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:E2EControl"/>
                                            </E2EControl>
                                        </xsl:if>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <E2EControl>
                                            <xsl:value-of select="false()"/>
                                        </E2EControl>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <xsl:choose>
                                    <xsl:when test="string-length($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentE2EControl)>0">
                                        <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentE2EControl">
                                            <ParentE2EControl>
                                                <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:AuditHeader/ns3:ParentE2EControl"/>
                                            </ParentE2EControl>
                                        </xsl:if>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <ParentE2EControl>
                                            <xsl:value-of select="false()"/>
                                        </ParentE2EControl>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </AuditHeader>
                            <xsl:if test="string-length($GetECSConfig/group/ns3:ECSConfig/ns3:namespace)>0&#xA;and&#xA;string-length($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:traceId)>0">
                                <ECSHeader>
                                    <ns3:traceId>
                                        <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:traceId"/>
                                    </ns3:traceId>
                                    <xsl:if test="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:parentSpan">
                                        <ns3:parentSpan>
                                            <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:parentSpan"/>
                                        </ns3:parentSpan>
                                    </xsl:if>
                                    <ns3:spanId>
                                        <xsl:value-of select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:spanId"/>
                                    </ns3:spanId>
                                    <xsl:if test="count($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:properties/ns3:property)>0&#xA;or&#xA;count($GetECSConfig/group/ns3:ECSConfig/ns3:properties/ns3:property)>0">
                                        <ns3:properties>
                                            <xsl:if test="count($GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:properties/ns3:property)>0">
                                                <xsl:for-each-group select="$GetArchitectureHeader/FrameworkData/ns3:ArchitectureHeader/ns3:ECSHeader/ns3:properties/ns3:property" group-by="ns3:key">
                                                    <xsl:if test="count($GetECSConfig/group/ns3:ECSConfig/ns3:properties/ns3:property[ns3:key=current-group()/ns3:key])=0">
                                                        <xsl:copy-of select="."/>
                                                    </xsl:if>
                                                </xsl:for-each-group>
                                            </xsl:if>
                                            <xsl:if test="count($GetECSConfig/group/ns3:ECSConfig/ns3:properties/ns3:property)>0">
                                                <xsl:for-each select="$GetECSConfig/group/ns3:ECSConfig/ns3:properties/ns3:property">
                                                    <ns3:property>
                                                        <ns3:key>
                                                            <xsl:value-of select="ns3:key"/>
                                                        </ns3:key>
                                                        <xsl:choose>
                                                            <xsl:when test="ns3:boolean_value">
                                                                <ns3:boolean_value>
                                                                    <xsl:value-of select="ns3:boolean_value"/>
                                                                </ns3:boolean_value>
                                                            </xsl:when>
                                                            <xsl:when test="ns3:number_value">
                                                                <ns3:number_value>
                                                                    <xsl:value-of select="ns3:number_value"/>
                                                                </ns3:number_value>
                                                            </xsl:when>
                                                            <xsl:otherwise>
                                                                <ns3:value>
                                                                    <xsl:value-of select="ns3:value"/>
                                                                </ns3:value>
                                                            </xsl:otherwise>
                                                        </xsl:choose>
                                                    </ns3:property>
                                                </xsl:for-each>
                                            </xsl:if>
                                        </ns3:properties>
                                    </xsl:if>
                                    <namespace>
                                        <xsl:value-of select="$GetECSConfig/group/ns3:ECSConfig/ns3:namespace"/>
                                    </namespace>
                                    <mrId>
                                        <xsl:value-of select="$GetECSConfig/group/ns3:ECSConfig/ns3:mrId"/>
                                    </mrId>
                                </ECSHeader>
                            </xsl:if>
                            <xsl:if test="$Start/ARC_TraceSenderAPI/CLETraceData/EventType = $_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error">
                                <ErrorHeader>
                                    <ErrorCode>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/ErrorCode"/>
                                    </ErrorCode>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/ErrorDescription">
                                        <ErrorDescription>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/ErrorDescription"/>
                                        </ErrorDescription>
                                    </xsl:if>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/NativeErrorCode">
                                        <NativeErrorCode>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/NativeErrorCode"/>
                                        </NativeErrorCode>
                                    </xsl:if>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/NativeErrorDescription">
                                        <NativeErrorDescription>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/NativeErrorDescription"/>
                                        </NativeErrorDescription>
                                    </xsl:if>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/StackTrace">
                                        <StackTrace>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/StackTrace"/>
                                        </StackTrace>
                                    </xsl:if>
                                    <ErrorDate>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/ErrorDate"/>
                                    </ErrorDate>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/StackProcess">
                                        <StackProcess>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/StackProcess"/>
                                        </StackProcess>
                                    </xsl:if>
                                    <Severity>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/Severity"/>
                                    </Severity>
                                    <xsl:if test="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/OriginalMessage">
                                        <OriginalMessage>
                                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/OriginalMessage"/>
                                        </OriginalMessage>
                                    </xsl:if>
                                    <Category>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/Category"/>
                                    </Category>
                                    <ProcessInputMessage>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/ProcessInputMessage"/>
                                    </ProcessInputMessage>
                                    <IsResponse>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/IsResponse"/>
                                    </IsResponse>
                                    <MessageType>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/MessageType"/>
                                    </MessageType>
                                    <xsl:copy-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/PreviousErrorMessage"/>
                                    <xsl:copy-of select="$Start/ARC_TraceSenderAPI/ns3:ErrorMessage/FunctionalErrorData"/>
                                </ErrorHeader>
                            </xsl:if>
                            <MetaDataHeader>
                                <xsl:for-each select="$GetServiceMetaData/ServiceMetaData/Data">
                                    <ServiceMetaData>
                                        <xsl:attribute name="MetaDataPropertyName">
                                            <xsl:value-of select="current()/Name"/>
                                        </xsl:attribute>
                                        <xsl:value-of select="current()/Value"/>
                                    </ServiceMetaData>
                                </xsl:for-each>
                            </MetaDataHeader>
                            <xsl:if test="count($Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTNAME])>0">
                                <FunEventHeader>
                                    <EventName>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTNAME]/Value"/>
                                    </EventName>
                                    <EventType>
                                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/NameValue[Name=$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTYPE]/Value"/>
                                    </EventType>
                                </FunEventHeader>
                            </xsl:if>
                        </CLEInternalHeader>
                    </xsl:otherwise>
                </xsl:choose>
                <Body>
                    <xsl:value-of select="$Start/ARC_TraceSenderAPI/Body"/>
                </Body>
            </ns3:CLEInternalMessage>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetArchitectureHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:xpathDescription>input header</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>exists($Start/ARC_TraceSenderAPI/CLETraceData/ns3:ArchitectureHeader)</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>GetServiceMetaData</pd:from>
        <pd:to>Map CLEInternalMessage</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetArchitectureHeader</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CLESenderAPI_EventPatterns</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CLESenderAPI_Audit</pd:from>
        <pd:to>CLESenderAPI_EventPatterns</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>GetServiceMetaData</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Map CLEInternalMessage</pd:from>
        <pd:to>CLESenderAPI_Audit</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:label>
        <pd:name>Label</pd:name>
        <pd:description>El codigo de envio de los metadatos de los servicios hacia el modulo de auditoria se incorpora</pd:description>
        <pd:x>805</pd:x>
        <pd:y>56</pd:y>
        <pd:width>379</pd:width>
        <pd:height>49</pd:height>
        <pd:fontColor>-16777216</pd:fontColor>
