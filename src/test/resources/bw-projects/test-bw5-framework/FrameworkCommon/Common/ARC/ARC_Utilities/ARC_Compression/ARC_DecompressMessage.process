<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <pd:name>Common/ARC/ARC_Utilities/ARC_Compression/ARC_DecompressMessage.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Input">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="CompressMessage" type="xsd:base64Binary"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>75</pd:startX>
    <pd:startY>79</pd:startY>
    <pd:returnBindings>
        <Output>
            <DecompressMessage>
                <xsl:value-of select="$Java-Code-Decompress/javaCodeActivityOutput/message_out"/>
            </DecompressMessage>
        </Output>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Output">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="DecompressMessage" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>375</pd:endX>
    <pd:endY>79</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1547731923860</pd:targetNamespace>
    <pd:activity name="Java Code Decompress">
        <pd:type>com.tibco.plugin.java.JavaActivity</pd:type>
        <pd:resourceType>ae.javapalette.javaActivity</pd:resourceType>
        <pd:x>219</pd:x>
        <pd:y>87</pd:y>
        <config>
            <fileName>ARC_DecompressMessageJavaCodeDecompress</fileName>
            <packageName>Common.ARC.ARC_Utilities.ARC_Compression.ARC_DecompressMessage</packageName>
            <fullsource>package Common.ARC.ARC_Utilities.ARC_Compression.ARC_DecompressMessage;
import java.io.BufferedReader;
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.zip.GZIPInputStream;
import java.util.zip.GZIPOutputStream;

public class ARC_DecompressMessageJavaCodeDecompress{

public static String decompress(byte[] compressed) throws IOException {
		ByteArrayInputStream bis = new ByteArrayInputStream(compressed);
		GZIPInputStream gis = new GZIPInputStream(bis);
		BufferedReader br = new BufferedReader(new InputStreamReader(gis, "UTF-8"));
		StringBuilder sb = new StringBuilder();
		String line;
		while((line = br.readLine()) != null) {
			sb.append(line);
		}
		br.close();
		gis.close();
		bis.close();
		return sb.toString();
	}


/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected byte[] message_in = null;
	protected String message_out = "";
	public byte[] getmessage_in() {
		return message_in;
	}
	public void setmessage_in(byte[] val) {
		message_in = val;
	}
	public String getmessage_out() {
		return message_out;
	}
	public void setmessage_out(String val) {
		message_out = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public ARC_DecompressMessageJavaCodeDecompress() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	In  : byte[] message_in
	Out : String message_out
* Available Variables: DO NOT MODIFY *****/

message_out = decompress(message_in);}
}
</fullsource>
            <inputData>
                <row>
                    <fieldName>message_in</fieldName>
                    <fieldType>byte</fieldType>
                    <fieldRequired>repeating</fieldRequired>
                </row>
            </inputData>
            <outputData>
                <row>
                    <fieldName>message_out</fieldName>
                    <fieldType>string</fieldType>
                    <fieldRequired>optional</fieldRequired>
                </row>
            </outputData>
            <byteCode>
                <class>
                    <name>ARC_DecompressMessageJavaCodeDecompress</name>
                    <byteCode></byteCode>
                </class>
            </byteCode>
        </config>
        <pd:inputBindings>
            <javaCodeActivityInput>
                <message_in>
                    <xsl:value-of select="$Start/Input/CompressMessage"/>
                </message_in>
            </javaCodeActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Java Code Decompress</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Java Code Decompress</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>