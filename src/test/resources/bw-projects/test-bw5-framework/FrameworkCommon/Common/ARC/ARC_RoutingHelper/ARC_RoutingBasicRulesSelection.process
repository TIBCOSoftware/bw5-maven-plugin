<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns="http://www.tibco.com/pe/EngineTypes" xmlns:ns0="http://www.tibco.com/pe/SignalInActivitySchema" xmlns:UUID="java://Framework.CommonResources.CustomFunctions.UUIDGenerator.UUIDGenerator" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx2="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_RoutingHelper/ARC_RoutingBasicRulesSelection.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="IN_GetRoutedMessage">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:Messages"/>
                    <xsd:element name="DynamicInvocationRoot" type="xsd:string"/>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>36</pd:startX>
    <pd:startY>182</pd:startY>
    <pd:returnBindings>
        <OUT_GetRoutedMessages>
            <xsl:if test="count($ARC_ORC_GenericTargetRouting/OUT_GetTargetServices/TargetServices/pfx:RoutingService)>0">
                <pfx:Message>
                    <pfx:ArchitectureHeader>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:AuditHeader"/>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:ECSHeader"/>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:RequestHeader"/>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:ErrorHeader"/>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:ReprocessingHeader"/>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:SecurityHeader"/>
                        <pfx:RoutingHeader>
                            <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Origin"/>
                            <xsl:if test="count($ARC_ORC_GenericTargetRouting/OUT_GetTargetServices/TargetServices/pfx:RoutingService)>0">
                                <pfx:Target>
                                    <pfx:Services>
                                        <xsl:for-each select="$ARC_ORC_GenericTargetRouting/OUT_GetTargetServices/TargetServices/pfx:RoutingService">
                                            <pfx:Service>
                                                <pfx:ServiceId>
                                                    <xsl:value-of select="current()/pfx:ServiceId"/>
                                                </pfx:ServiceId>
                                                <xsl:if test="current()/pfx:JMSInputDestinationName">
                                                    <pfx:JMSInputDestinationName>
                                                        <xsl:value-of select="current()/pfx:JMSInputDestinationName"/>
                                                    </pfx:JMSInputDestinationName>
                                                </xsl:if>
                                                <xsl:if test="current()/pfx:JMSInputDestinationType">
                                                    <pfx:JMSInputDestinationType>
                                                        <xsl:value-of select="current()/pfx:JMSInputDestinationType"/>
                                                    </pfx:JMSInputDestinationType>
                                                </xsl:if>
                                                <pfx:ServiceType>
                                                    <xsl:value-of select="current()/pfx:ServiceType"/>
                                                </pfx:ServiceType>
                                            </pfx:Service>
                                        </xsl:for-each>
                                    </pfx:Services>
                                </pfx:Target>
                            </xsl:if>
                        </pfx:RoutingHeader>
                        <xsl:copy-of select="$GetFrameworkHeader/FrameworkData/pfx:ArchitectureHeader/pfx:FunctionalData"/>
                    </pfx:ArchitectureHeader>
                    <pfx:Body>
                        <xsl:copy-of select="$ARC_ORC_GenericTargetRouting/OUT_GetTargetServices/Body/*"/>
                    </pfx:Body>
                </pfx:Message>
            </xsl:if>
        </OUT_GetRoutedMessages>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="OUT_GetRoutedMessages">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:Message" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>588</pd:endX>
    <pd:endY>183</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1380098109578</pd:targetNamespace>
    <pd:activity name="ARC_ORC_SetRoutingRules">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>289</pd:x>
        <pd:y>183</pd:y>
        <config>
            <processNameXPath>concat($Start/IN_GetRoutedMessage/DynamicInvocationRoot, concat($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Gateway/GLB_RulesSelection,"Rules.process" ) )</processNameXPath>
            <processName>/Common/ARC_ORCH/Functional/FUN_ORC_Routing_Rules.process</processName>
        </config>
        <pd:inputBindings>
            <xsl:copy-of select="$Start/IN_GetRoutedMessage/pfx:Messages"/>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>189</pd:x>
        <pd:y>285</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>351</pd:x>
        <pd:y>277</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="ARC_ORC_GenericTargetRouting">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>444</pd:x>
        <pd:y>181</pd:y>
        <config>
            <processNameXPath>concat($Start/IN_GetRoutedMessage/DynamicInvocationRoot, concat($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/GLB_Routing,concat("Routing-", concat($ARC_ORC_SetRoutingRules/RoutingRules, ".process"))))</processNameXPath>
            <processName>/Common/ARC/ARC_RoutingHelper/ARC_RoutingGenericRules.process</processName>
        </config>
        <pd:inputBindings>
            <IN_GetTargetServices>
                <ServiceId>
                    <xsl:value-of select="$Start/IN_GetRoutedMessage/ServiceId"/>
                </ServiceId>
                <xsl:copy-of select="$Start/IN_GetRoutedMessage/pfx:Messages"/>
            </IN_GetTargetServices>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>191</pd:x>
        <pd:y>379</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate ErrorMessage">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>450</pd:x>
        <pd:y>388</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <pfx:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Generic_Error_RoutingFromFileByServiceId"/>
                        </ErrorDescription>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/IN_GetRoutedMessage)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx:ErrorMessage>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetFrameworkHeader">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>152</pd:x>
        <pd:y>184</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_ORC_SetRoutingRules</pd:from>
        <pd:to>ARC_ORC_GenericTargetRouting</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate ErrorMessage</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetFrameworkHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetFrameworkHeader</pd:from>
        <pd:to>ARC_ORC_SetRoutingRules</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_ORC_GenericTargetRouting</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>