    <pd:activity name="Error in ARC_SendMessageToQueueOrTopic">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>528</pd:x>
        <pd:y>310</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx:ActivityInput>
                <data>
                    <pfx2:ErrorMessage>
                        <xsl:choose>
                            <xsl:when test="$_error_JMS-Topic-Publisher/ActivityErrors/ns3:JMSInvalidInputException or $_error_JMS-Queue-Sender/ActivityErrors/ns3:JMSInvalidInputException">
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/AdvancedArchitecture/Routing/GLB_SMessageQueTopic_InvalidInput"/>
                                </ErrorCode>
                            </xsl:when>
                            <xsl:when test="$_error_JMS-Queue-Sender/ActivityErrors/ns3:JMSMessageCreateException or $_error_JMS-Topic-Publisher/ActivityErrors/ns3:JMSMessageCreateException">
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/AdvancedArchitecture/Routing/GLB_SMessageQueTopic_MessageCreate"/>
                                </ErrorCode>
                            </xsl:when>
                            <xsl:when test="$_error_JMS-Topic-Publisher/ActivityErrors/ns3:JMSSessionCreateException or $_error_JMS-Queue-Sender/ActivityErrors/ns3:JMSSessionCreateException">
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/AdvancedArchitecture/Routing/GLB_SMessageQueTopic_SessionCreate"/>
                                </ErrorCode>
                            </xsl:when>
                            <xsl:when test="$_error_JMS-Queue-Sender/ActivityErrors/ns3:JMSSendException or $_error_JMS-Topic-Publisher/ActivityErrors/ns3:JMSSendException">
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/AdvancedArchitecture/Routing/GLB_SMessageQueTopic_Send"/>
                                </ErrorCode>
                            </xsl:when>
                            <xsl:otherwise>
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                </ErrorCode>
                            </xsl:otherwise>
                        </xsl:choose>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_ARC_GenericError"/>
                        </ErrorDescription>
                        <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                            <NativeErrorCode>
                                <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                            </NativeErrorCode>
                        </xsl:if>
                        <NativeErrorDescription>
                            <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                        </NativeErrorDescription>
                        <StackTrace>
                            <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                        </StackTrace>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <StackProcess>
                            <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                        </StackProcess>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Technical"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/IN_SendMessageToQueueOrTopic)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx2:ErrorMessage>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
