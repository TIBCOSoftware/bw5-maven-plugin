<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_MetaInfo/API/ARC_PutIdServiceMetaData.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Name" type="xsd:string"/>
                    <xsd:element name="Value" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>148</pd:startX>
    <pd:startY>69</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$UpdateMetaData/ServiceMetaData"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="ServiceMetaData">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Data" maxOccurs="unbounded">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="Name" type="xsd:string"/>
                                <xsd:element name="Value" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>729</pd:endX>
    <pd:endY>72</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1334302660977</pd:targetNamespace>
    <pd:activity name="GetMetaData">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>275</pd:x>
        <pd:y>69</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceMetaData.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="SetMetaData">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>551</pd:x>
        <pd:y>73</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceMetaData.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <xsl:copy-of select="$UpdateMetaData/ServiceMetaData"/>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="UpdateMetaData">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>404</pd:x>
        <pd:y>72</pd:y>
        <config>
            <element>
                <xsd:element name="ServiceMetaData">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="Data" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Name" type="xsd:string"/>
                                        <xsd:element name="Value" type="xsd:string"/>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <ServiceMetaData>
                <xsl:choose>
                    <xsl:when test="count($GetMetaData/ServiceMetaData/Data[ Name = $Start/Data/Name ])>0">
                        <xsl:for-each select="$GetMetaData/ServiceMetaData/Data">
                            <xsl:choose>
                                <xsl:when test="$GetMetaData/ServiceMetaData/Data[ Name = $Start/Data/Name]">
                                    <Data>
                                        <Name>
                                            <xsl:value-of select="$Start/Data/Name"/>
                                        </Name>
                                        <Value>
                                            <xsl:value-of select="$Start/Data/Value"/>
                                        </Value>
                                    </Data>
                                </xsl:when>
                                <xsl:otherwise>
                                    <Data>
                                        <Name>
                                            <xsl:value-of select="Name"/>
                                        </Name>
                                        <Value>
                                            <xsl:value-of select="Value"/>
                                        </Value>
                                    </Data>
                                </xsl:otherwise>
                            </xsl:choose>
                        </xsl:for-each>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:copy-of select="$GetMetaData/ServiceMetaData/Data"/>
                        <Data>
                            <Name>
                                <xsl:value-of select="$Start/Data/Name"/>
                            </Name>
                            <Value>
                                <xsl:value-of select="$Start/Data/Value"/>
                            </Value>
                        </Data>
                    </xsl:otherwise>
                </xsl:choose>
            </ServiceMetaData>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetMetaData</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetMetaData</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetMetaData</pd:from>
        <pd:to>UpdateMetaData</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>UpdateMetaData</pd:from>
        <pd:to>SetMetaData</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>