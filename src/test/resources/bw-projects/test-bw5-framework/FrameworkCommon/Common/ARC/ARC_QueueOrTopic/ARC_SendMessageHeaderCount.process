    </pd:transition>
    <pd:transition>
        <pd:from>JMS</pd:from>
        <pd:to>ARC_FindQueue</pd:to>
        <pd:xpathDescription>ServiceId</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
