    <pd:activity name="Generate ErrorMessage">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>448</pd:x>
        <pd:y>672</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx4:ActivityInput>
                <data>
                    <group>
                        <xsl:choose>
                            <xsl:when test="string-length($Catch-Error-message/ns12:ErrorMessage/ErrorCode)>0">
                                <ns12:ErrorMessage>
                                    <ErrorCode>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorCode"/>
                                    </ErrorCode>
                                    <xsl:if test="$Catch-Error-message/ns12:ErrorMessage/ErrorDescription">
                                        <ErrorDescription>
                                            <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorDescription"/>
                                        </ErrorDescription>
                                    </xsl:if>
                                    <NativeErrorCode>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/NativeErrorCode"/>
                                    </NativeErrorCode>
                                    <NativeErrorDescription>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/NativeErrorDescription"/>
                                    </NativeErrorDescription>
                                    <StackTrace>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/StackTrace"/>
                                    </StackTrace>
                                    <ErrorDate>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ErrorDate"/>
                                    </ErrorDate>
                                    <StackProcess>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/StackProcess"/>
                                    </StackProcess>
                                    <Severity>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                    </Severity>
                                    <OriginalMessage>
                                        <xsl:value-of select="tib:render-xml($Start/ARC_REQS_Main_IN)"/>
                                    </OriginalMessage>
                                    <Category>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/Category"/>
                                    </Category>
                                    <ProcessInputMessage>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/ProcessInputMessage"/>
                                    </ProcessInputMessage>
                                    <IsResponse>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/IsResponse"/>
                                    </IsResponse>
                                    <MessageType>
                                        <xsl:value-of select="$Catch-Error-message/ns12:ErrorMessage/MessageType"/>
                                    </MessageType>
                                    <PreviousErrorMessage>
                                        <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/ancestor-or-self::*/namespace::node()"/>
                                        <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/@*"/>
                                        <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/node()"/>
                                    </PreviousErrorMessage>
                                    <xsl:copy-of select="$Catch-Error-message/ns12:ErrorMessage/FunctionalErrorData"/>
                                </ns12:ErrorMessage>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns12:ErrorMessage>
                                    <ErrorCode>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                    </ErrorCode>
                                    <ErrorDescription>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                    </ErrorDescription>
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                    </NativeErrorCode>
                                    <NativeErrorDescription>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                    </NativeErrorDescription>
                                    <StackTrace>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                    </StackTrace>
                                    <ErrorDate>
                                        <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                    </ErrorDate>
                                    <StackProcess>
                                        <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                    </StackProcess>
                                    <Severity>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                    </Severity>
                                    <OriginalMessage>
                                        <xsl:value-of select="tib:render-xml($Start/ARC_REQS_Main_IN)"/>
                                    </OriginalMessage>
                                    <Category>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                    </Category>
                                    <ProcessInputMessage>
                                        <xsl:value-of select="tib:render-xml($Start/ARC_REQS_Main_IN)"/>
                                    </ProcessInputMessage>
                                    <IsResponse>
                                        <xsl:value-of select="0"/>
                                    </IsResponse>
                                    <MessageType>
                                        <xsl:value-of select="$_globalVariables/ns6:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                    </MessageType>
                                </ns12:ErrorMessage>
                            </xsl:otherwise>
                        </xsl:choose>
                        <Body>
                            <xsl:copy-of select="$Start/ARC_REQS_Main_IN/Body/*"/>
                        </Body>
                    </group>
                </data>
            </pfx4:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
