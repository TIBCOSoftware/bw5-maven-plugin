    <pd:activity name="Set Framework Context">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>226</pd:x>
        <pd:y>421</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <FrameworkData>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_REQS_Main_IN/UpdateHeaderParameters/ControlE2E=&quot;false&quot;">
                        <xsl:if test="$Get-Framework-Context/FrameworkData/InvocationsNumber">
                            <InvocationsNumber>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/InvocationsNumber"/>
                            </InvocationsNumber>
                        </xsl:if>
                    </xsl:when>
                    <xsl:when test="$Start/ARC_REQS_Main_IN/Sync=&quot;true&quot;">
                        <xsl:if test="$Get-Framework-Context/FrameworkData/InvocationsNumber">
                            <InvocationsNumber>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/InvocationsNumber"/>
                            </InvocationsNumber>
                        </xsl:if>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$Get-Framework-Context/FrameworkData/InvocationsNumber">
                            <InvocationsNumber>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/InvocationsNumber+1"/>
                            </InvocationsNumber>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
                <ns12:ArchitectureHeader>
                    <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader"/>
                    <xsl:if test="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader">
                        <xsl:choose>
                            <xsl:when test="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader">
                                <ns12:ECSHeader>
                                    <ns12:traceId>
                                        <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId"/>
                                    </ns12:traceId>
                                    <xsl:if test="string-length($Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:parentSpan)>0">
                                        <xsl:if test="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:parentSpan">
                                            <ns12:parentSpan>
                                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:parentSpan"/>
                                            </ns12:parentSpan>
                                        </xsl:if>
                                    </xsl:if>
                                    <ns12:spanId>
                                        <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:spanId"/>
                                    </ns12:spanId>
                                    <xsl:if test="count($Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property)>0&#xA;or&#xA;count($ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property)>0">
                                        <ns12:properties>
                                            <xsl:for-each-group select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property" group-by="ns12:key">
                                                <xsl:copy-of select="."/>
                                            </xsl:for-each-group>
                                            <xsl:if test="count($ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property)>0">
                                                <xsl:for-each-group select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property" group-by="ns12:key">
                                                    <xsl:if test="count($Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties/ns12:property[ns12:key=current-group()/ns12:key])=0">
                                                        <xsl:copy-of select="."/>
                                                    </xsl:if>
                                                </xsl:for-each-group>
                                            </xsl:if>
                                        </ns12:properties>
                                    </xsl:if>
                                </ns12:ECSHeader>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader"/>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:if>
                    <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:RequestHeader"/>
                    <xsl:choose>
                        <xsl:when test="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ErrorHeader">
                            <xsl:copy-of select="$ARC_RequestMessage2QueueOrTopic/ns12:Message/ns12:ArchitectureHeader/ns12:ErrorHeader"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ErrorHeader"/>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:ReprocessingHeader"/>
                    <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                    <ns12:RoutingHeader>
                        <ns12:Origin>
                            <ns12:Services>
                                <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:RoutingHeader/ns12:Origin/ns12:Services/ns12:Service"/>
                                <ns12:Service>
                                    <ns12:ServiceId>
                                        <xsl:value-of select="$Start/ARC_REQS_Main_IN/Service/ServiceId"/>
                                    </ns12:ServiceId>
                                    <xsl:if test="$Start/ARC_REQS_Main_IN/Service/JMSDestination">
                                        <ns12:JMSInputDestinationName>
                                            <xsl:value-of select="$Start/ARC_REQS_Main_IN/Service/JMSDestination"/>
                                        </ns12:JMSInputDestinationName>
                                    </xsl:if>
                                    <ns12:ServiceType>
                                        <xsl:value-of select="$Start/ARC_REQS_Main_IN/Service/ServiceType"/>
                                    </ns12:ServiceType>
                                </ns12:Service>
                            </ns12:Services>
                        </ns12:Origin>
                    </ns12:RoutingHeader>
                    <xsl:copy-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                </ns12:ArchitectureHeader>
                <xsl:if test="string-length($Get-Framework-Context/FrameworkData/SaveMessage)>0">
                    <xsl:if test="$Get-Framework-Context/FrameworkData/SaveMessage">
                        <SaveMessage>
                            <xsl:value-of select="$Get-Framework-Context/FrameworkData/SaveMessage"/>
                        </SaveMessage>
                    </xsl:if>
                </xsl:if>
            </FrameworkData>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_SendMessage2QueueOrTopic">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>736</pd:x>
        <pd:y>411</pd:y>
        <config>
            <processName>/Common/ARC/ARC_QueueOrTopic/ARC_SendCDMReplyTo2QueueOrTopic.process</processName>
            <processNameXPath>concat($_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_mockRoot, "/Common/ARC/ARC_QueueOrTopic/ARC_SendCDMReplyTo2QueueOrTopic.process")</processNameXPath>
        </config>
        <pd:inputBindings>
            <IN_SendReply2QueueOrTopic>
                <xsl:choose>
                    <xsl:when test="$ARC_FindQueue">
                        <TargetName>
                            <xsl:value-of select="$ARC_FindQueue/ns12:Destination"/>
                        </TargetName>
                    </xsl:when>
                    <xsl:otherwise>
                        <TargetName>
                            <xsl:value-of select="$Start/ARC_REQS_Main_IN/Service/JMSDestination"/>
                        </TargetName>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:choose>
                    <xsl:when test="$ARC_FindQueue">
                        <xsl:choose>
                            <xsl:when test="$ARC_FindQueue/ns12:Destination/@DestinationType='Topic'">
                                <IsTopic>
                                    <xsl:value-of select="1"/>
                                </IsTopic>
                            </xsl:when>
                            <xsl:otherwise>
                                <IsTopic>
                                    <xsl:value-of select="0"/>
                                </IsTopic>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:when>
                    <xsl:otherwise>
                        <IsTopic>
                            <xsl:value-of select="0"/>
                        </IsTopic>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:if test="$Start/ARC_REQS_Main_IN/JMSCorrelationId">
                    <CorrelationId>
                        <xsl:value-of select="$Start/ARC_REQS_Main_IN/JMSCorrelationId"/>
                    </CorrelationId>
                </xsl:if>
                <xsl:if test="string-length($Start/ARC_REQS_Main_IN/JMsReplyTo) > 0">
                    <xsl:if test="$Start/ARC_REQS_Main_IN/JMsReplyTo">
                        <ReplyTo>
                            <xsl:value-of select="$Start/ARC_REQS_Main_IN/JMsReplyTo"/>
                        </ReplyTo>
                    </xsl:if>
                </xsl:if>
                <ns12:Message>
                    <ns12:ArchitectureHeader>
                        <ns12:AuditHeader>
                            <ns12:E2EId>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EId"/>
                            </ns12:E2EId>
                            <xsl:if test="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId">
                                <ns12:ParentInstanceId>
                                    <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId"/>
                                </ns12:ParentInstanceId>
                            </xsl:if>
                            <ns12:InstanceId>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId"/>
                            </ns12:InstanceId>
                            <ns12:Deepness>
                                <xsl:value-of select="$Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:Deepness"/>
                            </ns12:Deepness>
                            <ns12:ServiceId>
