    </pd:transition>
    <pd:transition>
        <pd:from>TipoPublicacion</pd:from>
        <pd:to>ARC_RequestMessage2QueueOrTopic</pd:to>
        <pd:xpathDescription>sync</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$Start/ARC_REQS_Main_IN/Sync="true"</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>TipoPublicacion</pd:from>
        <pd:to>ARC_SendMessage2QueueOrTopic</pd:to>
        <pd:xpathDescription>async</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>JMS</pd:from>
        <pd:to>TipoPublicacion</pd:to>
        <pd:xpathDescription>JMSQueue</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($Start/ARC_REQS_Main_IN/Service/JMSDestination)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FindQueue</pd:from>
        <pd:to>TipoPublicacion</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
