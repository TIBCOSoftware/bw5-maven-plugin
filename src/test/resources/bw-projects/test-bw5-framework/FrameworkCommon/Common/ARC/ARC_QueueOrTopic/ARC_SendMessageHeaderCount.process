                                </ns12:Origin>
                                <xsl:if test="count($Get-Framework-Context/FrameworkData/ns12:ArchitectureHeader/ns12:RoutingHeader/ns12:Target/ns12:Services/ns12:Service ) >0 and $Start/ARC_REQS_Main_IN/Service/ServiceType=$_globalVariables/ns6:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_RoutingGatewayAdapter">
                                    <ns12:Target>
                                        <ns12:Services>
