                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="XSLFolderRoute" type="xsd:string"/>
                    <xsd:element name="ServiceId" type="pfx2:ServiceIdType"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>75</pd:startX>
    <pd:startY>241</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$Parse-XML/TargetServices"/>
