                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Error_because_the_routing_XML"/>
                        </ErrorDescription>
                        <xsl:choose>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException">
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException/msgCode">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException/msgCode"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:when>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException">
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException/msgCode">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException/msgCode"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:when>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:MissingByteCountException">
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:MissingByteCountException/msgCode">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:MissingByteCountException/msgCode"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:ValidationException/msgCode">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:ValidationException/msgCode"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException">
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException/msg">
                                    <NativeErrorDescription>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:XMLParseException/msg"/>
                                    </NativeErrorDescription>
                                </xsl:if>
                            </xsl:when>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException">
                                <xsl:if test="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException/msg">
                                    <NativeErrorDescription>
                                        <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:UnsupportedEncodingException/msg"/>
                                    </NativeErrorDescription>
                                </xsl:if>
                            </xsl:when>
                            <xsl:when test="$_error_Parse-XML/ActivityErrors/ns5:MissingByteCountException">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:MissingByteCountException/msg"/>
                                </NativeErrorDescription>
                            </xsl:when>
                            <xsl:otherwise>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error_Parse-XML/ActivityErrors/ns5:ValidationException/msg"/>
                                </NativeErrorDescription>
                            </xsl:otherwise>
                        </xsl:choose>
                        <StackTrace>
                            <xsl:value-of select="$_error/ns4:ErrorReport/StackTrace"/>
                        </StackTrace>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <StackProcess>
                            <xsl:value-of select="$_error/ns4:ErrorReport/ProcessStack"/>
                        </StackProcess>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Categories/GLB_TX"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/IN_ARC_RoutingUsingXSLT)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx2:ErrorMessage>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
