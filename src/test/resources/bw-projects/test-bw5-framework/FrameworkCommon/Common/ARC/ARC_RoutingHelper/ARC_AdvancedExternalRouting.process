    <pd:group name="Group asyn sender">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>247</pd:x>
        <pd:y>485</pd:y>
        <pd:width>302</pd:width>
        <pd:height>264</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>errorLoop</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:indexSlot>h</pd:indexSlot>
            <pd:errorCondition>$h&gt;= $_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/Num_Intentos_Conexion</pd:errorCondition>
            <pd:suspendAfterErrorRetry>false</pd:suspendAfterErrorRetry>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Null-1-1</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>JMS Queue Sender</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Null-1-1</pd:from>
            <pd:to>Sleep-async</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>$h &gt; 1</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>Sleep-async</pd:from>
            <pd:to>JMS Queue Sender</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Null-1-1</pd:from>
            <pd:to>JMS Queue Sender</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Sleep-async">
            <pd:type>com.tibco.plugin.timer.SleepActivity</pd:type>
            <pd:resourceType>ae.activities.sleep</pd:resourceType>
            <pd:x>428</pd:x>
            <pd:y>685</pd:y>
            <config/>
            <pd:inputBindings>
                <ns0:SleepInputSchema>
                    <xsl:choose xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
                        <xsl:when test="$h = 2">
                            <IntervalInMillisec>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/Intervalo_Primera_Reconexion"/>
                            </IntervalInMillisec>
                        </xsl:when>
                        <xsl:otherwise>
                            <IntervalInMillisec>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/Intervalo_Resto_Reconexiones"/>
                            </IntervalInMillisec>
                        </xsl:otherwise>
                    </xsl:choose>
                </ns0:SleepInputSchema>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Null-1-1">
            <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
            <pd:resourceType>ae.activities.null</pd:resourceType>
            <pd:x>319</pd:x>
            <pd:y>624</pd:y>
            <config/>
            <pd:inputBindings/>
        </pd:activity>
        <pd:activity name="JMS Queue Sender">
            <pd:type>com.tibco.plugin.jms.JMSQueueSendActivity</pd:type>
            <pd:resourceType>ae.activities.JMSQueueSendActivity</pd:resourceType>
            <pd:x>431</pd:x>
            <pd:y>557</pd:y>
            <config>
                <PermittedMessageType>XML Text</PermittedMessageType>
                <SessionAttributes>
                    <transacted>false</transacted>
                    <acknowledgeMode>1</acknowledgeMode>
                    <maxSessions>1</maxSessions>
                </SessionAttributes>
                <ConfigurableHeaders>
                    <JMSDeliveryMode>PERSISTENT</JMSDeliveryMode>
                    <JMSExpiration>0</JMSExpiration>
                    <JMSPriority>4</JMSPriority>
                </ConfigurableHeaders>
                <ConnectionReference>/SharedResources/Connections/JMSConnections/Business/BusinessConnection.sharedjmscon</ConnectionReference>
                <InDataxsdString ref="pfx2:RoutingMessage"/>
            </config>
            <pd:inputBindings>
                <ns:ActivityInput>
                    <xsl:choose>
                        <xsl:when test="exists($Start/IN_AdvancedExternalRouting/pfx2:ExportAdapterParameters/AdvancedRoutingParams/Target)">
                            <destinationQueue>
                                <xsl:value-of select="concat ($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/FrameworkQueues/Prefix/GLB_AdvRoutingPrefixDomain , concat( &quot;.&quot; ,concat($_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ENVIRONMENT/CFG_ENVIRONMENT_PREFIX ,concat( &quot;.&quot;,$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ROUTING/AdvRoutingConnectorInputQueue))))"/>
                            </destinationQueue>
                        </xsl:when>
                        <xsl:otherwise>
                            <destinationQueue>
                                <xsl:value-of select="concat ($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/FrameworkQueues/Prefix/GLB_AdvRoutingPrefixDomain , concat( &quot;.&quot; ,concat($_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ENVIRONMENT/CFG_ENVIRONMENT_PREFIX ,concat( &quot;.&quot;,$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ROUTING/AdvRoutingConnectorInputQueue))))"/>
                            </destinationQueue>
                        </xsl:otherwise>
                    </xsl:choose>
                    <JMSExpiration>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_Timeout"/>
                    </JMSExpiration>
                    <Body>
                        <xsl:copy-of select="$Start/IN_AdvancedExternalRouting/pfx2:RoutingMessage"/>
                    </Body>
                    <xsl:variable name="varCompressEnabled" select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/SERVICES/COMPRESSION/CFG_COMPRESS_ENABLED"/>
                    <DynamicProperties>
                        <xsl:if test="$varCompressEnabled='true'">
                            <property>
                                <name>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/SERVICES/COMPRESSION/CFG_PROPERTY_NAME"/>
                                </name>
                                <value>
                                    <xsl:value-of select="'true'"/>
                                </value>
                                <type>
                                    <xsl:value-of select="'boolean'"/>
                                </type>
                            </property>
                        </xsl:if>
                    </DynamicProperties>
                </ns:ActivityInput>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:transition>
        <pd:from>Group sync sender</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>One Bend</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group sync sender</pd:from>
        <pd:to>Error in ARC_AdvancedExternalRouting</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-65485</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Error-in-ARC_AdvancedExternalRouting-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group asyn sender</pd:from>
        <pd:to>Error in ARC_AdvancedExternalRouting</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-65536</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group asyn sender</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>One Bend</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Group sync sender</pd:to>
        <pd:xpathDescription>sync</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/ROUTING/isActiveSync="true"</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Group asyn sender</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>