    <pd:activity name="Put in Coherence Cache">
        <pd:type>com.tibco.plugin.java.JavaActivity</pd:type>
        <pd:resourceType>ae.javapalette.javaActivity</pd:resourceType>
        <pd:x>294</pd:x>
        <pd:y>69</pd:y>
        <config>
            <fileName>ARC_Put_In_CachePutinCoherenceCache</fileName>
            <packageName>Common.ARC.ARC_Cache.ARC_Put_In_Cache</packageName>
            <fullsource>package Common.ARC.ARC_Cache.ARC_Put_In_Cache;
import java.util.*;
import java.io.*;
import com.tangosol.net.NamedCache;
import com.tangosol.net.CacheFactory;


public class ARC_Put_In_CachePutinCoherenceCache{
/****** START SET/GET METHOD, DO NOT MODIFY *****/
	protected String CacheName = "";
	protected String Key = "";
	protected String Value = "";
	protected long Expiration = 0;
	public String getCacheName() {
		return CacheName;
	}
	public void setCacheName(String val) {
		CacheName = val;
	}
	public String getKey() {
		return Key;
	}
	public void setKey(String val) {
		Key = val;
	}
	public String getValue() {
		return Value;
	}
	public void setValue(String val) {
		Value = val;
	}
	public long getExpiration() {
		return Expiration;
	}
	public void setExpiration(long val) {
		Expiration = val;
	}
/****** END SET/GET METHOD, DO NOT MODIFY *****/
	public ARC_Put_In_CachePutinCoherenceCache() {
	}
	public void invoke() throws Exception {
/* Available Variables: DO NOT MODIFY
	In  : String CacheName
	In  : String Key
	In  : String Value
	In  : long Expiration
* Available Variables: DO NOT MODIFY *****/

	NamedCache cache=CacheFactory.getCache(CacheName);
	cache.put(Key, Value,Expiration*1000);


}
}
</fullsource>
            <inputData>
                <row>
