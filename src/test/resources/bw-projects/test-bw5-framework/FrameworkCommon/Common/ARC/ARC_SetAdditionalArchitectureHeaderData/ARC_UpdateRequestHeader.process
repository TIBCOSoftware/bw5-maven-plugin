<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns="http://www.bbva.com/EAIFramework" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_SetAdditionalArchitectureHeaderData/ARC_UpdateRequestHeader.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Data">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="BBVAUser" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ExternalId" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="BatchId" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="BusinessObject" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="StartTimestamp" type="xsd:dateTime" minOccurs="0"/>
                    <xsd:element name="ServiceIdStarter" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>150</pd:startX>
    <pd:startY>65</pd:startY>
    <pd:returnBindings>
        <Output>
            <xsl:if test="$GetVariable/FrameworkData/InvocationsNumber">
                <InvocationsNumber>
                    <xsl:value-of select="$GetVariable/FrameworkData/InvocationsNumber"/>
                </InvocationsNumber>
            </xsl:if>
            <ns:ArchitectureHeader>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:AuditHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ECSHeader"/>
                <ns:RequestHeader>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/BBVAUser)>0">
                            <ns:BBVAUser>
                                <xsl:value-of select="$Start/Data/BBVAUser"/>
                            </ns:BBVAUser>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns:BBVAUser>
                                <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BBVAUser"/>
                            </ns:BBVAUser>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/ExternalId)>0">
                            <ns:ExternalId>
                                <xsl:value-of select="$Start/Data/ExternalId"/>
                            </ns:ExternalId>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ExternalId">
                                <ns:ExternalId>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ExternalId"/>
                                </ns:ExternalId>
                            </xsl:if>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/BatchId)>0">
                            <ns:BatchId>
                                <xsl:value-of select="$Start/Data/BatchId"/>
                            </ns:BatchId>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BatchId">
                                <ns:BatchId>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BatchId"/>
                                </ns:BatchId>
                            </xsl:if>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/BusinessObject)>0">
                            <ns:BusinessObject>
                                <xsl:value-of select="$Start/Data/BusinessObject"/>
                            </ns:BusinessObject>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BusinessObject">
                                <ns:BusinessObject>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BusinessObject"/>
                                </ns:BusinessObject>
                            </xsl:if>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/StartTimestamp)">
                            <ns:StartTimestamp>
                                <xsl:value-of select="$Start/Data/StartTimestamp"/>
                            </ns:StartTimestamp>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns:StartTimestamp>
                                <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:StartTimestamp"/>
                            </ns:StartTimestamp>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="string-length($Start/Data/ServiceIdStarter)>0">
                            <ns:ServiceIdStarter>
                                <xsl:value-of select="$Start/Data/ServiceIdStarter"/>
                            </ns:ServiceIdStarter>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns:ServiceIdStarter>
                                <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ServiceIdStarter"/>
                            </ns:ServiceIdStarter>
                        </xsl:otherwise>
                    </xsl:choose>
                </ns:RequestHeader>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ErrorHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ReprocessingHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RoutingHeader"/>
                <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:FunctionalData"/>
            </ns:ArchitectureHeader>
            <xsl:if test="$GetVariable/FrameworkData/SaveMessage">
                <SaveMessage>
                    <xsl:value-of select="$GetVariable/FrameworkData/SaveMessage"/>
                </SaveMessage>
            </xsl:if>
        </Output>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="Output">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="InvocationsNumber" type="xsd:string" minOccurs="0"/>
                    <xsd:element ref="ns:ArchitectureHeader"/>
                    <xsd:element name="SaveMessage" type="xsd:boolean" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>586</pd:endX>
    <pd:endY>65</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1334302660977</pd:targetNamespace>
    <pd:activity name="GetVariable">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>281</pd:x>
        <pd:y>64</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="SetVariable">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>422</pd:x>
        <pd:y>65</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <FrameworkData>
                <xsl:if test="$GetVariable/FrameworkData/InvocationsNumber">
                    <InvocationsNumber>
                        <xsl:value-of select="$GetVariable/FrameworkData/InvocationsNumber"/>
                    </InvocationsNumber>
                </xsl:if>
                <ns:ArchitectureHeader>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:AuditHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ECSHeader"/>
                    <ns:RequestHeader>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/BBVAUser)>0">
                                <ns:BBVAUser>
                                    <xsl:value-of select="$Start/Data/BBVAUser"/>
                                </ns:BBVAUser>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns:BBVAUser>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BBVAUser"/>
                                </ns:BBVAUser>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/ExternalId)>0">
                                <ns:ExternalId>
                                    <xsl:value-of select="$Start/Data/ExternalId"/>
                                </ns:ExternalId>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ExternalId">
                                    <ns:ExternalId>
                                        <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ExternalId"/>
                                    </ns:ExternalId>
                                </xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/BatchId)>0">
                                <ns:BatchId>
                                    <xsl:value-of select="$Start/Data/BatchId"/>
                                </ns:BatchId>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BatchId">
                                    <ns:BatchId>
                                        <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BatchId"/>
                                    </ns:BatchId>
                                </xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/BusinessObject)>0">
                                <ns:BusinessObject>
                                    <xsl:value-of select="$Start/Data/BusinessObject"/>
                                </ns:BusinessObject>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:if test="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BusinessObject">
                                    <ns:BusinessObject>
                                        <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:BusinessObject"/>
                                    </ns:BusinessObject>
                                </xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/StartTimestamp)">
                                <ns:StartTimestamp>
                                    <xsl:value-of select="$Start/Data/StartTimestamp"/>
                                </ns:StartTimestamp>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns:StartTimestamp>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:StartTimestamp"/>
                                </ns:StartTimestamp>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Start/Data/ServiceIdStarter)>0">
                                <ns:ServiceIdStarter>
                                    <xsl:value-of select="$Start/Data/ServiceIdStarter"/>
                                </ns:ServiceIdStarter>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns:ServiceIdStarter>
                                    <xsl:value-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RequestHeader/ns:ServiceIdStarter"/>
                                </ns:ServiceIdStarter>
                            </xsl:otherwise>
                        </xsl:choose>
                    </ns:RequestHeader>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ErrorHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:ReprocessingHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:SecurityHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:RoutingHeader"/>
                    <xsl:copy-of select="$GetVariable/FrameworkData/ns:ArchitectureHeader/ns:FunctionalData"/>
                </ns:ArchitectureHeader>
                <xsl:if test="$GetVariable/FrameworkData/SaveMessage">
                    <SaveMessage>
                        <xsl:value-of select="$GetVariable/FrameworkData/SaveMessage"/>
                    </SaveMessage>
                </xsl:if>
            </FrameworkData>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetECSConfig">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>426</pd:x>
        <pd:y>173</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="SetECSConfig">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>588</pd:x>
        <pd:y>172</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <group>
                <xsl:for-each select="$GetECSConfig/group/ns:ECSConfig">
                    <ns:ECSConfig>
                        <ns:namespace>
                            <xsl:value-of select="ns:namespace"/>
                        </ns:namespace>
                        <ns:mrId>
                            <xsl:value-of select="ns:mrId"/>
                        </ns:mrId>
                        <ns:genMetrics>
                            <xsl:value-of select="ns:genMetrics"/>
                        </ns:genMetrics>
                        <xsl:for-each select="ns:properties">
                            <ns:properties>
                                <xsl:for-each-group select="ns:property" group-by="ns:key">
                                    <xsl:if test="count(.[current-group()/ns:key=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/EntitytKey])=0">
                                        <xsl:copy-of select="."/>
                                    </xsl:if>
                                </xsl:for-each-group>
                                <ns:property>
                                    <ns:key>
                                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/EntitytKey"/>
                                    </ns:key>
                                    <ns:value>
                                        <xsl:value-of select="$Start/Data/BusinessObject"/>
                                    </ns:value>
                                    <ns:spreadE2E>
                                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/BooleanConstants/False"/>
                                    </ns:spreadE2E>
                                </ns:property>
                            </ns:properties>
                        </xsl:for-each>
                    </ns:ECSConfig>
                </xsl:for-each>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetVariable</pd:from>
        <pd:to>SetVariable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetVariable</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:xpathDescription>Update BusinessObject</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>string-length($Start/Data/BusinessObject)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>SetECSConfig</pd:to>
        <pd:xpathDescription>Update Data</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>string-length($GetECSConfig/group/ns:ECSConfig/ns:namespace)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>SetECSConfig</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetVariable</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>