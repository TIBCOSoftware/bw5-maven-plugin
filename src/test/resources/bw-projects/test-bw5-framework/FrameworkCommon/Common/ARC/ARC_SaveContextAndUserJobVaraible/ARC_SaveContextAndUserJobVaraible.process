<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx2="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:ns13="http://www.bbva.com/EAIFramework" xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd">
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="SaveContexts">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="ns13:ArchitectureHeader"/>
                    <xsd:element name="InvocationsNumber" type="xsd:int" minOccurs="0"/>
                    <xsd:element name="SaveMessage" type="xsd:boolean" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>71</pd:startX>
    <pd:startY>79</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$Start/SaveContexts/ns13:ArchitectureHeader"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType ref="ns13:ArchitectureHeader"/>
    <pd:endX>727</pd:endX>
    <pd:endY>77</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns13:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1328783387438</pd:targetNamespace>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>340</pd:x>
        <pd:y>203</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate Message Error">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>510</pd:x>
        <pd:y>210</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <ns13:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <StackProcess>
                            <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                        </StackProcess>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/SaveContexts)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </ns13:ErrorMessage>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Set User Job Shared Variable">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>550</pd:x>
        <pd:y>84</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Read-Only-ArchitectureHeader.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <xsl:copy-of select="$Start/SaveContexts/ns13:ArchitectureHeader"/>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Set Framework Context">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>372</pd:x>
        <pd:y>86</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <FrameworkData>
                <xsl:if test="string-length(string($Start/SaveContexts/InvocationsNumber))>0">
                    <xsl:if test="$Start/SaveContexts/InvocationsNumber">
                        <InvocationsNumber>
                            <xsl:value-of select="$Start/SaveContexts/InvocationsNumber"/>
                        </InvocationsNumber>
                    </xsl:if>
                </xsl:if>
                <xsl:copy-of select="$Start/SaveContexts/ns13:ArchitectureHeader"/>
                <xsl:if test="string-length(string($Start/SaveContexts/SaveMessage))>0">
                    <xsl:if test="$Start/SaveContexts/SaveMessage">
                        <SaveMessage>
                            <xsl:value-of select="$Start/SaveContexts/SaveMessage"/>
                        </SaveMessage>
                    </xsl:if>
                </xsl:if>
            </FrameworkData>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetECSConfig">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>218</pd:x>
        <pd:y>79</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate Message Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Set Framework Context</pd:from>
        <pd:to>Set User Job Shared Variable</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Set User Job Shared Variable</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>Set Framework Context</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>