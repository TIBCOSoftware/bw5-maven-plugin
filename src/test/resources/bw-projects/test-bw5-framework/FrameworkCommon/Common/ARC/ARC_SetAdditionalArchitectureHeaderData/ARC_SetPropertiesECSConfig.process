<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_SetAdditionalArchitectureHeaderData/ARC_SetPropertiesECSConfig.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>109</pd:startX>
    <pd:startY>64</pd:startY>
    <pd:returnBindings>
        <group>
            <xsl:copy-of select="$SetECSConfig/group/pfx:ECSConfig"/>
        </group>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>529</pd:endX>
    <pd:endY>64</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1591772871300</pd:targetNamespace>
    <pd:activity name="SetECSConfig">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>392</pd:x>
        <pd:y>63</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
            <showResult>true</showResult>
        </config>
        <pd:inputBindings>
            <group>
                <pfx:ECSConfig>
                    <pfx:namespace>
                        <xsl:value-of select="$Start/group/pfx:ECSConfig/pfx:namespace"/>
                    </pfx:namespace>
                    <pfx:mrId>
                        <xsl:value-of select="$Start/group/pfx:ECSConfig/pfx:mrId"/>
                    </pfx:mrId>
                    <pfx:genMetrics>
                        <xsl:value-of select="$Start/group/pfx:ECSConfig/pfx:genMetrics"/>
                    </pfx:genMetrics>
                    <pfx:properties>
                        <xsl:for-each-group select="$Start/group/pfx:ECSConfig/pfx:properties/pfx:property" group-by="pfx:key">
                            <xsl:copy-of select="."/>
                        </xsl:for-each-group>
                        <xsl:for-each-group select="$GetECSConfig/group/pfx:ECSConfig/pfx:properties/pfx:property" group-by="pfx:key">
                            <xsl:if test="count($Start/group/pfx:ECSConfig/pfx:properties/pfx:property[pfx:key=current-group()/pfx:key])=0">
                                <pfx:property>
                                    <pfx:key>
                                        <xsl:value-of select="pfx:key"/>
                                    </pfx:key>
                                    <xsl:choose>
                                        <xsl:when test="pfx:boolean_value">
                                            <pfx:boolean_value>
                                                <xsl:value-of select="pfx:boolean_value"/>
                                            </pfx:boolean_value>
                                        </xsl:when>
                                        <xsl:when test="pfx:number_value">
                                            <pfx:number_value>
                                                <xsl:value-of select="pfx:number_value"/>
                                            </pfx:number_value>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <pfx:value>
                                                <xsl:value-of select="pfx:value"/>
                                            </pfx:value>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                    <pfx:spreadE2E>
                                        <xsl:value-of select="pfx:spreadE2E"/>
                                    </pfx:spreadE2E>
                                </pfx:property>
                            </xsl:if>
                        </xsl:for-each-group>
                    </pfx:properties>
                </pfx:ECSConfig>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetECSConfig">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>233</pd:x>
        <pd:y>65</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetECSConfig</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>SetECSConfig</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>