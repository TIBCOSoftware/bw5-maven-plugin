    <pd:activity name="Error in ARC_RequestMessage2QueueOrTopic">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>757</pd:x>
        <pd:y>354</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx:ActivityInput>
                <data>
                    <xsl:choose xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
                        <xsl:when test="$_error_JMS-Topic-Requestor/ActivityErrors/ns3:ActivityTimedOutException or $_error_JMS-Queue-Requestor/ActivityErrors/ns3:ActivityTimedOutException">
                            <pfx2:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_Timeout"/>
                                </ErrorCode>
                                <ErrorDescription>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_ARC_RequestMessage2QueueOrTopicTimeout"/>
                                </ErrorDescription>
                                <xsl:if test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                                    <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                                        <NativeErrorCode>
                                            <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                        </NativeErrorCode>
                                    </xsl:if>
                                </xsl:if>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_Warning"/>
                                </Severity>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Technical"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="tib:render-xml($Start/IN_SendMessage2QueueOrTopic)"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </pfx2:ErrorMessage>
                        </xsl:when>
                        <xsl:otherwise>
                            <pfx2:ErrorMessage>
                                <xsl:choose>
                                    <xsl:when test="$_error_JMS-Topic-Requestor/ActivityErrors/ns4:JMSInvalidInputException or $_error_JMS-Queue-Requestor/ActivityErrors/ns4:JMSInvalidInputException">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_InvalidInput"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="$_error_JMS-Queue-Requestor/ActivityErrors/ns4:JMSMessageCreateException or $_error_JMS-Topic-Requestor/ActivityErrors/ns4:JMSMessageCreateException">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_MessageCreate"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="$_error_JMS-Queue-Requestor/ActivityErrors/ns4:JMSSessionCreateException or $_error_JMS-Topic-Requestor/ActivityErrors/ns4:JMSSessionCreateException">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_SessionCreate"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="$_error_JMS-Queue-Requestor/ActivityErrors/ns4:JMSSendException or $_error_JMS-Topic-Requestor/ActivityErrors/ns4:JMSSendException">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_Send"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:when test="$_error_JMS-Queue-Requestor/ActivityErrors/ns4:JMSReceiveException or $_error_JMS-Topic-Requestor/ActivityErrors/ns4:JMSReceiveException">
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_RqQueTopic_Receive"/>
                                        </ErrorCode>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                        </ErrorCode>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </ErrorDescription>
                                <xsl:if test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                                    <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                                        <NativeErrorCode>
                                            <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                        </NativeErrorCode>
                                    </xsl:if>
                                </xsl:if>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                </Severity>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Technical"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="tib:render-xml($Start/IN_SendMessage2QueueOrTopic)"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </pfx2:ErrorMessage>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="InitTimeOutException">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>140</pd:x>
