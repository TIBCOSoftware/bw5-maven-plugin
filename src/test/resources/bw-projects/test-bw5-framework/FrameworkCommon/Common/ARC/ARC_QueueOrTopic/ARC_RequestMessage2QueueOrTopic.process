            <pd:resourceType>ae.activities.JMSTopicRequestReplyActivity</pd:resourceType>
            <pd:x>410</pd:x>
            <pd:y>73</pd:y>
            <config>
                <PermittedMessageType>XML Text</PermittedMessageType>
                <SessionAttributes>
                    <transacted>false</transacted>
                    <acknowledgeMode>1</acknowledgeMode>
                    <maxSessions>1</maxSessions>
                </SessionAttributes>
                <ConfigurableHeaders>
                    <JMSDeliveryMode>NON_PERSISTENT</JMSDeliveryMode>
                    <JMSExpiration>0</JMSExpiration>
                    <JMSPriority>4</JMSPriority>
                </ConfigurableHeaders>
                <ConnectionReference>/SharedResources/Connections/JMSConnections/Business/BusinessConnection.sharedjmscon</ConnectionReference>
                <InDataxsdString ref="pfx2:Message"/>
                <OutDataxsdString ref="pfx2:Message"/>
            </config>
            <pd:inputBindings>
                <ns:ActivityInput>
                    <destinationTopic>
                        <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/TargetName"/>
                    </destinationTopic>
                    <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSReplyTo) >0">
                        <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSReplyTo">
                            <replyToTopic>
