                        <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupSeq) >0">
                            <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupSeq">
                                <ns:JMSXGroupSeq>
                                    <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupSeq"/>
                                </ns:JMSXGroupSeq>
                            </xsl:if>
                        </xsl:if>
                    </JMSProperties>
                    <Body>
                        <xsl:copy-of select="$Start/IN_SendMessage2QueueOrTopic/pfx2:Message"/>
                    </Body>
                    <xsl:variable name="varCompressEnabled" select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/SERVICES/COMPRESSION/CFG_COMPRESS_ENABLED"/>
                    <DynamicProperties>
                        <xsl:if test="$varCompressEnabled='true'">
                            <property>
                                <name>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/JMS/SERVICES/COMPRESSION/CFG_PROPERTY_NAME"/>
                                </name>
                                <value>
                                    <xsl:value-of select="'true'"/>
                                </value>
                                <type>
                                    <xsl:value-of select="'boolean'"/>
                                </type>
                            </property>
                        </xsl:if>
                    </DynamicProperties>
                </ns:ActivityInput>
            </pd:inputBindings>
        </pd:activity>
