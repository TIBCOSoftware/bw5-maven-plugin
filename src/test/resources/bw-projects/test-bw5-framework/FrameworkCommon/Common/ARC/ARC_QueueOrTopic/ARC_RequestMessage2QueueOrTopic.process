        </xsl:choose>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType ref="pfx2:Message"/>
    <pd:endX>878</pd:endX>
    <pd:endY>330</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx2:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <waitTimeOut>
            <xsd:element name="waitTimeOut" type="xsd:boolean"/>
