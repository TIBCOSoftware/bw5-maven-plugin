                            </JMSExpiration>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSPriority)> 0">
                        <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSPriority">
                            <JMSPriority>
                                <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSPriority"/>
                            </JMSPriority>
                        </xsl:if>
                    </xsl:if>
                    <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSDeliveryMode) >0">
                        <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSDeliveryMode">
                            <JMSDeliveryMode>
                                <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSDeliveryMode"/>
                            </JMSDeliveryMode>
                        </xsl:if>
                    </xsl:if>
                    <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSCorrelationID)> 0">
                        <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSCorrelationID">
                            <JMSCorrelationID>
                                <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSCorrelationID"/>
                            </JMSCorrelationID>
                        </xsl:if>
                    </xsl:if>
                    <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSType)>0">
                        <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSType">
                            <JMSType>
                                <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSHeaderParameters/JMSType"/>
                            </JMSType>
                        </xsl:if>
                    </xsl:if>
                    <xsl:choose>
                        <xsl:when test="exists($Start/IN_SendMessage2QueueOrTopic/TimeOut)">
                            <requestTimeout>
                                <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/TimeOut"/>
                            </requestTimeout>
                        </xsl:when>
                        <xsl:otherwise>
                            <requestTimeout>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_Timeout"/>
                            </requestTimeout>
                        </xsl:otherwise>
                    </xsl:choose>
                    <JMSProperties>
                        <xsl:if test="string-length($Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupID)> 0">
                            <xsl:if test="$Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupID">
                                <ns:JMSXGroupID>
                                    <xsl:value-of select="$Start/IN_SendMessage2QueueOrTopic/JMSPropertyParameters/JMSXGroupID"/>
                                </ns:JMSXGroupID>
