<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd4" xmlns:pfx2="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd2" xmlns:ns12="http://www.bbva.com/EAIFramework" xmlns:pfx="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd">
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_BatchN1/UsingBatchIdVariable/ARC_FindBatchId.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="ServiceId" type="xsd:string"/>
    </pd:startType>
    <pd:startX>42</pd:startX>
    <pd:startY>313</pd:startY>
    <pd:returnBindings>
        <xsl:choose>
            <xsl:when test="$Map-Data">
                <group>
                    <BatchId>
                        <xsl:value-of select="$Map-Data/ns12:Service/BatchId"/>
                    </BatchId>
                    <IsNew>
                        <xsl:value-of select="0"/>
                    </IsNew>
                    <TimeStampUUID>
                        <xsl:value-of select="$Map-Data/ns12:Service/TimeStampUUID"/>
                    </TimeStampUUID>
                </group>
            </xsl:when>
            <xsl:otherwise>
                <group>
                    <BatchId>
                        <xsl:value-of select="$ARC_SetNewBatchId/OUT_SetNewBatchId/BatchId"/>
                    </BatchId>
                    <IsNew>
                        <xsl:value-of select="1"/>
                    </IsNew>
                    <TimeStampUUID>
                        <xsl:value-of select="$ARC_SetNewBatchId/OUT_SetNewBatchId/TimeStampUUID"/>
                    </TimeStampUUID>
                </group>
            </xsl:otherwise>
        </xsl:choose>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="BatchId" type="xsd:string"/>
                    <xsd:element name="IsNew" type="xsd:boolean"/>
                    <xsd:element name="TimeStampUUID" type="xsd:long"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>908</pd:endX>
    <pd:endY>311</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables>
        <Variable0>
            <xsd:element name="NotFoundService_id" type="xsd:string"/>
        </Variable0>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1330331673802</pd:targetNamespace>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>455</pd:x>
        <pd:y>480</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>905</pd:x>
        <pd:y>135</pd:y>
        <config>
            <element ref="ns12:Service"/>
        </config>
        <pd:inputBindings>
            <xsl:variable name="var" select="$Start/ServiceId"/>
            <ns12:Service>
                <xsl:copy-of select="$GetVariable/ns12:BatchN1Data/Service[ServiceId=$Start/ServiceId]/ancestor-or-self::*/namespace::node()"/>
                <xsl:copy-of select="$GetVariable/ns12:BatchN1Data/Service[ServiceId=$Start/ServiceId]/@*"/>
                <xsl:copy-of select="$GetVariable/ns12:BatchN1Data/Service[ServiceId=$Start/ServiceId]/node()"/>
            </ns12:Service>
        </pd:inputBindings>
    </pd:activity>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.CriticalSectionGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>170</pd:x>
        <pd:y>184</pd:y>
        <pd:width>418</pd:width>
        <pd:height>241</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>criticalSection</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:scope>single</pd:scope>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>GetVariable</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_SetNewBatchId</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>GetVariable</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>$GetVariable/ns12:BatchN1Data/Service[ServiceId=$Start/ServiceId]</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>GetVariable</pd:from>
            <pd:to>ARC_SetNewBatchId</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>otherwise</pd:conditionType>
        </pd:transition>
        <pd:activity name="GetVariable">
            <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
            <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
            <pd:x>242</pd:x>
            <pd:y>310</pd:y>
            <config>
                <variableConfig>/SharedResources/SharedVariables/Shared-Variable( BatchId).sharedvariable</variableConfig>
            </config>
            <pd:inputBindings/>
        </pd:activity>
        <pd:activity name="ARC_SetNewBatchId">
            <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
            <pd:resourceType>ae.process.subprocess</pd:resourceType>
            <pd:x>443</pd:x>
            <pd:y>363</pd:y>
            <config>
                <processName>/Common/ARC/ARC_BatchN1/UsingBatchIdVariable/ARC_SetNewBatchId.process</processName>
            </config>
            <pd:inputBindings>
                <ServiceId>
                    <xsl:value-of select="$Start/ServiceId"/>
                </ServiceId>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>590</pd:x>
        <pd:y>481</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Map Data</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$GetVariable/ns12:BatchN1Data/Service[ServiceId=$Start/ServiceId]</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>