<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:UUID="java://EAIFramework.Processes.Private.Common.HeaderManagement.UUIDGenerator.UUIDGenerator" xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:ns2="http://www.tibco.com/pe/DeployedVarsType" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns4="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Public/Schemas/XSD/MCD/Schema.xsd" xmlns:ns3="http://www.bbva.com/EAIFramework" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:GetIP="java://EAIFramework.Processes.Private.Common.HeaderManagement.IPAddress.IPAddress" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx2="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd">
    
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_CustomEventManagement/ARC_CustomEventInternalSenderAPI.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="ARC_TraceSenderAPI">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="CLETraceData">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="EventCode" type="ns3:EventCodeType"/>
                                <xsd:element name="ProcessName" type="xsd:string"/>
                                <xsd:element name="ProjectName" type="xsd:string"/>
                                <xsd:element name="MessageType" type="ns3:MessageTypes"/>
                                <xsd:element name="IsResponse" type="xsd:boolean"/>
                                <xsd:element name="TraceLevel" type="ns3:TraceLevelType"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Body" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>139</pd:startX>
    <pd:startY>75</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$ARC_SpecificFormatOutboundHeaderManagement/SpecificFormatMessage/*"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endX>617</pd:endX>
    <pd:endY>74</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1324409765610</pd:targetNamespace>
    <pd:activity name="ARC_TraceCLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>363</pd:x>
        <pd:y>162</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/EventCode"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_CustomEvent"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/MessageType"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/IsResponse"/>
                    </isResponse>
                    <TraceLevel>
                        <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/TraceLevel"/>
                    </TraceLevel>
                    <NameValue>
                        <Name>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/AuditParameters/GLB_ProcessName_AuditKey"/>
                        </Name>
                        <Value>
                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/ProcessName"/>
                        </Value>
                    </NameValue>
                    <NameValue>
                        <Name>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/AuditParameters/GLB_ProcessName_AuditKey"/>
                        </Name>
                        <Value>
                            <xsl:value-of select="$Start/ARC_TraceSenderAPI/CLETraceData/ProjectName"/>
                        </Value>
                    </NameValue>
                </CLETraceData>
                <Body>
                    <xsl:value-of select="$Start/ARC_TraceSenderAPI/Body"/>
                </Body>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>ARC_TraceCLESenderAPI</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Multiple Bends</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_TraceCLESenderAPI</pd:to>
        <pd:xpathDescription>no filtrar</pd:xpathDescription>
        <pd:lineType>Multiple Bends</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$Start/ARC_TraceSenderAPI/CLETraceData/TraceLevel&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>