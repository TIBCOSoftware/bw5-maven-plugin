<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pfx15="http://www.tibco.com/pe/WriteToLogActivitySchema" xmlns:pfx14="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/CompuestoAppABC/Schema.xsd" xmlns:ns="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppA/Schema.xsd" xmlns:pfx13="http://www.bbva.com/EAIFramework" xmlns:pfx12="http://www.tibco.com/ns/no_namespace_schema_location/CommonResources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx11="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Public/Resources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx10="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Public/Schemas/XSD/MCD/Schema.xsd" xmlns:pfx5="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx4="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Export Adapter/MXML.dtd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:pfx2="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/deals/ForwardDeals.xsd" xmlns:pfx9="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Resources/Public/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/Schemas/Schema.xsd" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd3" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx="http://www.example.org/BBVACabecera" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:ns1="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppB/Schema.xsd" xmlns:ns4="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppC/Schema.xsd" xmlns:ns3="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_RoutingHelper/ARC_RoutingUsingFileRoutingMaps.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="IN_File">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="PlanName" type="xsd:string"/>
                    <xsd:element name="FileName" type="xsd:string"/>
                    <xsd:element name="ServiceIdLocator" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>51</pd:startX>
    <pd:startY>57</pd:startY>
    <pd:returnBindings>
        <OUT_GetTargetServices>
            <xsl:copy-of select="$GetRoutingHeader/TargetServices/pfx13:RoutingService"/>
        </OUT_GetTargetServices>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="OUT_GetTargetServices">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx13:RoutingService" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>966</pd:endX>
    <pd:endY>57</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx13:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <ServiceIdLocator>
            <xsd:element name="ServiceIdLocator" type="xsd:string"/>
        </ServiceIdLocator>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1292831667099</pd:targetNamespace>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>144</pd:x>
        <pd:y>460</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="RetrieveRoutingConfigCache">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>497</pd:x>
        <pd:y>176</pd:y>
        <config>
            <variableConfig>/SharedResources/SharedVariables/RoutingConfigList.sharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="LoadRoutingConfig">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>501</pd:x>
        <pd:y>395</pd:y>
        <config>
            <processName>/Common/ARC/ARC_RoutingHelper/ARC_LoadRoutingConfigListCache.process</processName>
        </config>
        <pd:inputBindings>
            <IN_RoutingConfiguration>
                <FileName>
                    <xsl:value-of select="concat($_globalVariables/ns3:GlobalVariables/CFG/ARCHITECTURE/ROUTING/RoutingConfigPath, $Start/IN_File/FileName )"/>
                </FileName>
            </IN_RoutingConfiguration>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="GetRoutingConfigCache">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>829</pd:x>
        <pd:y>395</pd:y>
        <config>
            <variableConfig>/SharedResources/SharedVariables/RoutingConfigList.sharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="GetRoutingHeader">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>828</pd:x>
        <pd:y>175</pd:y>
        <config>
            <element>
                <xsd:element name="TargetServices">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element ref="pfx13:RoutingService" minOccurs="0" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <TargetServices>
                <xsl:choose>
                    <xsl:when test="$GetRoutingConfigCache">
                        <xsl:if test="count($GetRoutingConfigCache/pfx13:RoutingConfig/Group[  @Name =$Start/IN_File/PlanName     ]  /Routing[  pfx13:Origin/pfx13:Services/pfx13:Service/pfx13:ServiceId=$Start/IN_File/ServiceIdLocator  ]/pfx13:Target/pfx13:Services/pfx13:Service)>0">
                            <xsl:for-each select="$GetRoutingConfigCache/pfx13:RoutingConfig/Group[  @Name =$Start/IN_File/PlanName     ]  /Routing[  pfx13:Origin/pfx13:Services/pfx13:Service/pfx13:ServiceId=$Start/IN_File/ServiceIdLocator ]/pfx13:Target/pfx13:Services/pfx13:Service">
                                <pfx13:RoutingService>
                                    <pfx13:ServiceId>
                                        <xsl:value-of select="current()/pfx13:ServiceId"/>
                                    </pfx13:ServiceId>
                                    <xsl:if test="count(current()/pfx13:JMSInputDestinationName)>0">
                                        <xsl:if test="current()/pfx13:JMSInputDestinationName">
                                            <pfx13:JMSInputDestinationName>
                                                <xsl:value-of select="current()/pfx13:JMSInputDestinationName"/>
                                            </pfx13:JMSInputDestinationName>
                                        </xsl:if>
                                    </xsl:if>
                                    <xsl:if test="count(current()/pfx13:JMSInputDestinationType)>0">
                                        <xsl:if test="current()/pfx13:JMSInputDestinationType">
                                            <pfx13:JMSInputDestinationType>
                                                <xsl:value-of select="current()/pfx13:JMSInputDestinationType"/>
                                            </pfx13:JMSInputDestinationType>
                                        </xsl:if>
                                    </xsl:if>
                                    <pfx13:ServiceType>
                                        <xsl:value-of select="current()/pfx13:ServiceType"/>
                                    </pfx13:ServiceType>
                                </pfx13:RoutingService>
                            </xsl:for-each>
                        </xsl:if>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="count($RetrieveRoutingConfigCache/pfx13:RoutingConfig/Group[  @Name =$Start/IN_File/PlanName     ]  /Routing[  pfx13:Origin/pfx13:Services/pfx13:Service/pfx13:ServiceId=$Start/IN_File/ServiceIdLocator  ]/pfx13:Target/pfx13:Services/pfx13:Service)>0">
                            <xsl:for-each select="$RetrieveRoutingConfigCache/pfx13:RoutingConfig/Group[  @Name =$Start/IN_File/PlanName     ]  /Routing[  pfx13:Origin/pfx13:Services/pfx13:Service/pfx13:ServiceId=$Start/IN_File/ServiceIdLocator  ]/pfx13:Target/pfx13:Services/pfx13:Service">
                                <pfx13:RoutingService>
                                    <pfx13:ServiceId>
                                        <xsl:value-of select="current()/pfx13:ServiceId"/>
                                    </pfx13:ServiceId>
                                    <xsl:if test="count(current()/pfx13:JMSInputDestinationName)>0">
                                        <xsl:if test="current()/pfx13:JMSInputDestinationName">
                                            <pfx13:JMSInputDestinationName>
                                                <xsl:value-of select="current()/pfx13:JMSInputDestinationName"/>
                                            </pfx13:JMSInputDestinationName>
                                        </xsl:if>
                                    </xsl:if>
                                    <xsl:if test="count(current()/pfx13:JMSInputDestinationType)>0">
                                        <xsl:if test="current()/pfx13:JMSInputDestinationType">
                                            <pfx13:JMSInputDestinationType>
                                                <xsl:value-of select="current()/pfx13:JMSInputDestinationType"/>
                                            </pfx13:JMSInputDestinationType>
                                        </xsl:if>
                                    </xsl:if>
                                    <pfx13:ServiceType>
                                        <xsl:value-of select="current()/pfx13:ServiceType"/>
                                    </pfx13:ServiceType>
                                </pfx13:RoutingService>
                            </xsl:for-each>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
            </TargetServices>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>147</pd:x>
        <pd:y>550</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate ErrorMessage">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>466</pd:x>
        <pd:y>559</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <pfx13:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Generic_Error_RoutingFromFileByServiceId"/>
                        </ErrorDescription>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                            <NativeErrorCode>
                                <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                            </NativeErrorCode>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <NativeErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </NativeErrorDescription>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/StackTrace)>0">
                            <StackTrace>
                                <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                            </StackTrace>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/ProcessStack)>0">
                            <StackProcess>
                                <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                            </StackProcess>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/IN_File)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx13:ErrorMessage>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>331</pd:x>
        <pd:y>460</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>GetRoutingHeader</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Multiple Bends</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate ErrorMessage</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>RetrieveRoutingConfigCache</pd:to>
        <pd:xpathDescription>gw</pd:xpathDescription>
        <pd:lineType>Multiple Bends</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($Start/IN_File/ServiceIdLocator)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>RetrieveRoutingConfigCache</pd:from>
        <pd:to>LoadRoutingConfig</pd:to>
        <pd:xpathDescription>LoadRoutingConfig</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($RetrieveRoutingConfigCache/pfx13:RoutingConfig/Group/Routing)=0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>RetrieveRoutingConfigCache</pd:from>
        <pd:to>GetRoutingHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetRoutingConfigCache</pd:from>
        <pd:to>GetRoutingHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>LoadRoutingConfig</pd:from>
        <pd:to>GetRoutingConfigCache</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:label>
        <pd:name>Label (2)</pd:name>
        <pd:description>Rellenar los campos:
- código del error
- severidad</pd:description>
        <pd:x>454</pd:x>
        <pd:y>470</pd:y>
        <pd:width>137</pd:width>
        <pd:height>66</pd:height>
        <pd:fontName>Dialog.bold-plain-12</pd:fontName>
        <pd:fontColor>-16777216</pd:fontColor>
        <pd:color>-6684673</pd:color>
        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
</pd:ProcessDefinition>