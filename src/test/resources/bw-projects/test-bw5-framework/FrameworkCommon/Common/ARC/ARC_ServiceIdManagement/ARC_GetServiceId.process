    <pd:transition>
        <pd:from>SetServiceIdAndPath</pd:from>
        <pd:to>GetGlobalQueueConfigurationCheck</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
