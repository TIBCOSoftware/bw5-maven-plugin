    <pd:activity name="GeneralError">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>255</pd:x>
        <pd:y>464</pd:y>
        <config>
            <faultName>Schema0</faultName>
        </config>
        <pd:inputBindings>
            <pfx:ActivityInput>
                <message>
                    <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                </message>
                <data>
                    <xsl:choose>
                        <xsl:when test="string-length($CatchErrorMessage/pfx2:ErrorMessage/ErrorCode)>0">
                            <xsl:copy-of select="$CatchErrorMessage/pfx2:ErrorMessage"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <pfx2:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ServiceIdError"/>
                                </ErrorCode>
                                <xsl:if test="$_error/ns:ErrorReport/Msg">
                                    <ErrorDescription>
                                        <xsl:value-of select="$_error/ns:ErrorReport/Msg"/>
                                    </ErrorDescription>
                                </xsl:if>
                                <xsl:if test="$_error/ns:ErrorReport/StackTrace">
                                    <StackTrace>
                                        <xsl:value-of select="$_error/ns:ErrorReport/StackTrace"/>
                                    </StackTrace>
                                </xsl:if>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                                </Severity>
                                <OriginalMessage>
                                    <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                                </OriginalMessage>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </pfx2:ErrorMessage>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
