    <pd:transition>
        <pd:from>checkServiceId</pd:from>
        <pd:to>SetServiceIdAndPath</pd:to>
        <pd:xpathDescription>OKGetServiceId</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>string-length($Variable/group/ServiceId)&lt;=$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_ServiceId_Max_Length
and
string-length($Variable/group/ServiceId)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>checkServiceId</pd:from>
        <pd:to>ServiceId_Not_Correct</pd:to>
        <pd:xpathDescription>ErrorGetServiceId</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CatchErrorMessage</pd:from>
        <pd:to>GeneralError</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>