<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/EngineTypes" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/pe/DeployedVarsType" xmlns:pfx2="http://www.bbva.com/EAIFramework" xmlns:pfx="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC/ARC_ServiceIdManagement/ARC_GetServiceId.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="pathGetCurrentProcess" type="xsd:string"/>
    </pd:startType>
    <pd:startX>71</pd:startX>
    <pd:startY>114</pd:startY>
    <pd:returnBindings>
        <GetServiceIdParams>
            <ServiceId>
                <xsl:value-of select="$SetServiceIdAndPath/Data/ServiceId"/>
            </ServiceId>
            <DynamicInvocationRoot>
                <xsl:value-of select="$SetServiceIdAndPath/Data/Path"/>
            </DynamicInvocationRoot>
            <xsl:copy-of select="$BuildMetaData/ServiceMetaData"/>
        </GetServiceIdParams>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="GetServiceIdParams">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                    <xsd:element name="DynamicInvocationRoot" type="xsd:string"/>
                    <xsd:element name="ServiceMetaData" minOccurs="0">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="Data" maxOccurs="unbounded">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="Name" type="xsd:string"/>
                                            <xsd:element name="Value" type="xsd:string"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>2037</pd:endX>
    <pd:endY>123</pd:endY>
    <pd:errorSchemas>
        <Schema0 ref="pfx2:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <Variable>
            <xsd:element name="group">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="ServiceId" type="xsd:string"/>
                        <xsd:element name="root" type="xsd:string"/>
                        <xsd:element name="FromBusiness" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </Variable>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1332850669167</pd:targetNamespace>
    <pd:activity name="AssignServiceIdInfo">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>332</pd:x>
        <pd:y>115</pd:y>
        <config>
            <variableName>Variable</variableName>
        </config>
        <pd:inputBindings>
            <group>
                <ServiceId>
                    <xsl:value-of select="substring-before(substring-after(substring-after(concat($_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root,substring-after(concat(&quot;/&quot;,$Start/pathGetCurrentProcess), $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root)),&quot;/&quot;),&quot;/&quot;), &quot;/&quot;)"/>
                </ServiceId>
                <root>
                    <xsl:value-of select="concat(substring-before($Start/pathGetCurrentProcess, $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root),$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root)"/>
                </root>
                <FromBusiness>
                    <xsl:value-of select="concat($_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root,substring-after(concat(&quot;/&quot;,$Start/pathGetCurrentProcess), $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root))"/>
                </FromBusiness>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ServiceId_Not_Correct">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>468</pd:x>
        <pd:y>251</pd:y>
        <config>
            <faultName>Schema0</faultName>
        </config>
        <pd:inputBindings>
            <pfx:ActivityInput>
                <message>
                    <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                </message>
                <data>
                    <pfx2:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ServiceIdError"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="if(string-length($Variable/group/ServiceId)=0)&#xA;then&#xA;$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_ServiceIdErrorDescription&#xA;else&#xA;$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_ServiceIdLenghTooLong"/>
                        </ErrorDescription>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <OriginalMessage>
                            <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                        </OriginalMessage>
                        <Category>
                            <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="$Start/pathGetCurrentProcess"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx2:ErrorMessage>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="SetServiceIdAndPath">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>606</pd:x>
        <pd:y>113</pd:y>
        <config>
            <showResult>true</showResult>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceIdAndPath.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <Data>
                <ServiceId>
                    <xsl:value-of select="$Variable/group/ServiceId"/>
                </ServiceId>
                <Path>
                    <xsl:value-of select="concat($Variable/group/root, $Variable/group/ServiceId)"/>
                </Path>
            </Data>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="SetMetaDataInfo">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>1336</pd:x>
        <pd:y>118</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceMetaData.jobsharedvariable</variableConfig>
            <showResult>true</showResult>
        </config>
        <pd:inputBindings>
            <xsl:copy-of select="$BuildMetaData/ServiceMetaData"/>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="BuildMetaData">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>1174</pd:x>
        <pd:y>119</pd:y>
        <config>
            <element>
                <xsd:element name="ServiceMetaData">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="Data" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Name" type="xsd:string"/>
                                        <xsd:element name="Value" type="xsd:string"/>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <ServiceMetaData>
                <Data>
                    <Name>
                        <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/DEPVERSION"/>
                    </Name>
                    <xsl:variable name="var2" select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/DEPVERSION"/>
                    <xsl:choose>
                        <xsl:when test="string-length($GetGlobalMetaData/GlobalServiceMetaData/Data[  Name = $var2   ]/Value)>0">
                            <xsl:variable name="var" select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/DEPVERSION"/>
                            <Value>
                                <xsl:value-of select="$GetGlobalMetaData/GlobalServiceMetaData/Data[  Name = $var   ]/Value"/>
                            </Value>
                        </xsl:when>
                        <xsl:otherwise>
                            <Value>
                                <xsl:value-of select="&quot;&quot;"/>
                            </Value>
                        </xsl:otherwise>
                    </xsl:choose>
                </Data>
                <Data>
                    <Name>
                        <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/LIBVERSION"/>
                    </Name>
                    <xsl:variable name="var4" select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/LIBVERSION"/>
                    <xsl:choose>
                        <xsl:when test="string-length($GetGlobalMetaData/GlobalServiceMetaData/Data[  Name = $var4   ]/Value)>0">
                            <xsl:variable name="var3" select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/LIBVERSION"/>
                            <Value>
                                <xsl:value-of select="$GetGlobalMetaData/GlobalServiceMetaData/Data[  Name = $var3   ]/Value"/>
                            </Value>
                        </xsl:when>
                        <xsl:otherwise>
                            <Value>
                                <xsl:value-of select="&quot;&quot;"/>
                            </Value>
                        </xsl:otherwise>
                    </xsl:choose>
                </Data>
                <Data>
                    <Name>
                        <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/ENDPOINT"/>
                    </Name>
                    <xsl:variable name="var5" select="$SetServiceIdAndPath/Data/ServiceId"/>
                    <Value>
                        <xsl:value-of select="$GetGlobalMetaData/GlobalServiceMetaData/Data[  Value = $var5   ]/Name"/>
                    </Value>
                </Data>
                <Data>
                    <Name>
                        <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/SERVICEID"/>
                    </Name>
                    <Value>
                        <xsl:value-of select="$Variable/group/ServiceId"/>
                    </Value>
                </Data>
                <Data>
                    <Name>
                        <xsl:value-of select="$_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/MetaDataConstants/EVENTPATTERNGROUP"/>
                    </Name>
                    <xsl:variable name="var6" select="$SetServiceIdAndPath/Data/ServiceId"/>
                    <Value>
                        <xsl:value-of select="$GetGlobalQueueConfigurationCheck/pfx2:QueuesCacheList/pfx2:Destination[ @ServiceId= $var6 ]/@PatternGroupNameRef"/>
                    </Value>
                </Data>
            </ServiceMetaData>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="SetFilteredMonitoringPatterns">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>1869</pd:x>
        <pd:y>124</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ServiceIDFilteredEventPatterns.jobsharedvariable</variableConfig>
            <showResult>true</showResult>
        </config>
        <pd:inputBindings>
            <EventPatterns>
                <xsl:variable name="var" select="$SetServiceIdAndPath/Data/ServiceId"/>
                <xsl:choose>
                    <xsl:when test="$LoadGeneralConfiguration">
                        <xsl:for-each select="$GetEventPatterns/FilteredMonitoring/FilteredPatterns[  GroupPatternName = $LoadGeneralConfiguration/Data/pfx2:QueuesCacheList/pfx2:Destination[    @ServiceId= $SetServiceIdAndPath/Data/ServiceId ]/@PatternGroupNameRef    ]/Event">
                            <Events>
                                <EventName>
                                    <xsl:value-of select="current()/EventCode"/>
                                </EventName>
                                <ErrorStopFlow>
                                    <xsl:value-of select="current()/ErrorStopFlow"/>
                                </ErrorStopFlow>
                                <xsl:for-each select="Destination">
                                    <Destination>
                                        <DestinationType>
                                            <xsl:value-of select="DestinationType"/>
                                        </DestinationType>
                                        <DestinationName>
                                            <xsl:value-of select="DestinationName"/>
                                        </DestinationName>
                                    </Destination>
                                </xsl:for-each>
                            </Events>
                        </xsl:for-each>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:for-each select="$GetEventPatterns/FilteredMonitoring/FilteredPatterns[  GroupPatternName = $GetGlobalQueueConfigurationCheck/pfx2:QueuesCacheList/pfx2:Destination[    @ServiceId= $SetServiceIdAndPath/Data/ServiceId ]/@PatternGroupNameRef    ]/Event">
                            <Events>
                                <EventName>
                                    <xsl:value-of select="current()/EventCode"/>
                                </EventName>
                                <ErrorStopFlow>
                                    <xsl:value-of select="current()/ErrorStopFlow"/>
                                </ErrorStopFlow>
                                <xsl:for-each select="Destination">
                                    <Destination>
                                        <DestinationType>
                                            <xsl:value-of select="DestinationType"/>
                                        </DestinationType>
                                        <DestinationName>
                                            <xsl:value-of select="DestinationName"/>
                                        </DestinationName>
                                    </Destination>
                                </xsl:for-each>
                            </Events>
                        </xsl:for-each>
                    </xsl:otherwise>
                </xsl:choose>
            </EventPatterns>
        </pd:inputBindings>
    </pd:activity>
