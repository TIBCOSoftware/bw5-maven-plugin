    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>checkGetRoot</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>checkGetRoot</pd:from>
        <pd:to>AssignServiceIdInfo</pd:to>
        <pd:xpathDescription>OKGetRoot</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>tib:index-of(concat("/",$Start/pathGetCurrentProcess), $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root)!=-1   and tib:last-index-of(concat("/",$Start/pathGetCurrentProcess), $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root)= tib:index-of(concat("/",$Start/pathGetCurrentProcess), $_globalVariables/pfx3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_root)</pd:xpath>
    </pd:transition>
    <pd:transition>
