                            </TimeOut>
                            <xsl:choose>
                                <xsl:when test="count($Start/IN_SendMessage/ServicesType[ServiceType=$current_service/pfx2:RoutingService/pfx2:ServiceType]/ServiceType)>0">
                                    <Sync>
                                        <xsl:value-of select="true()"/>
                                    </Sync>
                                </xsl:when>
