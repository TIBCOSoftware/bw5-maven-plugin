                                                    <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/IsLight"/>
                                                </IsLight>
                                            </xsl:if>
                                            <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/SaveMessage=&quot;true&quot;">
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/SaveMessage">
                                                    <SaveMessage>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/SaveMessage"/>
                                                    </SaveMessage>
                                                </xsl:if>
                                            </xsl:if>
                                            <xsl:choose>
                                                <xsl:when test="$current_service/pfx2:RoutingService/pfx2:ServiceType=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_RoutingGatewayAdapter">
                                                    <ActiveHeaderNonCompatibility>
                                                        <xsl:value-of select="true()"/>
                                                    </ActiveHeaderNonCompatibility>
                                                </xsl:when>
                                                <xsl:when test="$current_service/pfx2:RoutingService/pfx2:ServiceType=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_OrchestrationAdapter">
                                                    <ActiveHeaderNonCompatibility>
                                                        <xsl:value-of select="true()"/>
                                                    </ActiveHeaderNonCompatibility>
                                                </xsl:when>
                                                <xsl:otherwise>
                                                    <ActiveHeaderNonCompatibility>
                                                        <xsl:value-of select="false()"/>
                                                    </ActiveHeaderNonCompatibility>
                                                </xsl:otherwise>
                                            </xsl:choose>
                                            <JMSHeaderParameters>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSDeliveryMode">
                                                    <JMSDeliveryMode>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSDeliveryMode"/>
                                                    </JMSDeliveryMode>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSTimeStamp">
                                                    <JMSTimeStamp>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSTimeStamp"/>
                                                    </JMSTimeStamp>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSExpiration">
                                                    <JMSExpiration>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSExpiration"/>
                                                    </JMSExpiration>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSRedelivered">
                                                    <JMSRedelivered>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSRedelivered"/>
                                                    </JMSRedelivered>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSPriority">
                                                    <JMSPriority>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSPriority"/>
                                                    </JMSPriority>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSType">
                                                    <JMSType>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSType"/>
                                                    </JMSType>
                                                </xsl:if>
                                                <xsl:copy-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/NameValue"/>
                                            </JMSHeaderParameters>
                                            <JMSPropertiesParameters>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXUserID">
                                                    <JMSXUserID>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXUserID"/>
                                                    </JMSXUserID>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXAppID">
                                                    <JMSXAppID>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXAppID"/>
                                                    </JMSXAppID>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXProducerTXID">
                                                    <JMSXProducerTXID>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXProducerTXID"/>
                                                    </JMSXProducerTXID>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXConsumerTXID">
                                                    <JMSXConsumerTXID>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXConsumerTXID"/>
                                                    </JMSXConsumerTXID>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXRcvTimestamp">
                                                    <JMSXRcvTimestamp>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXRcvTimestamp"/>
                                                    </JMSXRcvTimestamp>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXDeliveryCount">
                                                    <JMSDeliveryCount>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXDeliveryCount"/>
                                                    </JMSDeliveryCount>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXGroupID">
                                                    <JMSXGroupID>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXGroupID"/>
                                                    </JMSXGroupID>
                                                </xsl:if>
                                                <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXGroupSeq">
                                                    <JMSXGroupSeq>
                                                        <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/JMSXGroupSeq"/>
                                                    </JMSXGroupSeq>
                                                </xsl:if>
                                                <xsl:copy-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSPropertiesParameters/NameValue"/>
                                            </JMSPropertiesParameters>
                                        </UpdateHeaderParameters>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:if>
                        </ARC_REQS_Main_IN>
                    </pd:inputBindings>
                </pd:activity>
                <pd:activity name="ARC_SendMesageForward">
                    <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
                    <pd:resourceType>ae.process.subprocess</pd:resourceType>
                    <pd:x>785</pd:x>
                    <pd:y>209</pd:y>
                    <config>
                        <processName>/Common/ARC/ARC_QueueOrTopic/ARC_SendMessageHeaderCount.process</processName>
                    </config>
                    <pd:inputBindings>
                        <ARC_REQS_Main_IN>
                            <Body>
                                <xsl:copy-of select="$ARC_SendMesageWait/OUTPUT_SendMessage/pfx2:Message/pfx2:Body/*"/>
                            </Body>
                            <xsl:if test="$Start/IN_SendMessage/UpdateHeaderParameters/JMSGWReplyTo">
                                <JMsReplyTo>
                                    <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSGWReplyTo"/>
                                </JMsReplyTo>
                            </xsl:if>
                            <JMSCorrelationId>
                                <xsl:value-of select="$Start/IN_SendMessage/UpdateHeaderParameters/JMSHeadersParameters/JMSCorrelationID"/>
                            </JMSCorrelationId>
                            <Service>
                                <xsl:choose>
                                    <xsl:when test="count($Start/IN_SendMessage/OrchestrationService/JMSInputDestinationId)>0">
                                        <JMSDestination>
                                            <xsl:value-of select="$Start/IN_SendMessage/OrchestrationService/JMSInputDestinationId"/>
                                        </JMSDestination>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <ServiceId>
                                            <xsl:value-of select="$Start/IN_SendMessage/OrchestrationService/OrchestrationServiceId"/>
                                        </ServiceId>
                                    </xsl:otherwise>
                                </xsl:choose>
                                <ServiceType>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_OrchestrationAdapter"/>
                                </ServiceType>
                            </Service>
                            <TimeOut>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_Timeout"/>
                            </TimeOut>
                            <Sync>
                                <xsl:value-of select="false()"/>
                            </Sync>
                            <UpdateHeaderParameters>
                                <ActiveHeaderNonCompatibility>
                                    <xsl:value-of select="true()"/>
                                </ActiveHeaderNonCompatibility>
                                <JMSHeaderParameters/>
                                <JMSPropertiesParameters/>
                            </UpdateHeaderParameters>
                        </ARC_REQS_Main_IN>
                    </pd:inputBindings>
                </pd:activity>
                <pd:activity name="OK">
                    <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
                    <pd:resourceType>ae.activities.null</pd:resourceType>
                    <pd:x>444</pd:x>
                    <pd:y>319</pd:y>
                    <config/>
                    <pd:inputBindings/>
                </pd:activity>
                <pd:activity name="NotifySucessResponse">
                    <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
                    <pd:resourceType>ae.activities.log</pd:resourceType>
                    <pd:x>593</pd:x>
                    <pd:y>214</pd:y>
                    <config>
                        <role>User</role>
                    </config>
                    <pd:inputBindings>
                        <ns4:ActivityInput>
                            <message>
                                <xsl:value-of select="&quot;Sucess response from sync service&quot;"/>
                            </message>
                        </ns4:ActivityInput>
                    </pd:inputBindings>
                </pd:activity>
            </pd:group>
        </pd:group>
    </pd:group>
    <pd:activity name="Catch-1">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>299</pd:x>
        <pd:y>739</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=group</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>600</pd:x>
        <pd:y>739</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch-2">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>299</pd:x>
        <pd:y>640</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
            <fault>localname=group</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate-Error-1">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>599</pd:x>
        <pd:y>639</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx:ActivityInput>
                <message/>
                <data>
                    <pfx2:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="$_error/ns2:ErrorReport/Msg">
                            <ErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </ErrorDescription>
                        </xsl:if>
                        <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                            <NativeErrorCode>
                                <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                            </NativeErrorCode>
                        </xsl:if>
                        <xsl:if test="$_error/ns2:ErrorReport/Msg">
                            <NativeErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </NativeErrorDescription>
                        </xsl:if>
                        <xsl:if test="$_error/ns2:ErrorReport/StackTrace">
                            <StackTrace>
                                <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                            </StackTrace>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0, 0)"/>
                        </ErrorDate>
                        <xsl:if test="$_error/ns2:ErrorReport/ProcessStack">
                            <StackProcess>
                                <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                            </StackProcess>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <OriginalMessage>
                            <xsl:value-of select="tib:render-xml($Start/*)"/>
                        </OriginalMessage>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Functional"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/*)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx2:ErrorMessage>
                </data>
            </pfx:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Transaccion</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch-1</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch-2</pd:from>
        <pd:to>Generate-Error-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Transaccion</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>