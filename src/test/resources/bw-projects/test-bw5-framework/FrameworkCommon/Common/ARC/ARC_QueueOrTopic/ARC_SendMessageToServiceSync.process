                    <pd:lineType>Multiple Bends</pd:lineType>
                    <pd:lineColor>-16777216</pd:lineColor>
                    <pd:conditionType>xpath</pd:conditionType>
                    <pd:xpath>count($Start/IN_SendMessage/OrchestrationService/OrchestrationServiceId )&gt;0 and count($ARC_SendMesageWait/OUTPUT_SendMessage/pfx2:Message)&gt;0</pd:xpath>
