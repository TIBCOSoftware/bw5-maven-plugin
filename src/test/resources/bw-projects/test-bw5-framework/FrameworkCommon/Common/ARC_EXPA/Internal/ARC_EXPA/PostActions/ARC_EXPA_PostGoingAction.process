<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx2="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd2" xmlns:ns="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx41="http://www.tibco.com/pe/CheckpointSchema" xmlns:pfx3="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx4="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns4="www.tibco.com/plugin/Sleep" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns5="http://schemas.tibco.com/bw/plugins/jms/5.0/jmsExceptions" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns12="http://www.bbva.com/EAIFramework" xmlns:ns11="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns21="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:pfx1="http://www.tibco.com/pe/WriteToLogActivitySchema">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_EXPA/Internal/ARC_EXPA/PostActions/ARC_EXPA_PostGoingAction.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="CDMMessage">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="ns12:ArchitectureHeader"/>
                    <xsd:element name="Body">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:any processContents="skip"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element ref="ns12:ExportAdapterParameters"/>
                    <xsd:element name="DynamicInvocationRoot" type="xsd:string"/>
                    <xsd:element name="TargetServices">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="areServicesNull" type="xsd:boolean" minOccurs="0"/>
                                <xsd:element name="Service" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element ref="ns12:TraceLevel" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>34</pd:startX>
    <pd:startY>38</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>1326</pd:endX>
    <pd:endY>41</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns12:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1324369924449</pd:targetNamespace>
    <pd:group name="JMS Transaction">
        <pd:type>com.tibco.pe.core.TransactionGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>776</pd:x>
        <pd:y>150</pd:y>
        <pd:width>287</pd:width>
        <pd:height>252</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>transactionGroup</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:transactionType>JMSTransaction</pd:transactionType>
            <pd:includeCheckpoint>false</pd:includeCheckpoint>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Group</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Group</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:group name="Group">
            <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
            <pd:resourceType>ae.process.group</pd:resourceType>
            <pd:x>798</pd:x>
            <pd:y>184</pd:y>
            <pd:width>225</pd:width>
            <pd:height>182</pd:height>
            <pd:collapsedWidth>57</pd:collapsedWidth>
            <pd:collapsedHeight>70</pd:collapsedHeight>
            <pd:groupVariables/>
            <pd:joinToggle>inherit</pd:joinToggle>
            <config>
                <pd:groupType>inputLoop</pd:groupType>
                <pd:serializable>false</pd:serializable>
                <pd:over>$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination</pd:over>
                <pd:iterationElementSlot>current</pd:iterationElementSlot>
                <pd:indexSlot>index</pd:indexSlot>
                <pd:activityOutputName/>
                <pd:accumulateOutput>false</pd:accumulateOutput>
            </config>
            <pd:inputBindings/>
            <pd:expanded>true</pd:expanded>
            <pd:transition>
                <pd:from>start</pd:from>
                <pd:to>ARC_SendCDM2QueueOrTopic</pd:to>
                <pd:lineType>Default</pd:lineType>
                <pd:lineColor>-16777216</pd:lineColor>
                <pd:conditionType>always</pd:conditionType>
            </pd:transition>
            <pd:transition>
                <pd:from>ARC_SendCDM2QueueOrTopic</pd:from>
                <pd:to>end</pd:to>
                <pd:lineType>Default</pd:lineType>
                <pd:lineColor>-16777216</pd:lineColor>
                <pd:conditionType>always</pd:conditionType>
            </pd:transition>
            <pd:activity name="ARC_SendCDM2QueueOrTopic">
                <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
                <pd:resourceType>ae.process.subprocess</pd:resourceType>
                <pd:x>905</pd:x>
                <pd:y>281</pd:y>
                <config>
                    <processName>/Common/ARC/ARC_QueueOrTopic/ARC_SendCDM2QueueOrTopic.process</processName>
                    <processNameXPath>concat($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/GLB_mockRoot, "/Common/ARC/ARC_QueueOrTopic/ARC_SendCDM2QueueOrTopic.process")</processNameXPath>
                </config>
                <pd:inputBindings>
                    <IN_SendReply2QueueOrTopic>
                        <TargetName>
                            <xsl:value-of select="$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[$index]"/>
                        </TargetName>
                        <xsl:choose>
                            <xsl:when test="$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[$index]/@DestinationType='Topic'">
                                <IsTopic>
                                    <xsl:value-of select="1"/>
                                </IsTopic>
                            </xsl:when>
                            <xsl:otherwise>
                                <IsTopic>
                                    <xsl:value-of select="0"/>
                                </IsTopic>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[$index]/@DestinationType='Psi'">
                                <IsPsi>
                                    <xsl:value-of select="1"/>
                                </IsPsi>
                            </xsl:when>
                            <xsl:otherwise>
                                <IsPsi>
                                    <xsl:value-of select="0"/>
                                </IsPsi>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[$index]/@DestinationType='Upsilon'">
                                <IsUpsilon>
                                    <xsl:value-of select="1"/>
                                </IsUpsilon>
                            </xsl:when>
                            <xsl:otherwise>
                                <IsUpsilon>
                                    <xsl:value-of select="0"/>
                                </IsUpsilon>
                            </xsl:otherwise>
                        </xsl:choose>
                        <ns12:Message>
                            <ns12:ArchitectureHeader>
                                <ns12:AuditHeader>
                                    <ns12:E2EId>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EId"/>
                                    </ns12:E2EId>
                                    <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId">
                                        <ns12:ParentInstanceId>
                                            <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId"/>
                                        </ns12:ParentInstanceId>
                                    </xsl:if>
                                    <ns12:InstanceId>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:InstanceId"/>
                                    </ns12:InstanceId>
                                    <ns12:Deepness>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:Deepness"/>
                                    </ns12:Deepness>
                                    <ns12:ServiceId>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ServiceId"/>
                                    </ns12:ServiceId>
                                    <ns12:ServiceType>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ServiceType"/>
                                    </ns12:ServiceType>
                                    <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EControl">
                                        <ns12:E2EControl>
                                            <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EControl"/>
                                        </ns12:E2EControl>
                                    </xsl:if>
                                    <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EControl">
                                        <ns12:ParentE2EControl>
                                            <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EControl"/>
                                        </ns12:ParentE2EControl>
                                    </xsl:if>
                                </ns12:AuditHeader>
                                <xsl:if test="string(((tib:tokenize($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader, &quot;,&quot;)=$ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[$index]/@ServiceId)))=$_globalVariables/ns1:GlobalVariables/GeneralConstants/BooleanConstants/False&#xA;and&#xA;$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSParams/ListServicesNotSendECSHeader!=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/ALLServices&#xA;and&#xA;string-length($GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId)>0">
                                    <ns12:ECSHeader>
                                        <ns12:traceId>
                                            <xsl:value-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:traceId"/>
                                        </ns12:traceId>
                                        <xsl:if test="string-length($GetECSConfig/group/ns12:ECSConfig/ns12:namespace)>0">
                                            <ns12:parentSpan>
                                                <xsl:value-of select="concat($_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/NSToken,$GetECSConfig/group/ns12:ECSConfig/ns12:namespace,$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/MRSToken,$GetECSConfig/group/ns12:ECSConfig/ns12:mrId,$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ECSConstants/SpansToken,$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:spanId)"/>
                                            </ns12:parentSpan>
                                        </xsl:if>
                                        <ns12:spanId>
                                            <xsl:value-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:spanId"/>
                                        </ns12:spanId>
                                        <xsl:copy-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader/ns12:properties" copy-namespaces="no"/>
                                    </ns12:ECSHeader>
                                </xsl:if>
                                <xsl:copy-of select="$ARC_SaveContexts/ns12:ArchitectureHeader/ns12:RequestHeader"/>
                                <ns12:ErrorHeader>
                                    <ns12:IsError>
                                        <xsl:value-of select="0"/>
                                    </ns12:IsError>
                                </ns12:ErrorHeader>
                                <xsl:copy-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                                <xsl:copy-of select="$ARC_SaveContexts/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                            </ns12:ArchitectureHeader>
                            <ns12:Body>
                                <xsl:copy-of select="$Start/CDMMessage/Body/*"/>
                            </ns12:Body>
                        </ns12:Message>
                    </IN_SendReply2QueueOrTopic>
                </pd:inputBindings>
            </pd:activity>
        </pd:group>
    </pd:group>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>1145</pd:x>
        <pd:y>40</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Audit/GLB_End_Ok"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Audit"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="false()"/>
                    </isResponse>
                    <xsl:choose>
                        <xsl:when test="$Start/CDMMessage/ns12:TraceLevel">
                            <TraceLevel>
                                <xsl:value-of select="$Start/CDMMessage/ns12:TraceLevel"/>
                            </TraceLevel>
                        </xsl:when>
                        <xsl:otherwise>
                            <TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </TraceLevel>
                        </xsl:otherwise>
                    </xsl:choose>
                    <xsl:choose>
                        <xsl:when test="exists($index)">
                            <NameValue>
                                <Name>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GENERIC_E2E_NUM_CHILDS"/>
                                </Name>
                                <xsl:choose>
                                    <xsl:when test="count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType='Psi'|'Upsilon'])=1">
                                        <Value>
                                            <xsl:value-of select="($index)-1"/>
                                        </Value>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <Value>
                                            <xsl:value-of select="$index"/>
                                        </Value>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </NameValue>
                        </xsl:when>
                        <xsl:otherwise>
                            <NameValue>
                                <Name>
                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GENERIC_E2E_NUM_CHILDS"/>
                                </Name>
                                <Value>
                                    <xsl:value-of select="0"/>
                                </Value>
                            </NameValue>
                        </xsl:otherwise>
                    </xsl:choose>
                </CLETraceData>
                <Body>
                    <xsl:value-of select="tib:render-xml($Map-Data/ns12:Message)"/>
                </Body>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FindQueues">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>546</pd:x>
        <pd:y>279</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Queues/ARC_FindQueues.process</processName>
        </config>
        <pd:inputBindings>
            <FindQueuesIn>
                <xsl:for-each select="$Start/CDMMessage/TargetServices/Service">
                    <ServiceId>
                        <xsl:value-of select="."/>
                    </ServiceId>
                </xsl:for-each>
            </FindQueuesIn>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_SaveContexts">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>549</pd:x>
        <pd:y>39</pd:y>
        <config>
            <processName>/Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</processName>
        </config>
        <pd:inputBindings>
            <SaveContexts>
                <ns12:ArchitectureHeader>
                    <xsl:copy-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:AuditHeader"/>
                    <xsl:copy-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:ECSHeader"/>
                    <ns12:RequestHeader>
                        <xsl:choose>
                            <xsl:when test="string-length($Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/BBVAUser)>0">
                                <ns12:BBVAUser>
                                    <xsl:value-of select="$Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/BBVAUser"/>
                                </ns12:BBVAUser>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns12:BBVAUser>
                                    <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BBVAUser"/>
                                </ns12:BBVAUser>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="string-length($Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/ExternalId)>0">
                                <xsl:if test="$Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/ExternalId">
                                    <ns12:ExternalId>
                                        <xsl:value-of select="$Get-AdditionalArchitectureHeaderData/AdditionalArchitectureHeaderData/ExternalId"/>
                                    </ns12:ExternalId>
                                </xsl:if>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId">
                                    <ns12:ExternalId>
                                        <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId"/>
                                    </ns12:ExternalId>
                                </xsl:if>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:if test="string-length($Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId)>0">
                            <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId">
                                <ns12:BatchId>
                                    <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId"/>
                                </ns12:BatchId>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject)>0">
                            <xsl:if test="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject">
                                <ns12:BusinessObject>
                                    <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                                </ns12:BusinessObject>
                            </xsl:if>
                        </xsl:if>
                        <ns12:StartTimestamp>
                            <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:StartTimestamp"/>
                        </ns12:StartTimestamp>
                        <ns12:ServiceIdStarter>
                            <xsl:value-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ServiceIdStarter"/>
                        </ns12:ServiceIdStarter>
                    </ns12:RequestHeader>
                    <xsl:copy-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:ErrorHeader"/>
                    <xsl:copy-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:ReprocessingHeader"/>
                    <xsl:copy-of select="$Start/CDMMessage/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                    <xsl:copy-of select="$GetFunctionalHeader/FrameworkData/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                </ns12:ArchitectureHeader>
            </SaveContexts>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>204</pd:x>
        <pd:y>424</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>327</pd:x>
        <pd:y>464</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate Error">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>664</pd:x>
        <pd:y>464</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns:ActivityInput>
                <data>
                    <ns12:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <NativeErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </NativeErrorDescription>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="string-length($_error/ns2:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns2:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/CDMMessage)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </ns12:ErrorMessage>
                </data>
            </ns:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Generate-Error-1">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>549</pd:x>
        <pd:y>409</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns:ActivityInput>
                <data>
                    <ns12:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_SameTypeDestination"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/ErrorDescriptions/GLB_SameTypeDestinationDescription"/>
                        </ErrorDescription>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/CDMMessage)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </ns12:ErrorMessage>
                </data>
            </ns:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Get AdditionalArchitectureHeaderData">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>153</pd:x>
        <pd:y>38</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/AdditionalArchitectureHeaderData.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="GetFunctionalHeader">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>285</pd:x>
        <pd:y>40</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/Architecture Internal Data.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>912</pd:x>
        <pd:y>38</pd:y>
        <config>
            <element ref="ns12:Message"/>
        </config>
        <pd:inputBindings>
            <ns12:Message>
                <xsl:copy-of select="$ARC_SaveContexts/ns12:ArchitectureHeader"/>
                <ns12:Body>
                    <xsl:copy-of select="$Start/CDMMessage/Body/ancestor-or-self::*/namespace::node()"/>
                    <xsl:copy-of select="$Start/CDMMessage/Body/@*"/>
                    <xsl:copy-of select="$Start/CDMMessage/Body/node()"/>
                </ns12:Body>
            </ns12:Message>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>442</pd:x>
        <pd:y>416</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="GetECSConfig">
        <pd:type>com.tibco.pe.core.GetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.getSharedVariable</pd:resourceType>
        <pd:x>415</pd:x>
        <pd:y>40</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/ECSConfig.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>ARC_CLESenderAPI</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_SaveContexts</pd:from>
        <pd:to>ARC_FindQueues</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FindQueues</pd:from>
        <pd:to>JMS Transaction</pd:to>
        <pd:xpathDescription>All target services are the same type</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>(count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType="Psi"|"Upsilon"])&lt;=1)
and
(count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType="Queue"|"Psi"|"Upsilon"])=count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination) or 
count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination[@DestinationType="Topic"|"Psi"|"Upsilon"])=count($ARC_FindQueues/ns12:QueuesCacheList/ns12:Destination))</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>JMS Transaction</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FindQueues</pd:from>
        <pd:to>Generate-Error-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Map Data</pd:from>
        <pd:to>ARC_CLESenderAPI</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Get AdditionalArchitectureHeaderData</pd:from>
        <pd:to>GetFunctionalHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetFunctionalHeader</pd:from>
        <pd:to>GetECSConfig</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Get AdditionalArchitectureHeaderData</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_SaveContexts</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:xpathDescription>areServicesNull</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>exists($Start/CDMMessage/TargetServices/areServicesNull) and ($Start/CDMMessage/TargetServices/areServicesNull="true")</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>GetECSConfig</pd:from>
        <pd:to>ARC_SaveContexts</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>