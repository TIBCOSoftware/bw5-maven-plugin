<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:pfx111="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/ServiceParameters/SR/Schema.xsd" xmlns:pfx12="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:pfx11="http://www.bbva.com/EAIFramework" xmlns:pfx1="http://www.example.com/PROCESO_SINCRONO" xmlns:pfx10="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:UUID="java://EAIFramework.Processes.Private.Common.HeaderManagement.UUIDGenerator.UUIDGenerator" xmlns:pfx81="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Public/Resources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx5="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx31="http://www.tibco.com/schemas/AW_ArquitecturaComun/RecursosComunes/Esquemas/EsquemasArquitectura/AW_gestionErrores/Schema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx4="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx3="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Import Adapter/AsyncrhonousImporterSchema.xsd" xmlns:pfx2="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:pfx9="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/ASINC_IMP_CommonResources/Schemas/Schema.xsd" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/ASINC_IMP/ASINC_IMP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd2" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pfx51="http://www.tibco.com/ns/no_namespace_schema_location/SINC_CONS_RecursosComunes/Esquemas/XSD/Patron_Sincrono/ModeloComun/MLC/NM_MLC.xsd" xmlns:ns5="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions" xmlns:ns6="http://schemas.tibco.com/bw/plugins/jms/5.0/jmsExceptions" xmlns:ns31="http://www.tibco.com/pe/SignalInActivitySchema" xmlns:pfx="http://www.example.org/BBVACabecera" xmlns:pfx71="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/Schemas/SINC_SimpleService/Schema.xsd" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns3="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx21="http://xmlns.example.com/PROCESO_SINCRONO">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_EXPA/ARC_EXPA_Main.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="Input">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Message">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:any processContents="skip"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element ref="pfx11:ExportAdapterParameters"/>
                    <xsd:element ref="pfx11:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="pfx11:ECSServiceHeader" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>95</pd:startX>
    <pd:startY>114</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$FUN_EXPA_InboundFunctional/root/CDMContent/*"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endX>456</pd:endX>
    <pd:endY>114</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx11:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1292831516672</pd:targetNamespace>
    <pd:activity name="ARC_EXPA_Main">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>278</pd:x>
        <pd:y>114</pd:y>
        <config>
            <processName>/Common/ARC_EXPA/Internal/ARC_EXPA/ARC_EXPA_Main_Heavy.process</processName>
        </config>
        <pd:inputBindings>
            <Input>
                <xsl:copy-of select="$Start/Input/Message"/>
                <pfx11:ExportAdapterParameters>
                    <ProcessName>
                        <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/ProcessName"/>
                    </ProcessName>
                    <xsl:if test="string-length($Start/Input/pfx11:ExportAdapterParameters/BatchId)>0">
                        <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/BatchId">
                            <BatchId>
                                <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/BatchId"/>
                            </BatchId>
                        </xsl:if>
                    </xsl:if>
                    <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/IsE2EControl">
                        <IsE2EControl>
                            <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/IsE2EControl"/>
                        </IsE2EControl>
                    </xsl:if>
                    <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/IsLight">
                        <IsLight>
                            <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/IsLight"/>
                        </IsLight>
                    </xsl:if>
                    <xsl:choose>
                        <xsl:when test="exists($Start/Input/pfx11:ExportAdapterParameters/IsAdvanceRouting)">
                            <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/IsAdvanceRouting">
                                <IsAdvanceRouting>
                                    <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/IsAdvanceRouting"/>
                                </IsAdvanceRouting>
                            </xsl:if>
                        </xsl:when>
                        <xsl:otherwise/>
                    </xsl:choose>
                    <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/SaveMessage">
                        <SaveMessage>
                            <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/SaveMessage"/>
                        </SaveMessage>
                    </xsl:if>
                    <AdvancedRoutingParams>
                        <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/AdvancedRoutingParams/Timeout">
                            <Timeout>
                                <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/AdvancedRoutingParams/Timeout"/>
                            </Timeout>
                        </xsl:if>
                        <xsl:if test="$Start/Input/pfx11:ExportAdapterParameters/AdvancedRoutingParams/Target">
                            <Target>
                                <xsl:value-of select="$Start/Input/pfx11:ExportAdapterParameters/AdvancedRoutingParams/Target"/>
                            </Target>
                        </xsl:if>
                    </AdvancedRoutingParams>
                </pfx11:ExportAdapterParameters>
                <xsl:if test="$Start/Input/pfx11:TraceLevel">
                    <AuditLevel>
                        <xsl:value-of select="$Start/Input/pfx11:TraceLevel"/>
                    </AuditLevel>
                </xsl:if>
                <xsl:copy-of select="$Start/Input/pfx11:ECSServiceHeader"/>
            </Input>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>99</pd:x>
        <pd:y>239</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>203</pd:x>
        <pd:y>238</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_EXPA_Main</pd:to>
        <pd:xpathDescription/>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_EXPA_Main</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>