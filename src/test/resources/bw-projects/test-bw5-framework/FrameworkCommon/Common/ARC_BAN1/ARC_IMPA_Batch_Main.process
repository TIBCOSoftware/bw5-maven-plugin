    <pd:activity name="ARC_SaveContextAndUserJobVaraible">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>678</pd:x>
        <pd:y>410</pd:y>
        <config>
            <processName>/Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</processName>
        </config>
        <pd:inputBindings>
            <SaveContexts>
                <ns12:ArchitectureHeader>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:AuditHeader"/>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:ECSHeader"/>
                    <ns12:RequestHeader>
                        <ns12:BBVAUser>
                            <xsl:value-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BBVAUser"/>
                        </ns12:BBVAUser>
                        <xsl:if test="string-length($ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId)>0">
                            <xsl:if test="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId">
                                <ns12:ExternalId>
                                    <xsl:value-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId"/>
                                </ns12:ExternalId>
                            </xsl:if>
                        </xsl:if>
                        <xsl:choose>
                            <xsl:when test="$ARC_IAA_GenerateNewBatchId">
                                <ns12:BatchId>
                                    <xsl:value-of select="$ARC_IAA_GenerateNewBatchId/OUT_GenerateInternalNewBatchId/BatchId"/>
                                </ns12:BatchId>
                            </xsl:when>
                            <xsl:when test="$ARC_IMPA_GetBatchId-1">
                                <xsl:if test="$ARC_IMPA_GetBatchId-1/BatchId">
                                    <ns12:BatchId>
                                        <xsl:value-of select="$ARC_IMPA_GetBatchId-1/BatchId"/>
                                    </ns12:BatchId>
                                </xsl:if>
                            </xsl:when>
                            <xsl:otherwise>
                                <ns12:BatchId>
                                    <xsl:value-of select="$ARC_IMPA_GetBatchId/OUT_GetInternalBatchId/BatchId"/>
                                </ns12:BatchId>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:if test="string-length($ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject)>0">
                            <xsl:if test="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject">
                                <ns12:BusinessObject>
                                    <xsl:value-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                                </ns12:BusinessObject>
                            </xsl:if>
                        </xsl:if>
                        <ns12:StartTimestamp>
                            <xsl:value-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:StartTimestamp"/>
                        </ns12:StartTimestamp>
                        <ns12:ServiceIdStarter>
                            <xsl:value-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ServiceIdStarter"/>
                        </ns12:ServiceIdStarter>
                    </ns12:RequestHeader>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:ErrorHeader"/>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:ReprocessingHeader"/>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:SecurityHeader"/>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader/ns12:FunctionalData"/>
                </ns12:ArchitectureHeader>
            </SaveContexts>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IMPA_SendEndBatch">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>1043</pd:x>
        <pd:y>35</pd:y>
        <config>
            <processName>/Common/ARC/ARC_BatchN1/BatchAudit/ARC_IMPA_SendInternalEndBatch.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_IMPA_SendEndBatch>
                <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader"/>
                <xsl:choose>
                    <xsl:when test="$ARC_IAA_GenerateNewBatchId">
                        <BatchId>
                            <xsl:value-of select="$ARC_IAA_GenerateNewBatchId/OUT_GenerateInternalNewBatchId/BatchId"/>
                        </BatchId>
                    </xsl:when>
                    <xsl:otherwise>
                        <BatchId>
                            <xsl:value-of select="$ARC_IMPA_GetBatchId/OUT_GetInternalBatchId/BatchId"/>
                        </BatchId>
                    </xsl:otherwise>
                </xsl:choose>
                <ServiceId>
                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel">
                        <TraceLevel>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel"/>
                        </TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit">
                            <TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </TraceLevel>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
                <Body>
                    <xsl:copy-of select="$FUN_IAA_InboundFunctional/*"/>
                </Body>
                <xsl:choose>
                    <xsl:when test="$ARC_IAA_GenerateNewBatchId">
                        <TimeStampUUID>
                            <xsl:value-of select="$ARC_IAA_GenerateNewBatchId/OUT_GenerateInternalNewBatchId/TimeStampUUID"/>
                        </TimeStampUUID>
                    </xsl:when>
                    <xsl:otherwise>
                        <TimeStampUUID>
                            <xsl:value-of select="$ARC_IMPA_GetBatchId/OUT_GetInternalBatchId/TimeStampUUID"/>
                        </TimeStampUUID>
                    </xsl:otherwise>
                </xsl:choose>
            </ARC_IMPA_SendEndBatch>
        </pd:inputBindings>
    </pd:activity>
