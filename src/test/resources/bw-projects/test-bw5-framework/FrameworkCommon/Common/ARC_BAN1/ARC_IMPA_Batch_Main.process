    <pd:activity name="ARC_TrackingErrorManagement">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>771</pd:x>
        <pd:y>616</pd:y>
        <config>
            <processName>/Common/ARC/ARC_TrackingManagement/ARC_TrackingErrorManagement.process</processName>
        </config>
        <pd:inputBindings>
            <ns12:CLEMessage>
                <CLEHeader>
                    <E2EId>
                        <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EId"/>
                    </E2EId>
                    <E2EDeepness>
                        <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:Deepness+1"/>
                    </E2EDeepness>
                    <InvocationUser>
                        <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BBVAUser"/>
                    </InvocationUser>
                    <xsl:choose>
                        <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                            <EventCode>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                            </EventCode>
                        </xsl:when>
                        <xsl:otherwise>
                            <EventCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </EventCode>
                        </xsl:otherwise>
                    </xsl:choose>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error"/>
                    </EventType>
                    <Timestamp>
                        <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                    </Timestamp>
                    <xsl:choose>
                        <xsl:when test="string-length($ARC_GetServiceId)>0">
                            <ServiceId>
                                <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                            </ServiceId>
                        </xsl:when>
                        <xsl:otherwise>
                            <ServiceId>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_Generic_Object"/>
                            </ServiceId>
                        </xsl:otherwise>
                    </xsl:choose>
                    <InstanceId>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_InstancedIdNoInitialized"/>
                    </InstanceId>
                    <ProjectName>
                        <xsl:value-of select="$_processContext/ns1:ProcessContext/ProjectName"/>
                    </ProjectName>
                    <ProcessName>
                        <xsl:value-of select="BW:getCurrentProcessName($_processContext/ns1:ProcessContext/ProcessId)"/>
                    </ProcessName>
                    <EngineName>
                        <xsl:value-of select="$_processContext/ns1:ProcessContext/EngineName"/>
                    </EngineName>
                    <MachineName>
                        <xsl:value-of select="BW:getHostName()"/>
                    </MachineName>
                    <MessageHeader>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <xsl:choose>
                            <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                                <MessageType>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/MessageType"/>
                                </MessageType>
                            </xsl:when>
                            <xsl:otherwise>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </xsl:otherwise>
                        </xsl:choose>
                        <BusinessObject>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                        </BusinessObject>
                    </MessageHeader>
                    <AuditHeader>
                        <ParentInstanceId>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ParentInstanceId"/>
                        </ParentInstanceId>
                        <xsl:if test="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader">
                            <RetriesNumber>
                                <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader/ns12:RetriesNumber"/>
                            </RetriesNumber>
                        </xsl:if>
                        <xsl:if test="string-length($Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId)>0">
