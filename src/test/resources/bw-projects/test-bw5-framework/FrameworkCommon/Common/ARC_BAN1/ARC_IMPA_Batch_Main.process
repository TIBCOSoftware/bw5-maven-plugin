<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:pfx11="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx10="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:ns12="http://www.bbva.com/EAIFramework" xmlns:pfx="http://www.example.org/BBVACabecera" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns3="http://www.tibco.com/pe/DeployedVarsType" xmlns:pfx5="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx4="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Import Adapter/AsyncrhonousImporterSchema.xsd" xmlns:pfx2="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:pfx9="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/ASINC_IMP_CommonResources/Schemas/Schema.xsd" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/ASINC_IMP/ASINC_IMP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd2">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_BAN1/ARC_IMPA_Batch_Main.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="ARC_IMPA_Batch_Main_IN">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="ns12:Message"/>
                    <xsd:element ref="ns12:ImportAdapterParameters"/>
                    <xsd:element ref="ns12:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="ns12:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>31</pd:startX>
    <pd:startY>163</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$FUN_IAA_InboundFunctional/*"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:any processContents="skip"/>
    </pd:endType>
    <pd:endX>1207</pd:endX>
    <pd:endY>153</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns12:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1292831516672</pd:targetNamespace>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>769</pd:x>
        <pd:y>513</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <xsl:choose>
                        <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                            <EventCode>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                            </EventCode>
                        </xsl:when>
                        <xsl:otherwise>
                            <EventCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </EventCode>
                        </xsl:otherwise>
                    </xsl:choose>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="0"/>
                    </isResponse>
                    <TraceLevel>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_Trace"/>
                    </TraceLevel>
                </CLETraceData>
                <xsl:choose>
                    <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                            </ErrorCode>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/ErrorDescription">
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorDescription">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDate"/>
                            </ErrorDate>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/StackProcess">
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Severity"/>
                            </Severity>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/OriginalMessage">
                                <OriginalMessage>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/OriginalMessage"/>
                                </OriginalMessage>
                            </xsl:if>
                            <Category>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Category"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ProcessInputMessage"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/IsResponse"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/MessageType"/>
                            </MessageType>
                            <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/PreviousErrorMessage"/>
                            <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/FunctionalErrorData"/>
                        </ns12:ErrorMessage>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </ErrorCode>
                            <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                                <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                    <NativeErrorCode>
                                        <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                    </NativeErrorCode>
                                </xsl:if>
                            </xsl:if>
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                                <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                    <StackTrace>
                                        <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                    </StackTrace>
                                </xsl:if>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                            </ErrorDate>
                            <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                                <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                    <StackProcess>
                                        <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                    </StackProcess>
                                </xsl:if>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/ARC_IMPA_Batch_Main_IN/ns12:Message)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="tib:render-xml($Start/ARC_IMPA_Batch_Main_IN)"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="0"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                            </MessageType>
                        </ns12:ErrorMessage>
                    </xsl:otherwise>
                </xsl:choose>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FunctionalErrorValidation">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>811</pd:x>
        <pd:y>319</pd:y>
        <config>
            <processName>/Common/ARC/ARC_FunctionalErrorValidation/ARC_FunctionalErrorValidation.process</processName>
        </config>
        <pd:inputBindings>
            <root>
                <xsl:choose>
                    <xsl:when test="$_error_FUN_IAA_InboundFunctional/ns12:ErrorMessage">
                        <xsl:copy-of select="$_error_FUN_IAA_InboundFunctional/ns12:ErrorMessage"/>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:copy-of select="$_error_FUN_IMPA_Request2BackEnd/ns12:ErrorMessage"/>
                    </xsl:otherwise>
                </xsl:choose>
                <ErrorReport>
                    <xsl:copy-of select="$_error/ns1:ErrorReport/ancestor-or-self::*/namespace::node()"/>
                    <xsl:copy-of select="$_error/ns1:ErrorReport/@*"/>
                    <xsl:copy-of select="$_error/ns1:ErrorReport/node()"/>
                </ErrorReport>
            </root>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_GetServiceId">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
