                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel">
                        <TraceLevel>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel"/>
                        </TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_Critical">
