        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IAA_GenerateNewBatchId">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>666</pd:x>
        <pd:y>93</pd:y>
        <config>
            <processName>/Common/ARC/ARC_BatchN1/ARC_IMPA_GenerateNewBatchId/ARC_IMPA_GenerateInternalNewBatchId.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_IMPA_GenerateNewBatchId>
                <ServiceId>
                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel">
                        <Tracelevel>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel"/>
                        </Tracelevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit">
                            <Tracelevel>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </Tracelevel>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader"/>
                <Body>
                    <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message"/>
                </Body>
            </ARC_IMPA_GenerateNewBatchId>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IAA_PostGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>1121</pd:x>
        <pd:y>154</pd:y>
        <config>
            <processName>/Common/ARC_BAN1/PostActions/ARC_IMPA_PostGoingAction.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_IMPA_PostGoingAction_IN>
                <ns12:Message>
                    <xsl:copy-of select="$ARC_IAA_PreGoingAction/ns12:ArchitectureHeader"/>
                    <ns12:Body>
                        <xsl:copy-of select="$FUN_IAA_InboundFunctional/*"/>
                    </ns12:Body>
                </ns12:Message>
                <xsl:choose>
                    <xsl:when test="$ARC_IMPA_GetBatchId">
                        <BatchId>
                            <xsl:value-of select="$ARC_IMPA_GetBatchId/OUT_GetInternalBatchId/BatchId"/>
                        </BatchId>
                    </xsl:when>
                    <xsl:otherwise>
                        <BatchId>
                            <xsl:value-of select="$ARC_IAA_GenerateNewBatchId/OUT_GenerateInternalNewBatchId/BatchId"/>
                        </BatchId>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:if test="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit">
                            <ns12:TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </ns12:TraceLevel>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:if test="string-length($Start/ARC_IMPA_Batch_Main_IN/ns12:ECSConfig/ns12:namespace)>0">
                    <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:ECSConfig"/>
                </xsl:if>
            </ARC_IMPA_PostGoingAction_IN>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IAA_PreGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>329</pd:x>
        <pd:y>160</pd:y>
        <config>
            <processName>/Common/ARC_BAN1/PreActions/ARC_IMPA_PreGoingAction.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_IMPA_PreGoingAction_IN>
                <CDMMessage>
                    <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:ArchitectureHeader"/>
                    <Body>
                        <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:Body/ancestor-or-self::*/namespace::node()"/>
                        <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:Body/@*"/>
                        <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:Message/ns12:Body/node()"/>
                    </Body>
                </CDMMessage>
                <ServiceId>
                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:copy-of select="$Start/ARC_IMPA_Batch_Main_IN/ns12:ECSConfig"/>
            </ARC_IMPA_PreGoingAction_IN>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IMPA_GetBatchId">
