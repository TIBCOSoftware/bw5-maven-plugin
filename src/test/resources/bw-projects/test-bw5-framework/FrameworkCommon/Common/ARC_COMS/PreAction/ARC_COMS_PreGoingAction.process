<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd2" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/ASINC_IMP/ASINC_IMP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/ASINC_IMP_CommonResources/Schemas/Schema.xsd" xmlns:pfx9="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/ServiceParameters/SCS/Schema.xsd" xmlns:pfx="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx2="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:ns="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Public/Schemas/XSD/MCD/Schema.xsd" xmlns:pfx3="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:GetIP="java://EAIFramework.Processes.Private.Common.HeaderManagement.IPAddress.IPAddress" xmlns:pfx4="http://www.tibco.com/pe/WriteToLogActivitySchema" xmlns:pfx5="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns2="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns4="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns3="http://www.bbva.com/EAIFramework" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns5="pfx" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:pfx1="http://www.example.org/BBVACabecera" xmlns:pfx21="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:UUID="java://EAIFramework.Processes.Private.Common.HeaderManagement.UUIDGenerator.UUIDGenerator" xmlns:generate="java://EAIFramework.Processes.Private.Common.HeaderManagement.UIDGenerator.UIDGeneratorUIDGenerator" xmlns:pfx41="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns22="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:ns21="com/tibco/pe/commands" xmlns:pfx31="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Import Adapter/AsyncrhonousImporterSchema.xsd" xmlns:Inc="java://EAIFramework.Processes.Private.Common.HeaderManagement.Incrementator.Incrementator">
    
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_COMS/PreAction/ARC_COMS_PreGoingAction.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="CDMMessage">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element ref="ns3:ArchitectureHeader"/>
                                <xsd:element name="Body">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:any processContents="skip"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                    <xsd:element ref="ns3:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="ns3:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>65</pd:startX>
    <pd:startY>73</pd:startY>
    <pd:returnBindings>
        <group>
            <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns3:ArchitectureHeader"/>
            <StartServiceTimestamp>
                <xsl:value-of select="$Time/TimeStamp"/>
            </StartServiceTimestamp>
        </group>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="ns3:ArchitectureHeader"/>
                    <xsd:element name="StartServiceTimestamp" type="xsd:dateTime"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>963</pd:endX>
    <pd:endY>74</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns3:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <Time>
            <xsd:element name="TimeStamp" type="xsd:dateTime"/>
        </Time>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1324369888043</pd:targetNamespace>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>802</pd:x>
        <pd:y>74</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <EventCode>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Audit/GLB_Initial"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Audit"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="false()"/>
                    </isResponse>
                    <xsl:choose>
                        <xsl:when test="$Start/group/ns3:TraceLevel">
                            <TraceLevel>
                                <xsl:value-of select="$Start/group/ns3:TraceLevel"/>
                            </TraceLevel>
                        </xsl:when>
                        <xsl:otherwise>
                            <TraceLevel>
                                <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                            </TraceLevel>
                        </xsl:otherwise>
                    </xsl:choose>
                </CLETraceData>
                <Body>
                    <xsl:value-of select="tib:render-xml($Map-Data/ns3:Message)"/>
                </Body>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FrameworkHeaderManagement">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>282</pd:x>
        <pd:y>72</pd:y>
        <config>
            <processName>/Common/ARC/ARC_HeaderManagement/ARC_FrameworkHeaderManagement.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_FHM_IN>
                <xsl:copy-of select="$Start/group/CDMMessage/ns3:ArchitectureHeader"/>
                <ServiceId>
                    <xsl:value-of select="$Start/group/ServiceId"/>
                </ServiceId>
                <ServiceType>
                    <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_ComposedService"/>
                </ServiceType>
                <StarTimestamp>
                    <xsl:value-of select="$Time/TimeStamp"/>
                </StarTimestamp>
                <E2EControl>
                    <xsl:value-of select="false()"/>
                </E2EControl>
                <xsl:if test="string-length($Start/group/ns3:ECSConfig/ns3:namespace)>0">
                    <ns3:ECSServiceHeader>
                        <ns3:namespace>
                            <xsl:value-of select="$Start/group/ns3:ECSConfig/ns3:namespace"/>
                        </ns3:namespace>
                        <ns3:mrId>
                            <xsl:value-of select="$Start/group/ns3:ECSConfig/ns3:mrId"/>
                        </ns3:mrId>
                        <ns3:genMetrics>
                            <xsl:value-of select="$Start/group/ns3:ECSConfig/ns3:genMetrics"/>
                        </ns3:genMetrics>
                        <xsl:copy-of select="$Start/group/ns3:ECSConfig/ns3:properties"/>
                    </ns3:ECSServiceHeader>
                </xsl:if>
            </ARC_FHM_IN>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_SaveContexts">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>505</pd:x>
        <pd:y>75</pd:y>
        <config>
            <processName>/Common/ARC/ARC_SaveContextAndUserJobVaraible/ARC_SaveContextAndUserJobVaraible.process</processName>
        </config>
        <pd:inputBindings>
            <SaveContexts>
                <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns3:ArchitectureHeader"/>
                <InvocationsNumber>
                    <xsl:value-of select="0"/>
                </InvocationsNumber>
                <xsl:choose>
                    <xsl:when test="$Start/group/ns3:TraceLevel &lt;= $_globalVariables/ns2:GlobalVariables/GeneralConstants/TraceLevels/GLB_Trace">
                        <SaveMessage>
                            <xsl:value-of select="false()"/>
                        </SaveMessage>
                    </xsl:when>
                    <xsl:otherwise>
                        <SaveMessage>
                            <xsl:value-of select="true()"/>
                        </SaveMessage>
                    </xsl:otherwise>
                </xsl:choose>
            </SaveContexts>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>215</pd:x>
        <pd:y>199</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>217</pd:x>
        <pd:y>315</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate Error">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>568</pd:x>
        <pd:y>315</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx3:ActivityInput>
                <data>
                    <ns3:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Severities/GLB_FatalError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/group)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </ns3:ErrorMessage>
                </data>
            </pfx3:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>384</pd:x>
        <pd:y>191</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="TimeStamp">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>165</pd:x>
        <pd:y>71</pd:y>
        <config>
            <variableName>Time</variableName>
        </config>
        <pd:inputBindings>
            <TimeStamp>
                <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
            </TimeStamp>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>393</pd:x>
        <pd:y>75</pd:y>
        <config>
            <element ref="ns3:Message"/>
        </config>
        <pd:inputBindings>
            <ns3:Message>
                <xsl:copy-of select="$ARC_FrameworkHeaderManagement/ns3:ArchitectureHeader"/>
                <ns3:Body>
                    <xsl:copy-of select="$Start/group/CDMMessage/Body/*"/>
                </ns3:Body>
            </ns3:Message>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="SetServiceTraceAudit">
        <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
        <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
        <pd:x>654</pd:x>
        <pd:y>76</pd:y>
        <config>
            <variableConfig>/SharedResources/JobSharedVariables/TraceAuditData.jobsharedvariable</variableConfig>
        </config>
        <pd:inputBindings>
            <TraceAuditData>
                <xsl:choose>
                    <xsl:when test="$Start/group/ns3:TraceLevel">
                        <ns3:TraceLevel>
                            <xsl:value-of select="$Start/group/ns3:TraceLevel"/>
                        </ns3:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns3:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns2:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns3:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
            </TraceAuditData>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>TimeStamp</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>TimeStamp</pd:from>
        <pd:to>ARC_FrameworkHeaderManagement</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FrameworkHeaderManagement</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Map Data</pd:from>
        <pd:to>ARC_SaveContexts</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_CLESenderAPI</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_SaveContexts</pd:from>
        <pd:to>SetServiceTraceAudit</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>SetServiceTraceAudit</pd:from>
        <pd:to>ARC_CLESenderAPI</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>