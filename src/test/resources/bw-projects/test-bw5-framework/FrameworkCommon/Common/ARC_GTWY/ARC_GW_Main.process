<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pfx="http://www.bbva.com/EAIFramework" xmlns:pfx2="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns="http://www.tibco.com/pe/EngineTypes" xmlns:pfx3="http://www.tibco.com/pe/WriteToLogActivitySchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://www.tibco.com/pe/SignalInActivitySchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:UUID="java://Framework.CommonResources.CustomFunctions.UUIDGenerator.UUIDGenerator">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_GTWY/ARC_GW_Main.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="AdapterParameters">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element name="Parameters">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="ProcessName" type="xsd:string"/>
                                <xsd:element name="JMSReplyTo" type="xsd:string"/>
                                <xsd:element name="JMSCorrelationId" type="xsd:string"/>
                                <xsd:element name="IsE2EControl" type="xsd:boolean" minOccurs="0"/>
                                <xsd:element name="OrchestrationService" minOccurs="0">
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="OrchestrationServiceId" type="xsd:string"/>
                                            <xsd:element name="JMSInputOrchestrationDestination" type="xsd:string" minOccurs="0"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                    <xsd:element ref="pfx:Message"/>
                    <xsd:element ref="pfx:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="pfx:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>39</pd:startX>
    <pd:startY>218</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>1293</pd:endX>
    <pd:endY>229</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1380098109578</pd:targetNamespace>
    <pd:activity name="ARC_GW_PostGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>1167</pd:x>
        <pd:y>231</pd:y>
        <config>
            <processName>/Common/ARC_GTWY/PostActions/ARC_GW_PostGoingAction.process</processName>
        </config>
        <pd:inputBindings>
            <CDMMessage>
                <pfx:Message>
                    <pfx:ArchitectureHeader>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:AuditHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:ECSHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:RequestHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:ErrorHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:ReprocessingHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:SecurityHeader"/>
                        <xsl:choose>
                            <xsl:when test="$ARC_ORC_Basic">
                                <xsl:copy-of select="$ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:RoutingHeader"/>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:FunctionalData"/>
                    </pfx:ArchitectureHeader>
                    <xsl:choose>
                        <xsl:when test="count($ARC_GW_SendMessegeToServiceList/OUT_SendMessage/pfx:Message/pfx:Body)>0">
                            <xsl:copy-of select="$ARC_GW_SendMessegeToServiceList/OUT_SendMessage/pfx:Message/pfx:Body"/>
                        </xsl:when>
                        <xsl:when test="count($ARC_GW_SendToOrchestratorService/OUTPUT_SendMessage/pfx:Message/pfx:Body)>0">
                            <xsl:copy-of select="$ARC_GW_SendToOrchestratorService/OUTPUT_SendMessage/pfx:Message/pfx:Body"/>
                        </xsl:when>
                        <xsl:when test="count($ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:Body)>0">
                            <xsl:copy-of select="$ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:Body"/>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:Body"/>
                        </xsl:otherwise>
                    </xsl:choose>
                </pfx:Message>
                <xsl:choose>
                    <xsl:when test="$Start/AdapterParameters/pfx:TraceLevel">
                        <xsl:if test="$Start/AdapterParameters/pfx:TraceLevel">
                            <pfx:TraceLevel>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:TraceLevel"/>
                            </pfx:TraceLevel>
                        </xsl:if>
                    </xsl:when>
                    <xsl:otherwise>
                        <pfx:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </pfx:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
            </CDMMessage>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_GetServiceId">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>126</pd:x>
        <pd:y>222</pd:y>
        <config>
            <processName>/Common/ARC/ARC_ServiceIdManagement/ARC_GetServiceId.process</processName>
        </config>
        <pd:inputBindings>
            <pathGetCurrentProcess>
                <xsl:value-of select="$Start/AdapterParameters/Parameters/ProcessName"/>
            </pathGetCurrentProcess>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_GW_PreGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>257</pd:x>
        <pd:y>220</pd:y>
        <config>
            <processName>/Common/ARC_GTWY/PreActions/ARC_GW_PreGoingAction.process</processName>
            <processNameXPath/>
        </config>
        <pd:inputBindings>
            <group>
                <CDMMessage>
                    <pfx:ArchitectureHeader>
                        <pfx:AuditHeader>
                            <pfx:E2EId>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:E2EId"/>
                            </pfx:E2EId>
                            <pfx:ParentInstanceId>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ParentInstanceId"/>
                            </pfx:ParentInstanceId>
                            <pfx:InstanceId>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:InstanceId"/>
                            </pfx:InstanceId>
                            <pfx:Deepness>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:Deepness"/>
                            </pfx:Deepness>
                            <pfx:ServiceId>
                                <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                            </pfx:ServiceId>
                            <pfx:ServiceType>
                                <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_RoutingGatewayAdapter"/>
                            </pfx:ServiceType>
                            <xsl:choose>
                                <xsl:when test="string-length($Start/AdapterParameters/Parameters/IsE2EControl)>0">
                                    <pfx:E2EControl>
                                        <xsl:value-of select="$Start/AdapterParameters/Parameters/IsE2EControl"/>
                                    </pfx:E2EControl>
                                </xsl:when>
                                <xsl:otherwise>
                                    <pfx:E2EControl>
                                        <xsl:value-of select="false()"/>
                                    </pfx:E2EControl>
                                </xsl:otherwise>
                            </xsl:choose>
                            <xsl:choose>
                                <xsl:when test="string-length($Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ParentE2EControl)>0">
                                    <pfx:ParentE2EControl>
                                        <xsl:value-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ParentE2EControl"/>
                                    </pfx:ParentE2EControl>
                                </xsl:when>
                                <xsl:otherwise>
                                    <pfx:ParentE2EControl>
                                        <xsl:value-of select="false()"/>
                                    </pfx:ParentE2EControl>
                                </xsl:otherwise>
                            </xsl:choose>
                        </pfx:AuditHeader>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:ECSHeader"/>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RequestHeader"/>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:ErrorHeader"/>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:ReprocessingHeader"/>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:SecurityHeader"/>
                        <pfx:RoutingHeader>
                            <pfx:Origin>
                                <pfx:Services>
                                    <xsl:copy-of select="$Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Origin/pfx:Services/pfx:Service"/>
                                    <xsl:choose>
                                        <xsl:when test="$Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ServiceType=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_ChannelAdapter">
                                            <pfx:Service>
                                                <pfx:ServiceId>
                                                    <xsl:value-of select="$Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ServiceId"/>
                                                </pfx:ServiceId>
                                                <pfx:JMSInputDestinationName>
                                                    <xsl:value-of select="$Start/AdapterParameters/Parameters/JMSReplyTo"/>
                                                </pfx:JMSInputDestinationName>
                                                <pfx:JMSInputDestinationType>
                                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_Generic_Queue_Key"/>
                                                </pfx:JMSInputDestinationType>
                                                <pfx:ServiceType>
                                                    <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_ChannelAdapter"/>
                                                </pfx:ServiceType>
                                            </pfx:Service>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <pfx:Service>
                                                <pfx:ServiceId>
                                                    <xsl:value-of select="$Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ServiceId"/>
                                                </pfx:ServiceId>
                                                <pfx:ServiceType>
                                                    <xsl:value-of select="$Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ServiceType"/>
                                                </pfx:ServiceType>
                                            </pfx:Service>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                    <pfx:Service>
                                        <pfx:ServiceId>
                                            <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                                        </pfx:ServiceId>
                                        <pfx:ServiceType>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_RoutingGatewayAdapter"/>
                                        </pfx:ServiceType>
                                    </pfx:Service>
                                </pfx:Services>
                            </pfx:Origin>
                            <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target"/>
                        </pfx:RoutingHeader>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:FunctionalData"/>
                    </pfx:ArchitectureHeader>
                    <Body>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:Body/*"/>
                    </Body>
                </CDMMessage>
                <ServiceId>
                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/AdapterParameters/pfx:TraceLevel">
                        <xsl:if test="$Start/AdapterParameters/pfx:TraceLevel">
                            <pfx:TraceLevel>
                                <xsl:value-of select="$Start/AdapterParameters/pfx:TraceLevel"/>
                            </pfx:TraceLevel>
                        </xsl:if>
                    </xsl:when>
                    <xsl:otherwise>
                        <pfx:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </pfx:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:copy-of select="$Start/AdapterParameters/pfx:ECSConfig"/>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>440</pd:x>
        <pd:y>1</pd:y>
        <pd:width>661</pd:width>
        <pd:height>440</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>simpleGroup</pd:groupType>
            <pd:serializable>false</pd:serializable>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>ARC_GW_SendMessegeToServiceList</pd:to>
            <pd:xpathDescription>publish</pd:xpathDescription>
            <pd:lineType>Multiple Bends</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>count($Start/AdapterParameters/pfx:Message[last()]/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target)&gt;0</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Null</pd:to>
            <pd:lineType>Multiple Bends</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>otherwise</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_GW_SendMessegeToServiceList</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Multiple Bends</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_GW_SendToOrchestratorService</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_ORC_Basic</pd:from>
            <pd:to>end</pd:to>
            <pd:xpathDescription>no TargetServices from embebed</pd:xpathDescription>
            <pd:lineType>Multiple Bends</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>count($ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service)=0</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>Null</pd:from>
            <pd:to>ARC_GW_SendToOrchestratorService</pd:to>
            <pd:xpathDescription>to_gw</pd:xpathDescription>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>count($Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId) &gt;0 and $Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:ServiceType!=$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_OrchestrationAdapter</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>Null</pd:from>
            <pd:to>ARC_ORC_Basic</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>otherwise</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>ARC_ORC_Basic</pd:from>
            <pd:to>ARC_GW_SendMessegeToServiceList</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>otherwise</pd:conditionType>
        </pd:transition>
        <pd:activity name="ARC_GW_SendMessegeToServiceList">
            <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
            <pd:resourceType>ae.process.subprocess</pd:resourceType>
            <pd:x>628</pd:x>
            <pd:y>360</pd:y>
            <config>
                <spawn>false</spawn>
                <customId/>
                <processNameXPath/>
                <processName>/Common/ARC/ARC_QueueOrTopic/ARC_SendMessageToServiceSync.process</processName>
            </config>
            <pd:inputBindings>
                <IN_SendMessage>
                    <ServicesType>
                        <ServiceType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_SimpleService"/>
                        </ServiceType>
                        <ServiceType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_ComposedService"/>
                        </ServiceType>
                    </ServicesType>
                    <xsl:choose>
                        <xsl:when test="count($Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId)>0">
                            <OrchestrationService>
                                <OrchestrationServiceId>
                                    <xsl:value-of select="$Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId"/>
                                </OrchestrationServiceId>
                                <xsl:if test="count($Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination)>0">
                                    <xsl:if test="$Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination">
                                        <JMSInputDestinationId>
                                            <xsl:value-of select="$Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination"/>
                                        </JMSInputDestinationId>
                                    </xsl:if>
                                </xsl:if>
                            </OrchestrationService>
                        </xsl:when>
                        <xsl:otherwise>
                            <OrchestrationService>
                                <OrchestrationServiceId>
                                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                                </OrchestrationServiceId>
                                <JMSInputDestinationId>
                                    <xsl:value-of select="$GetGWQueue/pfx:Destination"/>
                                </JMSInputDestinationId>
                            </OrchestrationService>
                        </xsl:otherwise>
                    </xsl:choose>
                    <Body>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:Body/*"/>
                    </Body>
                    <xsl:choose>
                        <xsl:when test="count($Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service)>0">
                            <TargetServices>
                                <xsl:for-each select="$Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service">
                                    <pfx:RoutingService>
                                        <pfx:ServiceId>
                                            <xsl:value-of select="current()/pfx:ServiceId"/>
                                        </pfx:ServiceId>
                                        <xsl:if test="count(pfx:JMSInputDestinationName)>0">
                                            <xsl:if test="pfx:JMSInputDestinationName">
                                                <pfx:JMSInputDestinationName>
                                                    <xsl:value-of select="pfx:JMSInputDestinationName"/>
                                                </pfx:JMSInputDestinationName>
                                            </xsl:if>
                                        </xsl:if>
                                        <xsl:if test="count(pfx:JMSInputDestinationType)>0">
                                            <xsl:if test="pfx:JMSInputDestinationType">
                                                <pfx:JMSInputDestinationType>
                                                    <xsl:value-of select="pfx:JMSInputDestinationType"/>
                                                </pfx:JMSInputDestinationType>
                                            </xsl:if>
                                        </xsl:if>
                                        <pfx:ServiceType>
                                            <xsl:value-of select="current()/pfx:ServiceType"/>
                                        </pfx:ServiceType>
                                    </pfx:RoutingService>
                                </xsl:for-each>
                            </TargetServices>
                        </xsl:when>
                        <xsl:when test="count($ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service)>0">
                            <TargetServices>
                                <xsl:for-each select="$ARC_ORC_Basic/OUT_Process/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service">
                                    <pfx:RoutingService>
                                        <pfx:ServiceId>
                                            <xsl:value-of select="current()/pfx:ServiceId"/>
                                        </pfx:ServiceId>
                                        <xsl:if test="count(pfx:JMSInputDestinationName)>0">
                                            <xsl:if test="pfx:JMSInputDestinationName">
                                                <pfx:JMSInputDestinationName>
                                                    <xsl:value-of select="pfx:JMSInputDestinationName"/>
                                                </pfx:JMSInputDestinationName>
                                            </xsl:if>
                                        </xsl:if>
                                        <xsl:if test="count(pfx:JMSInputDestinationType)>0">
                                            <xsl:if test="pfx:JMSInputDestinationType">
                                                <pfx:JMSInputDestinationType>
                                                    <xsl:value-of select="pfx:JMSInputDestinationType"/>
                                                </pfx:JMSInputDestinationType>
                                            </xsl:if>
                                        </xsl:if>
                                        <pfx:ServiceType>
                                            <xsl:value-of select="current()/pfx:ServiceType"/>
                                        </pfx:ServiceType>
                                    </pfx:RoutingService>
                                </xsl:for-each>
                            </TargetServices>
                        </xsl:when>
                    </xsl:choose>
                    <xsl:if test="count($Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader/pfx:E2EControl)>0 or string-length($Start/AdapterParameters/Parameters/JMSCorrelationId) >0">
                        <UpdateHeaderParameters>
                            <xsl:if test="string-length($Start/AdapterParameters/Parameters/IsE2EControl)>0">
                                <xsl:if test="$Start/AdapterParameters/Parameters/IsE2EControl">
                                    <ControlE2E>
                                        <xsl:value-of select="$Start/AdapterParameters/Parameters/IsE2EControl"/>
                                    </ControlE2E>
                                </xsl:if>
                            </xsl:if>
                            <JMSGWReplyTo>
                                <xsl:value-of select="$GetGWQueue/pfx:Destination"/>
                            </JMSGWReplyTo>
                            <JMSHeadersParameters>
                                <xsl:if test="string-length($Start/AdapterParameters/Parameters/JMSCorrelationId) >0">
                                    <JMSCorrelationID>
                                        <xsl:value-of select="$Start/AdapterParameters/Parameters/JMSCorrelationId"/>
                                    </JMSCorrelationID>
                                </xsl:if>
                            </JMSHeadersParameters>
                        </UpdateHeaderParameters>
                    </xsl:if>
                </IN_SendMessage>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="ARC_GW_SendToOrchestratorService">
            <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
            <pd:resourceType>ae.process.subprocess</pd:resourceType>
            <pd:x>966</pd:x>
            <pd:y>67</pd:y>
            <config>
                <processName>/Common/ARC/ARC_QueueOrTopic/ARC_SendMessageHeaderCount.process</processName>
                <spawn>false</spawn>
                <customId/>
                <processNameXPath/>
            </config>
            <pd:inputBindings>
                <ARC_REQS_Main_IN>
                    <Body>
                        <xsl:copy-of select="$Start/AdapterParameters/pfx:Message/pfx:Body/*"/>
                    </Body>
                    <xsl:if test="$GetGWQueue/pfx:Destination">
                        <JMsReplyTo>
                            <xsl:value-of select="$GetGWQueue/pfx:Destination"/>
                        </JMsReplyTo>
                    </xsl:if>
                    <JMSCorrelationId>
                        <xsl:value-of select="$Start/AdapterParameters/Parameters/JMSCorrelationId"/>
                    </JMSCorrelationId>
                    <Service>
                        <xsl:choose>
                            <xsl:when test="count($Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination)>0">
                                <JMSDestination>
                                    <xsl:value-of select="$Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination"/>
                                </JMSDestination>
                            </xsl:when>
                            <xsl:otherwise>
                                <ServiceId>
                                    <xsl:value-of select="$Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId"/>
                                </ServiceId>
                            </xsl:otherwise>
                        </xsl:choose>
                        <ServiceType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_OrchestrationAdapter"/>
                        </ServiceType>
                    </Service>
                    <TimeOut>
                        <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/CFG/ARCHITECTURE/TIMEOUT/CFG_Timeout"/>
                    </TimeOut>
                    <Sync>
                        <xsl:value-of select="false()"/>
                    </Sync>
                    <UpdateHeaderParameters>
                        <xsl:if test="string-length($Start/AdapterParameters/Parameters/IsE2EControl)>0">
                            <xsl:if test="$Start/AdapterParameters/Parameters/IsE2EControl">
                                <ControlE2E>
                                    <xsl:value-of select="$Start/AdapterParameters/Parameters/IsE2EControl"/>
                                </ControlE2E>
                            </xsl:if>
                        </xsl:if>
                        <ActiveHeaderNonCompatibility>
                            <xsl:value-of select="true()"/>
                        </ActiveHeaderNonCompatibility>
                    </UpdateHeaderParameters>
                </ARC_REQS_Main_IN>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Null">
            <pd:type>com.tibco.plugin.timer.NullActivity</pd:type>
            <pd:resourceType>ae.activities.null</pd:resourceType>
            <pd:x>631</pd:x>
            <pd:y>66</pd:y>
            <config/>
            <pd:inputBindings/>
        </pd:activity>
        <pd:activity name="ARC_ORC_Basic">
            <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
