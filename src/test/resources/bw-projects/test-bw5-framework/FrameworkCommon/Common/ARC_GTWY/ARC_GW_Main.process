                        <pfx:ErrorHeader>
                            <pfx:IsError>
                                <xsl:value-of select="1"/>
                            </pfx:IsError>
                            <xsl:choose>
                                <xsl:when test="string-length($Catch-Error-Message)>0">
                                    <pfx:ErrorMessage>
                                        <ErrorCode>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/ErrorCode"/>
                                        </ErrorCode>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/ErrorDescription">
                                            <ErrorDescription>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/ErrorDescription"/>
                                            </ErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/NativeErrorCode">
                                            <NativeErrorCode>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/NativeErrorCode"/>
                                            </NativeErrorCode>
                                        </xsl:if>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/NativeErrorDescription">
                                            <NativeErrorDescription>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/NativeErrorDescription"/>
                                            </NativeErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/StackTrace">
                                            <StackTrace>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/StackTrace"/>
                                            </StackTrace>
                                        </xsl:if>
                                        <ErrorDate>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/ErrorDate"/>
                                        </ErrorDate>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/StackProcess">
                                            <StackProcess>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/StackProcess"/>
                                            </StackProcess>
                                        </xsl:if>
                                        <Severity>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/Severity"/>
                                        </Severity>
                                        <xsl:if test="$Catch-Error-Message/pfx:ErrorMessage/OriginalMessage">
                                            <OriginalMessage>
                                                <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/OriginalMessage"/>
                                            </OriginalMessage>
                                        </xsl:if>
                                        <Category>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/Category"/>
                                        </Category>
                                        <ProcessInputMessage>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/ProcessInputMessage"/>
                                        </ProcessInputMessage>
                                        <IsResponse>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/IsResponse"/>
