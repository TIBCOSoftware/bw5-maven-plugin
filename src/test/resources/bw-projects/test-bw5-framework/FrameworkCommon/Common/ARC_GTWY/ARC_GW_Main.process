    <pd:activity name="NotifySyncParents">
        <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
        <pd:resourceType>ae.activities.log</pd:resourceType>
        <pd:x>384</pd:x>
        <pd:y>606</pd:y>
        <config>
            <role>User</role>
        </config>
        <pd:inputBindings>
            <pfx3:ActivityInput>
                <message>
                    <xsl:value-of select="concat(&quot; GW sync service  starter. Publishing back response: &quot;,$_processContext/ns:ProcessContext/ProcessId)"/>
                </message>
            </pfx3:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="LogFatalError">
        <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
        <pd:resourceType>ae.activities.log</pd:resourceType>
        <pd:x>239</pd:x>
        <pd:y>603</pd:y>
        <config>
            <role>User</role>
        </config>
        <pd:inputBindings>
            <pfx3:ActivityInput>
                <message>
                    <xsl:value-of select="concat(&quot;GW Fatal Error. Not recoverable:&quot;,$_processContext/ns:ProcessContext/ProcessId,&quot;\n trackinfo: &quot;,$Catch-Error-Message/pfx:ErrorMessage/StackTrace)"/>
                </message>
            </pfx3:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FindQueue">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>523</pd:x>
        <pd:y>697</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Queues/ARC_FindQueue.process</processName>
        </config>
        <pd:inputBindings>
            <FindQueueIn>
                <ServiceId>
                    <xsl:value-of select="$Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId"/>
                </ServiceId>
            </FindQueueIn>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch group Message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>67</pd:x>
        <pd:y>335</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <fault>localname=group</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="GetGWQueue">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>374</pd:x>
        <pd:y>219</pd:y>
        <config>
            <processName>/Common/ARC/ARC_Queues/ARC_FindQueue.process</processName>
        </config>
        <pd:inputBindings>
            <FindQueueIn>
                <ServiceId>
                    <xsl:value-of select="$ARC_GetServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
            </FindQueueIn>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>ARC_GW_PostGoingAction</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_GetServiceId</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>ARC_GW_PostGoingAction</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_GetServiceId</pd:from>
        <pd:to>ARC_GW_PreGoingAction</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_CLESenderAPI</pd:from>
        <pd:to>Generate by ARC_IMPA</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Get Framework Context</pd:from>
        <pd:to>LogFatalError</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-65485</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_TrackingErrorManagement</pd:from>
        <pd:to>Generate by ARC_IMPA 1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_SendReturnSyncMsg</pd:from>
        <pd:to>ARC_CLESenderAPI</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Get Framework Context</pd:from>
        <pd:to>ARC_CLESenderAPI</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Get Framework Context</pd:from>
        <pd:to>NotifySyncParents</pd:to>
        <pd:xpathDescription>error</pd:xpathDescription>
        <pd:lineType>Multiple Bends</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>string-length($Start/AdapterParameters/Parameters/JMSReplyTo)&gt;0 or ( count($Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service) &gt; 0 and ( string-length($Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId)&gt;0  or  string-length($Start/AdapterParameters/Parameters/OrchestrationService/JMSInputOrchestrationDestination)&gt;0  ))</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>LogError</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>LogError</pd:from>
        <pd:to>Get Framework Context</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Error Message</pd:from>
        <pd:to>LogError</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>LogFatalError</pd:from>
        <pd:to>ARC_TrackingErrorManagement</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>NotifySyncParents</pd:from>
        <pd:to>ARC_SendReturnSyncMsg</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>NotifySyncParents</pd:from>
        <pd:to>ARC_FindQueue</pd:to>
        <pd:xpathDescription>OrchestrationService</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>count($Start/AdapterParameters/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service) &gt; 0 and string-length($Start/AdapterParameters/Parameters/OrchestrationService/OrchestrationServiceId)&gt;0</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_FindQueue</pd:from>
        <pd:to>ARC_SendReturnSyncMsg</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch group Message</pd:from>
        <pd:to>LogError</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_GW_PreGoingAction</pd:from>
        <pd:to>GetGWQueue</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>GetGWQueue</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>