                                        <MessageType>
                                            <xsl:value-of select="$Catch-Error-Message/pfx:ErrorMessage/MessageType"/>
                                        </MessageType>
                                        <xsl:copy-of select="$Catch-Error-Message/pfx:ErrorMessage/PreviousErrorMessage"/>
                                        <xsl:copy-of select="$Catch-Error-Message/pfx:ErrorMessage/FunctionalErrorData"/>
                                    </pfx:ErrorMessage>
                                </xsl:when>
                                <xsl:when test="string-length($Catch-group-Message/group/pfx:ErrorMessage) > 0">
                                    <pfx:ErrorMessage>
                                        <ErrorCode>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/ErrorCode"/>
                                        </ErrorCode>
                                        <ErrorDescription>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/ErrorDescription"/>
                                        </ErrorDescription>
                                        <NativeErrorCode>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/NativeErrorCode"/>
                                        </NativeErrorCode>
                                        <NativeErrorDescription>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/NativeErrorDescription"/>
                                        </NativeErrorDescription>
                                        <StackTrace>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/StackTrace"/>
                                        </StackTrace>
                                        <ErrorDate>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/ErrorDate"/>
                                        </ErrorDate>
                                        <StackProcess>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/StackProcess"/>
                                        </StackProcess>
                                        <Severity>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/Severity"/>
                                        </Severity>
                                        <OriginalMessage>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/OriginalMessage"/>
                                        </OriginalMessage>
                                        <Category>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/Category"/>
                                        </Category>
                                        <ProcessInputMessage>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/ProcessInputMessage"/>
                                        </ProcessInputMessage>
                                        <IsResponse>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/IsResponse"/>
                                        </IsResponse>
                                        <MessageType>
                                            <xsl:value-of select="$Catch-group-Message/group/pfx:ErrorMessage/MessageType"/>
                                        </MessageType>
                                        <xsl:copy-of select="$Catch-group-Message/group/pfx:ErrorMessage/PreviousErrorMessage"/>
                                        <xsl:copy-of select="$Catch-group-Message/group/pfx:ErrorMessage/FunctionalErrorData"/>
                                    </pfx:ErrorMessage>
                                </xsl:when>
                                <xsl:otherwise>
                                    <pfx:ErrorMessage>
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                        </ErrorCode>
                                        <ErrorDescription>
                                            <xsl:value-of select="$_error/ns:ErrorReport/Msg"/>
                                        </ErrorDescription>
                                        <xsl:if test="$_error/ns:ErrorReport/MsgCode">
                                            <NativeErrorCode>
                                                <xsl:value-of select="$_error/ns:ErrorReport/MsgCode"/>
                                            </NativeErrorCode>
                                        </xsl:if>
                                        <xsl:if test="$_error/ns:ErrorReport/Msg">
                                            <NativeErrorDescription>
                                                <xsl:value-of select="$_error/ns:ErrorReport/Msg"/>
                                            </NativeErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="$_error/ns:ErrorReport/StackTrace">
                                            <StackTrace>
                                                <xsl:value-of select="$_error/ns:ErrorReport/StackTrace"/>
                                            </StackTrace>
                                        </xsl:if>
                                        <ErrorDate>
                                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                        </ErrorDate>
                                        <xsl:if test="$_error/ns:ErrorReport/ProcessStack">
                                            <StackProcess>
                                                <xsl:value-of select="$_error/ns:ErrorReport/ProcessStack"/>
                                            </StackProcess>
                                        </xsl:if>
                                        <Severity>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                        </Severity>
                                        <OriginalMessage>
                                            <xsl:value-of select="tib:render-xml($Start/AdapterParameters/pfx:Message)"/>
                                        </OriginalMessage>
                                        <Category>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                        </Category>
                                        <ProcessInputMessage>
                                            <xsl:value-of select="tib:render-xml($Start/AdapterParameters/pfx:Message)"/>
                                        </ProcessInputMessage>
                                        <IsResponse>
                                            <xsl:value-of select="0"/>
                                        </IsResponse>
                                        <MessageType>
                                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                        </MessageType>
                                    </pfx:ErrorMessage>
                                </xsl:otherwise>
                            </xsl:choose>
                        </pfx:ErrorHeader>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:ReprocessingHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:SecurityHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:RoutingHeader"/>
                        <xsl:copy-of select="$ARC_GW_PreGoingAction/ARC_OUTPUTPreGoing_GW/pfx:ArchitectureHeader/pfx:FunctionalData"/>
                    </pfx:ArchitectureHeader>
                    <pfx:Body>
                        <xsl:choose>
                            <xsl:when test="string-length($Catch-Error-Message/pfx:ErrorMessage) > 0">
                                <xsl:copy-of select="$Catch-Error-Message/pfx:ErrorMessage"/>
                            </xsl:when>
                            <xsl:when test="string-length($Catch-group-Message/group/pfx:ErrorMessage) > 0">
                                <xsl:copy-of select="$Catch-group-Message/group/pfx:ErrorMessage"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:copy-of select="$Catch-Other-Errors/exceptiondata"/>
                            </xsl:otherwise>
                        </xsl:choose>
                    </pfx:Body>
                </pfx:Message>
            </IN_SendReply2QueueOrTopic>
        </pd:inputBindings>
