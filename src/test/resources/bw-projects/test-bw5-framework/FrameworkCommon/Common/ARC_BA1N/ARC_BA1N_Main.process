    </pd:activity>
    <pd:activity name="ARC_B1N_PreAction_FrameworkHeader">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>287</pd:x>
        <pd:y>300</pd:y>
        <config>
            <processName>/Common/ARC_BA1N/PreActions/ARC_BA1N_PreAction_FrameworkHeader.process</processName>
        </config>
        <pd:inputBindings>
            <BA1N_Preaction>
                <pfx12:Message>
                    <xsl:copy-of select="$Parse-XML/pfx12:Message/pfx12:ArchitectureHeader"/>
                    <xsl:copy-of select="$Parse-XML/pfx12:Message/pfx12:Body"/>
                </pfx12:Message>
                <ServiceId>
                    <xsl:value-of select="$ServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/ARC_BA1N_Main_IN/pfx12:TraceLevel">
                        <pfx12:TraceLevel>
                            <xsl:value-of select="$Start/ARC_BA1N_Main_IN/pfx12:TraceLevel"/>
                        </pfx12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <pfx12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </pfx12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
                <E2EControl>
                    <xsl:value-of select="false()"/>
                </E2EControl>
                <xsl:if test="string-length($Start/ARC_BA1N_Main_IN/pfx12:ECSServiceHeader/pfx12:namespace)>0">
                    <pfx12:ECSConfig>
                        <pfx12:namespace>
                            <xsl:value-of select="$Start/ARC_BA1N_Main_IN/pfx12:ECSServiceHeader/pfx12:namespace"/>
                        </pfx12:namespace>
                        <pfx12:mrId>
                            <xsl:value-of select="$Start/ARC_BA1N_Main_IN/pfx12:ECSServiceHeader/pfx12:mrId"/>
                        </pfx12:mrId>
                        <pfx12:genMetrics>
                            <xsl:value-of select="$Start/ARC_BA1N_Main_IN/pfx12:ECSServiceHeader/pfx12:genMetrics"/>
                        </pfx12:genMetrics>
                    </pfx12:ECSConfig>
                </xsl:if>
            </BA1N_Preaction>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>976</pd:x>
        <pd:y>298</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <xsl:choose>
                        <xsl:when test="string-length($Catch-Error-message/pfx12:ErrorMessage/ErrorCode)>0">
                            <EventCode>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorCode"/>
                            </EventCode>
                        </xsl:when>
                        <xsl:otherwise>
                            <EventCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </EventCode>
                        </xsl:otherwise>
                    </xsl:choose>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="0"/>
                    </isResponse>
                    <TraceLevel>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_Trace"/>
                    </TraceLevel>
                    <NameValue>
                        <Name>
                            <xsl:value-of select="&quot;SERVICETYPE&quot;"/>
                        </Name>
                        <Value>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_Batch12N"/>
                        </Value>
                    </NameValue>
                </CLETraceData>
                <xsl:choose>
                    <xsl:when test="string-length($Catch-Error-message/pfx12:ErrorMessage/ErrorCode)>0">
                        <pfx12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorCode"/>
                            </ErrorCode>
                            <xsl:if test="$Catch-Error-message/pfx12:ErrorMessage/ErrorDescription">
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorDescription">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-message/pfx12:ErrorMessage/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorDate"/>
                            </ErrorDate>
                            <xsl:if test="$Catch-Error-message/pfx12:ErrorMessage/StackProcess">
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/Severity"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN/Message)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/Category"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ProcessInputMessage"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/IsResponse"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/MessageType"/>
                            </MessageType>
                            <xsl:copy-of select="$Catch-Error-message/pfx12:ErrorMessage/PreviousErrorMessage"/>
                            <xsl:copy-of select="$Catch-Error-message/pfx12:ErrorMessage/FunctionalErrorData"/>
                        </pfx12:ErrorMessage>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:choose>
                            <xsl:when test="string-length($ParseOriginalErrorMessage/pfx12:ErrorMessage)>0">
                                <xsl:copy-of select="$ParseOriginalErrorMessage/pfx12:ErrorMessage"/>
                            </xsl:when>
                            <xsl:otherwise>
                                <pfx12:ErrorMessage>
                                    <ErrorCode>
                                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                    </ErrorCode>
                                    <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                        <ErrorDescription>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                        </ErrorDescription>
                                    </xsl:if>
                                    <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                                        <NativeErrorCode>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                        </NativeErrorCode>
                                    </xsl:if>
                                    <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                        <NativeErrorDescription>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                        </NativeErrorDescription>
                                    </xsl:if>
                                    <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                                        <StackTrace>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                        </StackTrace>
                                    </xsl:if>
                                    <ErrorDate>
                                        <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                    </ErrorDate>
                                    <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                                        <StackProcess>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                        </StackProcess>
                                    </xsl:if>
                                    <Severity>
                                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                    </Severity>
                                    <OriginalMessage>
                                        <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN/Message)"/>
                                    </OriginalMessage>
                                    <Category>
                                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                    </Category>
                                    <ProcessInputMessage>
                                        <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN)"/>
                                    </ProcessInputMessage>
                                    <IsResponse>
                                        <xsl:value-of select="0"/>
                                    </IsResponse>
                                    <MessageType>
                                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                    </MessageType>
                                </pfx12:ErrorMessage>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:otherwise>
                </xsl:choose>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FunctionalErrorValidation">
