                                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                                            <NativeErrorCode>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                            </NativeErrorCode>
                                        </xsl:if>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                            <NativeErrorDescription>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                            </NativeErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                                            <StackTrace>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                            </StackTrace>
                                        </xsl:if>
                                        <ErrorDate>
                                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                        </ErrorDate>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                                            <StackProcess>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                            </StackProcess>
                                        </xsl:if>
                                        <Severity>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                        </Severity>
                                        <OriginalMessage>
                                            <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN/Message)"/>
                                        </OriginalMessage>
                                        <Category>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                        </Category>
                                        <ProcessInputMessage>
                                            <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN)"/>
                                        </ProcessInputMessage>
                                        <IsResponse>
                                            <xsl:value-of select="0"/>
                                        </IsResponse>
                                        <MessageType>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                        </MessageType>
                                    </pfx12:ErrorMessage>
                                </xsl:otherwise>
                            </xsl:choose>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </ns4:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Generate Error by ARC_BA1N 1">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>1164</pd:x>
        <pd:y>430</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns4:ActivityInput>
                <data>
                    <xsl:choose xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
                        <xsl:when test="string-length($Catch-Error-message/pfx12:ErrorMessage/ErrorCode)>0">
                            <pfx12:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorCode"/>
                                </ErrorCode>
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ErrorDate"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/Severity"/>
                                </Severity>
                                <OriginalMessage>
                                    <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN/Message/*)"/>
                                </OriginalMessage>
                                <Category>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/Category"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/ProcessInputMessage"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/IsResponse"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$Catch-Error-message/pfx12:ErrorMessage/MessageType"/>
                                </MessageType>
                            </pfx12:ErrorMessage>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:choose>
                                <xsl:when test="string-length($ParseOriginalErrorMessage/pfx12:ErrorMessage)>0">
                                    <xsl:copy-of select="$ParseOriginalErrorMessage/pfx12:ErrorMessage"/>
                                </xsl:when>
                                <xsl:otherwise>
                                    <pfx12:ErrorMessage>
                                        <ErrorCode>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                        </ErrorCode>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                            <ErrorDescription>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                            </ErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                                            <NativeErrorCode>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                            </NativeErrorCode>
                                        </xsl:if>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                            <NativeErrorDescription>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                            </NativeErrorDescription>
                                        </xsl:if>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                                            <StackTrace>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                            </StackTrace>
                                        </xsl:if>
                                        <ErrorDate>
                                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                        </ErrorDate>
                                        <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                                            <StackProcess>
                                                <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                            </StackProcess>
                                        </xsl:if>
                                        <Severity>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                        </Severity>
                                        <OriginalMessage>
                                            <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN/Message)"/>
                                        </OriginalMessage>
                                        <Category>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                        </Category>
                                        <ProcessInputMessage>
                                            <xsl:value-of select="tib:render-xml($Start/ARC_BA1N_Main_IN)"/>
                                        </ProcessInputMessage>
                                        <IsResponse>
                                            <xsl:value-of select="0"/>
                                        </IsResponse>
                                        <MessageType>
                                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                        </MessageType>
                                    </pfx12:ErrorMessage>
                                </xsl:otherwise>
                            </xsl:choose>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </ns4:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Parse XML">
