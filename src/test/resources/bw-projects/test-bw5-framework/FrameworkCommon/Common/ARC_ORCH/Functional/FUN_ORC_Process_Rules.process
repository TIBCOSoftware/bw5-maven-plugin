<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppA/Schema.xsd" xmlns:pfx14="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/CompuestoAppABC/Schema.xsd" xmlns:pfx13="http://www.bbva.com/EAIFramework" xmlns:pfx12="http://www.tibco.com/ns/no_namespace_schema_location/CommonResources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx11="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Public/Resources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx10="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Public/Schemas/XSD/MCD/Schema.xsd" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx="http://www.example.org/BBVACabecera" xmlns:ns2="http://www.tibco.com/pe/EngineTypes" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns1="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppB/Schema.xsd" xmlns:ns4="http://www.tibco.com/schemas/Servicios Test Framework/Schemas/AppC/Schema.xsd" xmlns:ns3="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx5="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx4="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Export Adapter/MXML.dtd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx3="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:pfx2="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_EXP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/deals/ForwardDeals.xsd" xmlns:pfx9="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Resources/Public/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/Schemas/Schema.xsd" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd3">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_ORCH/Functional/FUN_ORC_Process_Rules.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType ref="pfx13:Messages"/>
    <pd:startX>101</pd:startX>
    <pd:startY>63</pd:startY>
    <pd:returnBindings>
        <ProcessRules>
            <xsl:value-of select="$Parse-XML/pfx10:MCD/pfx10:documentPropertiesMCD/pfx10:producedByMCD/pfx10:userMCD/pfx10:groupMCD"/>
        </ProcessRules>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="ProcessRules" type="xsd:string"/>
    </pd:endType>
    <pd:endX>599</pd:endX>
    <pd:endY>64</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx13:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1292831667099</pd:targetNamespace>
    <pd:activity name="Catch">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>250</pd:x>
        <pd:y>154</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate ErrorMessage">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>378</pd:x>
        <pd:y>162</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <pfx13:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Generic_Error_RoutingFromFileByServiceId"/>
                        </ErrorDescription>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/MsgCode)>0">
                            <NativeErrorCode>
                                <xsl:value-of select="$_error/ns2:ErrorReport/MsgCode"/>
                            </NativeErrorCode>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/Msg)>0">
                            <NativeErrorDescription>
                                <xsl:value-of select="$_error/ns2:ErrorReport/Msg"/>
                            </NativeErrorDescription>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/StackTrace)>0">
                            <StackTrace>
                                <xsl:value-of select="$_error/ns2:ErrorReport/StackTrace"/>
                            </StackTrace>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns2:ErrorReport/ProcessStack)>0">
                            <StackProcess>
                                <xsl:value-of select="$_error/ns2:ErrorReport/ProcessStack"/>
                            </StackProcess>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/pfx13:Messages)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx13:ErrorMessage>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Parse XML">
        <pd:type>com.tibco.plugin.xml.XMLParseActivity</pd:type>
        <pd:resourceType>ae.activities.XMLParseActivity</pd:resourceType>
        <pd:x>309</pd:x>
        <pd:y>64</pd:y>
        <config>
            <inputStyle>text</inputStyle>
            <xsdVersion>default</xsdVersion>
            <validateOutput>true</validateOutput>
            <term ref="pfx10:MCD"/>
        </config>
        <pd:inputBindings>
            <xmlString>
                <xsl:value-of select="tib:render-xml($Start/pfx13:Messages/pfx13:Message[last()]/pfx13:Body/*)"/>
            </xmlString>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Catch</pd:from>
        <pd:to>Generate ErrorMessage</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Parse XML</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Parse XML</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>