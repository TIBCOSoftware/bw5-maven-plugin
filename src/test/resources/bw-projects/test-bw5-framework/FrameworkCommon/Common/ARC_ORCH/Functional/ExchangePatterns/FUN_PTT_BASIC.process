<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns="http://www.tibco.com/pe/EngineTypes" xmlns:ns0="http://www.tibco.com/pe/SignalInActivitySchema" xmlns:UUID="java://Framework.CommonResources.CustomFunctions.UUIDGenerator.UUIDGenerator" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx2="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:ns12="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx="http://www.bbva.com/EAIFramework">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_ORCH/Functional/ExchangePatterns/FUN_PTT_BASIC.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="IN_GetRoutedMessage">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:Messages"/>
                    <xsd:element name="DynamicInvocationRoot" type="xsd:string"/>
                    <xsd:element name="ServiceId" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>28</pd:startX>
    <pd:startY>249</pd:startY>
    <pd:returnBindings>
        <OUT_GetRoutedMessages>
            <xsl:if test="count($ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message)>0">
                <pfx:Message>
                    <pfx:ArchitectureHeader>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:AuditHeader"/>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:ECSHeader"/>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:RequestHeader"/>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:ErrorHeader"/>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:ReprocessingHeader"/>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:SecurityHeader"/>
                        <pfx:RoutingHeader>
                            <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Origin"/>
                            <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target"/>
                        </pfx:RoutingHeader>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:FunctionalData"/>
                    </pfx:ArchitectureHeader>
                    <pfx:Body>
                        <xsl:copy-of select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:Body/*"/>
                    </pfx:Body>
                </pfx:Message>
            </xsl:if>
        </OUT_GetRoutedMessages>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endType>
        <xsd:element name="OUT_GetRoutedMessages">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="pfx:Message" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:endType>
    <pd:endX>441</pd:endX>
    <pd:endY>250</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="pfx:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1380098109578</pd:targetNamespace>
    <pd:activity name="Catch Error message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>122</pd:x>
        <pd:y>347</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>false</catchAll>
            <fault>localname=ErrorMessage namespace=http://www.bbva.com/EAIFramework</fault>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Rethrow">
        <pd:type>com.tibco.pe.core.RethrowActivity</pd:type>
        <pd:resourceType>ae.activities.rethrow</pd:resourceType>
        <pd:x>307</pd:x>
        <pd:y>342</pd:y>
        <config/>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="ARC_ORC_Basic">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>159</pd:x>
        <pd:y>247</pd:y>
        <config>
            <processNameXPath/>
            <processName>/Common/ARC/ARC_RoutingHelper/ARC_RoutingBasicRulesSelection.process</processName>
        </config>
        <pd:inputBindings>
            <IN_GetRoutedMessage>
                <xsl:copy-of select="$Start/IN_GetRoutedMessage/pfx:Messages"/>
                <DynamicInvocationRoot>
                    <xsl:value-of select="$Start/IN_GetRoutedMessage/DynamicInvocationRoot"/>
                </DynamicInvocationRoot>
                <ServiceId>
                    <xsl:value-of select="$Start/IN_GetRoutedMessage/ServiceId"/>
                </ServiceId>
            </IN_GetRoutedMessage>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Other Errors">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
        <pd:resourceType>ae.activities.catch</pd:resourceType>
        <pd:x>121</pd:x>
        <pd:y>443</pd:y>
        <pd:handler>true</pd:handler>
        <config>
            <catchAll>true</catchAll>
        </config>
        <pd:inputBindings/>
    </pd:activity>
    <pd:activity name="Generate ErrorMessage">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>398</pd:x>
        <pd:y>455</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <ns12:ActivityInput>
                <data>
                    <pfx:ErrorMessage>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                        </ErrorCode>
                        <ErrorDescription>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_Generic_Error_RoutingFromFileByServiceId"/>
                        </ErrorDescription>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if xmlns:xsl="http://www.w3.org/1999/XSL/Transform" test="string-length($_error/ns:ErrorReport/ProcessStack)>0">
                            <StackProcess>
                                <xsl:value-of select="$_error/ns:ErrorReport/ProcessStack"/>
                            </StackProcess>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/IN_GetRoutedMessage)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns1:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </pfx:ErrorMessage>
                </data>
            </ns12:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="UpdateTargetServiceHeader">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>311</pd:x>
        <pd:y>250</pd:y>
        <config>
            <processName>/Common/ARC/ARC_HeaderManagement/ARC_SetHeaderRoutingServices.process</processName>
        </config>
        <pd:inputBindings>
            <IN_GetTargetServices>
                <xsl:for-each select="$ARC_ORC_Basic/OUT_GetRoutedMessages/pfx:Message/pfx:ArchitectureHeader/pfx:RoutingHeader/pfx:Target/pfx:Services/pfx:Service">
                    <pfx:RoutingService>
                        <pfx:ServiceId>
                            <xsl:value-of select="pfx:ServiceId"/>
                        </pfx:ServiceId>
                        <xsl:if test="pfx:JMSInputDestinationName">
                            <pfx:JMSInputDestinationName>
                                <xsl:value-of select="pfx:JMSInputDestinationName"/>
                            </pfx:JMSInputDestinationName>
                        </xsl:if>
                        <xsl:if test="pfx:JMSInputDestinationType">
                            <pfx:JMSInputDestinationType>
                                <xsl:value-of select="pfx:JMSInputDestinationType"/>
                            </pfx:JMSInputDestinationType>
                        </xsl:if>
                        <pfx:ServiceType>
                            <xsl:value-of select="pfx:ServiceType"/>
                        </pfx:ServiceType>
                    </pfx:RoutingService>
                </xsl:for-each>
            </IN_GetTargetServices>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Catch Error message</pd:from>
        <pd:to>Rethrow</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>ARC_ORC_Basic</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch Other Errors</pd:from>
        <pd:to>Generate ErrorMessage</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ARC_ORC_Basic</pd:from>
        <pd:to>UpdateTargetServiceHeader</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>UpdateTargetServiceHeader</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:label>
        <pd:name>Label (2)</pd:name>
        <pd:description>Rellenar los campos:
- código del error
- severidad</pd:description>
        <pd:x>426</pd:x>
        <pd:y>334</pd:y>
        <pd:width>136</pd:width>
        <pd:height>63</pd:height>
        <pd:fontName>Dialog.bold-plain-12</pd:fontName>
        <pd:fontColor>-16777216</pd:fontColor>
        <pd:color>-6684673</pd:color>
        <pd:type>solid</pd:type>
        <pd:thickness>0</pd:thickness>
        <pd:fade>true</pd:fade>
    </pd:label>
</pd:ProcessDefinition>