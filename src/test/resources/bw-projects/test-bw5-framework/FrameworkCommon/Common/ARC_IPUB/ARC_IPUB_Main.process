<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:BW="java://com.tibco.pe.core.JavaCustomXPATHFunctions" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/jms" xmlns:pfx111="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/ServiceParameters/SR/Schema.xsd" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:pfx11="http://www.tibco.com/schemas/Framework/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx1="http://www.example.com/PROCESO_SINCRONO" xmlns:pfx10="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:UUID="java://EAIFramework.Processes.Private.Common.HeaderManagement.UUIDGenerator.UUIDGenerator" xmlns:pfx81="http://www.tibco.com/ns/no_namespace_schema_location/EAI-Framework/Public/Resources/Schemas/XSD/MUREX/MXML.dtd" xmlns:pfx31="http://www.tibco.com/schemas/AW_ArquitecturaComun/RecursosComunes/Esquemas/EsquemasArquitectura/AW_gestionErrores/Schema.xsd" xmlns:pfx5="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/EAI-Framework/Resources/Public/Schemas/Schema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:pfx4="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx3="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Import Adapter/AsyncrhonousImporterSchema.xsd" xmlns:pfx2="http://www.tibco.com/ns/no_namespace_schema_location/ASINC_IMP_RecursosComunes/Esquemas/Patron_Asincrono/Modelo Comun/main/ForwardDealsEvent.xsd" xmlns:pfx9="http://www.tibco.com/schemas/FrameworkIntegracion1.1/CommonResources/Schemas/XSD/Schema.xsd" xmlns:pfx8="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/ASINC_IMP_CommonResources/Schemas/Schema.xsd" xmlns:pfx7="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC/ASINC_IMP/ASINC_IMP_RecursosComunes/Esquemas/Schema.xsd" xmlns:pfx6="http://www.tibco.com/schemas/FrameworkIntegracion/ASINC_EXP_RecursosComunes/Esquemas/Schema.xsd2" xmlns:pfx51="http://www.tibco.com/ns/no_namespace_schema_location/SINC_CONS_RecursosComunes/Esquemas/XSD/Patron_Sincrono/ModeloComun/MLC/NM_MLC.xsd" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns5="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions" xmlns:ns12="http://www.bbva.com/EAIFramework" xmlns:ns31="http://www.tibco.com/pe/SignalInActivitySchema" xmlns:ns6="http://schemas.tibco.com/bw/plugins/jms/5.0/jmsExceptions" xmlns:pfx71="http://www.tibco.com/schemas/FrameworkIntegracion/EAI-Framework/Resources/Private/Schemas/SINC_SimpleService/Schema.xsd" xmlns:pfx="http://www.example.org/BBVACabecera" xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns1="http://www.tibco.com/pe/EngineTypes" xmlns:ns3="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:pfx21="http://xmlns.example.com/PROCESO_SINCRONO" xmlns:Resources="java://Resources">
    <xsd:import namespace="http://www.bbva.com/EAIFramework" schemaLocation="/SharedResources/Schemas/XSD/ArchitectureSchema.xsd"/>
    <pd:name>Common/ARC_IPUB/ARC_IPUB_Main.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType>
        <xsd:element name="group">
            <xsd:complexType>
                <xsd:sequence>
                    <xsd:element ref="ns12:Message"/>
                    <xsd:element ref="ns12:ImportEventAdapterParameters"/>
                    <xsd:element ref="ns12:TraceLevel" minOccurs="0"/>
                    <xsd:element ref="ns12:ECSConfig" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
    </pd:startType>
    <pd:startX>44</pd:startX>
    <pd:startY>54</pd:startY>
    <pd:returnBindings>
        <xsl:copy-of select="$FUN_IPUB_InboundFunctional/*"/>
    </pd:returnBindings>
    <pd:endName>End</pd:endName>
    <pd:endX>948</pd:endX>
    <pd:endY>54</pd:endY>
    <pd:errorSchemas>
        <ErrorSchema ref="ns12:ErrorMessage"/>
    </pd:errorSchemas>
    <pd:processVariables>
        <VarDynamicProcess>
            <xsd:element name="Input">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="mapper" type="xsd:string"/>
                        <xsd:element name="backend" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </VarDynamicProcess>
    </pd:processVariables>
    <pd:targetNamespace>http://xmlns.example.com/1292831516672</pd:targetNamespace>
    <pd:activity name="ARC_CLESenderAPI">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>483</pd:x>
        <pd:y>295</pd:y>
        <config>
            <processName>/Common/ARC/ARC_CLEManagement/ARC_TraceAuditSenderAPI.process</processName>
        </config>
        <pd:coercions>
            <pd:coercion xpath="$Start/group/ns12:Message/ns12:Body/*" element="ns12:Event"/>
        </pd:coercions>
        <pd:inputBindings>
            <ARC_TraceSenderAPI>
                <CLETraceData>
                    <xsl:choose>
                        <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                            <EventCode>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                            </EventCode>
                        </xsl:when>
                        <xsl:otherwise>
                            <EventCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </EventCode>
                        </xsl:otherwise>
                    </xsl:choose>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Error"/>
                    </EventType>
                    <MessageType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_ProprietaryDataModel"/>
                    </MessageType>
                    <isResponse>
                        <xsl:value-of select="0"/>
                    </isResponse>
                    <TraceLevel>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_Trace"/>
                    </TraceLevel>
                    <xsl:if test="local-name($Start/group/ns12:Message/ns12:Body/*)=&quot;Event&quot;">
                        <NameValue>
                            <Name>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTNAME"/>
                            </Name>
                            <Value>
                                <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventName"/>
                            </Value>
                        </NameValue>
                        <NameValue>
                            <Name>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/EVENTYPE"/>
                            </Name>
                            <Value>
                                <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventType"/>
                            </Value>
                        </NameValue>
                    </xsl:if>
                </CLETraceData>
                <xsl:choose>
                    <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                            </ErrorCode>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/ErrorDescription">
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorDescription">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDate"/>
                            </ErrorDate>
                            <xsl:if test="$Catch-Error-Message/ns12:ErrorMessage/StackProcess">
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Severity"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/group/ns12:Message)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Category"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ProcessInputMessage"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/IsResponse"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/MessageType"/>
                            </MessageType>
                            <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/PreviousErrorMessage"/>
                            <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/FunctionalErrorData"/>
                        </ns12:ErrorMessage>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:ErrorMessage>
                            <ErrorCode>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                            </ErrorCode>
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                            <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                            <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                            <ErrorDate>
                                <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                            </ErrorDate>
                            <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                            <Severity>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                            </Severity>
                            <OriginalMessage>
                                <xsl:value-of select="tib:render-xml($Start/group/ns12:Message)"/>
                            </OriginalMessage>
                            <Category>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                            </Category>
                            <ProcessInputMessage>
                                <xsl:value-of select="tib:render-xml($Start/group)"/>
                            </ProcessInputMessage>
                            <IsResponse>
                                <xsl:value-of select="0"/>
                            </IsResponse>
                            <MessageType>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                            </MessageType>
                        </ns12:ErrorMessage>
                    </xsl:otherwise>
                </xsl:choose>
            </ARC_TraceSenderAPI>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_FunctionalErrorValidation">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>608</pd:x>
        <pd:y>168</pd:y>
        <config>
            <processName>/Common/ARC/ARC_FunctionalErrorValidation/ARC_FunctionalErrorValidation.process</processName>
        </config>
        <pd:inputBindings>
            <xsl:choose>
                <xsl:when test="not(empty($_error_FUN_IPUB_InboundFunctional))">
                    <root>
                        <xsl:copy-of select="$_error_FUN_IPUB_InboundFunctional/ns12:ErrorMessage"/>
                        <ErrorReport>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/ancestor-or-self::*/namespace::node()"/>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/@*"/>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/node()"/>
                        </ErrorReport>
                    </root>
                </xsl:when>
                <xsl:otherwise>
                    <root>
                        <xsl:copy-of select="$_error_FUN_IPUB_Request2BackEnd/ns12:ErrorMessage"/>
                        <ErrorReport>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/ancestor-or-self::*/namespace::node()"/>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/@*"/>
                            <xsl:copy-of select="$_error/ns1:ErrorReport/node()"/>
                        </ErrorReport>
                    </root>
                </xsl:otherwise>
            </xsl:choose>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IPUB_PostGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>806</pd:x>
        <pd:y>54</pd:y>
        <config>
            <processName>/Common/ARC_IPUB/PostActions/ARC_IPUB_PostGoingAction.process</processName>
            <processNameXPath/>
        </config>
        <pd:inputBindings>
            <root>
                <ns12:Message>
                    <xsl:copy-of select="$ARC_IPUB_PreGoingAction/ns12:ArchitectureHeader"/>
                    <ns12:Body>
                        <xsl:copy-of select="$FUN_IPUB_InboundFunctional/*"/>
                    </ns12:Body>
                </ns12:Message>
                <xsl:choose>
                    <xsl:when test="$Start/group/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/group/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
            </root>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_IPUB_PreGoingAction">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>291</pd:x>
        <pd:y>53</pd:y>
        <config>
            <processName>/Common/ARC_IPUB/PreActions/ARC_IPUB_PreGoingAction.process</processName>
        </config>
        <pd:inputBindings>
            <group>
                <CDMMessage>
                    <xsl:copy-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader"/>
                    <Body>
                        <xsl:copy-of select="$Start/group/ns12:Message/ns12:Body/ancestor-or-self::*/namespace::node()"/>
                        <xsl:copy-of select="$Start/group/ns12:Message/ns12:Body/@*"/>
                        <xsl:copy-of select="$Start/group/ns12:Message/ns12:Body/node()"/>
                    </Body>
                </CDMMessage>
                <ServiceId>
                    <xsl:value-of select="$ServiceId/GetServiceIdParams/ServiceId"/>
                </ServiceId>
                <xsl:choose>
                    <xsl:when test="$Start/group/ns12:TraceLevel">
                        <ns12:TraceLevel>
                            <xsl:value-of select="$Start/group/ns12:TraceLevel"/>
                        </ns12:TraceLevel>
                    </xsl:when>
                    <xsl:otherwise>
                        <ns12:TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_ZeroAudit"/>
                        </ns12:TraceLevel>
                    </xsl:otherwise>
                </xsl:choose>
                <xsl:copy-of select="$Start/group/ns12:ECSConfig"/>
            </group>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="ARC_TrackingErrorManagement">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>487</pd:x>
        <pd:y>402</pd:y>
        <config>
            <processName>/Common/ARC/ARC_TrackingManagement/ARC_TrackingErrorManagement.process</processName>
        </config>
        <pd:inputBindings>
            <ns12:CLEMessage>
                <CLEHeader>
                    <E2EId>
                        <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:E2EId"/>
                    </E2EId>
                    <E2EDeepness>
                        <xsl:value-of select="1"/>
                    </E2EDeepness>
                    <InvocationUser>
                        <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BBVAUser"/>
                    </InvocationUser>
                    <BatchId>
                        <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BatchId"/>
                    </BatchId>
                    <EventCode>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_StartError"/>
                    </EventCode>
                    <EventType>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/EventType/GLB_Trace"/>
                    </EventType>
                    <Timestamp>
                        <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                    </Timestamp>
                    <xsl:choose>
                        <xsl:when test="string-length($ServiceId/GetServiceIdParams/ServiceId)>0">
                            <ServiceId>
                                <xsl:value-of select="$ServiceId/GetServiceIdParams/ServiceId"/>
                            </ServiceId>
                        </xsl:when>
                        <xsl:otherwise>
                            <ServiceId>
                                <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/GenericConstants/GLB_Generic_User"/>
                            </ServiceId>
                        </xsl:otherwise>
                    </xsl:choose>
                    <InstanceId>
                        <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/InternalConstants/GLB_InstancedIdNoInitialized"/>
                    </InstanceId>
                    <ProjectName>
                        <xsl:value-of select="$_processContext/ns1:ProcessContext/ProjectName"/>
                    </ProjectName>
                    <ProcessName>
                        <xsl:value-of select="BW:getCurrentProcessName($_processContext/ns1:ProcessContext/ProcessId)"/>
                    </ProcessName>
                    <EngineName>
                        <xsl:value-of select="$_processContext/ns1:ProcessContext/EngineName"/>
                    </EngineName>
                    <MachineName>
                        <xsl:value-of select="BW:getHostName()"/>
                    </MachineName>
                    <MessageHeader>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                        <BusinessObject>
                            <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                        </BusinessObject>
                    </MessageHeader>
                    <AuditHeader>
                        <xsl:if test="string-length($Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ParentInstanceId)>0">
                            <xsl:if test="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ParentInstanceId">
                                <ParentInstanceId>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:AuditHeader/ns12:ParentInstanceId"/>
                                </ParentInstanceId>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader">
                            <RetriesNumber>
                                <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader/ns12:RetriesNumber"/>
                            </RetriesNumber>
                        </xsl:if>
                        <xsl:if test="string-length($Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId)>0">
                            <xsl:if test="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId">
                                <ClientExternalId>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ExternalId"/>
                                </ClientExternalId>
                            </xsl:if>
                        </xsl:if>
                        <ServiceType>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/ServiceType/GLB_ImportationEventPublication"/>
                        </ServiceType>
                        <xsl:if test="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader">
                            <OriginalInstanceId>
                                <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:ReprocessingHeader/ns12:OriginalInstanceId"/>
                            </OriginalInstanceId>
                        </xsl:if>
                        <TraceLevel>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/TraceLevels/GLB_Critical"/>
                        </TraceLevel>
                        <StarterServiceId>
                            <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:ServiceIdStarter"/>
                        </StarterServiceId>
                        <StarterTimestamp>
                            <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:StartTimestamp"/>
                        </StarterTimestamp>
                    </AuditHeader>
                    <ErrorHeader>
                        <ErrorCode>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_StartError"/>
                        </ErrorCode>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <ErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </ErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                <NativeErrorCode>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                </NativeErrorCode>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                <NativeErrorDescription>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                </NativeErrorDescription>
                            </xsl:if>
                        </xsl:if>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                <StackTrace>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                </StackTrace>
                            </xsl:if>
                        </xsl:if>
                        <ErrorDate>
                            <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                        </ErrorDate>
                        <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                            <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                <StackProcess>
                                    <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                </StackProcess>
                            </xsl:if>
                        </xsl:if>
                        <Severity>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                        </Severity>
                        <OriginalMessage>
                            <xsl:value-of select="tib:render-xml($Start/group/ns12:Message)"/>
                        </OriginalMessage>
                        <Category>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                        </Category>
                        <ProcessInputMessage>
                            <xsl:value-of select="tib:render-xml($Start/group)"/>
                        </ProcessInputMessage>
                        <IsResponse>
                            <xsl:value-of select="0"/>
                        </IsResponse>
                        <MessageType>
                            <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                        </MessageType>
                    </ErrorHeader>
                </CLEHeader>
            </ns12:CLEMessage>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Catch Error Message">
        <pd:type>com.tibco.pe.core.CatchActivity</pd:type>
