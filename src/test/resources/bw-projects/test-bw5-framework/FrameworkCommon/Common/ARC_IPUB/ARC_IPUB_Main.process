    <pd:activity name="Dynamic Tokens">
        <pd:type>com.tibco.pe.core.AssignActivity</pd:type>
        <pd:resourceType>ae.activities.assignActivity</pd:resourceType>
        <pd:x>408</pd:x>
        <pd:y>53</pd:y>
        <config>
            <variableName>VarDynamicProcess</variableName>
        </config>
        <pd:inputBindings>
            <xsl:choose>
                <xsl:when test="local-name($Start/group/ns12:Message/ns12:Body/*)=&quot;Event&quot;">
                    <Input>
                        <xsl:choose>
                            <xsl:when test="Resources:existResource(concat($ServiceId/GetServiceIdParams/DynamicInvocationRoot, $_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Map/GLB_Inbound,&quot;Map-&quot;, $Start/group/ns12:Message/ns12:Body/ns12:Event/EventName,&quot;.process&quot;))">
                                <mapper>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventName"/>
                                </mapper>
                            </xsl:when>
                            <xsl:otherwise>
                                <mapper>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventType"/>
                                </mapper>
                            </xsl:otherwise>
                        </xsl:choose>
                        <xsl:choose>
                            <xsl:when test="Resources:existResource(concat($ServiceId/GetServiceIdParams/DynamicInvocationRoot, $_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/IMPAMultiObject/GLB_BackEnd, $Start/group/ns12:Message/ns12:Body/ns12:Event/EventName,&quot;.process&quot;))">
                                <backend>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventName"/>
                                </backend>
                            </xsl:when>
                            <xsl:otherwise>
                                <backend>
                                    <xsl:value-of select="$Start/group/ns12:Message/ns12:Body/ns12:Event/EventType"/>
                                </backend>
                            </xsl:otherwise>
                        </xsl:choose>
                    </Input>
                </xsl:when>
                <xsl:otherwise>
                    <Input>
                        <mapper>
                            <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                        </mapper>
                        <backend>
                            <xsl:value-of select="$Start/group/ns12:Message/ns12:ArchitectureHeader/ns12:RequestHeader/ns12:BusinessObject"/>
                        </backend>
                    </Input>
                </xsl:otherwise>
            </xsl:choose>
        </pd:inputBindings>
    </pd:activity>
