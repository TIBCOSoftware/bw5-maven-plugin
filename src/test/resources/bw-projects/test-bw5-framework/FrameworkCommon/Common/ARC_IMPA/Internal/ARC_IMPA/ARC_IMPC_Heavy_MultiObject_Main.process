    <pd:activity name="FUN_IMPA_InboundFunctional">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>723</pd:x>
        <pd:y>56</pd:y>
        <config>
            <processNameXPath>concat($ServiceId/GetServiceIdParams/DynamicInvocationRoot, $_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/DynamicBusinessInvocations/Types/Map/GLB_Inbound,"Map-", $GetBusinessObject/BusinessObject ,".process")</processNameXPath>
