    <pd:activity name="Generate by ARC_IMPA_MultiObject">
        <pd:type>com.tibco.pe.core.GenerateErrorActivity</pd:type>
        <pd:resourceType>ae.activities.throw</pd:resourceType>
        <pd:x>688</pd:x>
        <pd:y>376</pd:y>
        <config>
            <faultName>ErrorSchema</faultName>
        </config>
        <pd:inputBindings>
            <pfx10:ActivityInput>
                <data>
                    <xsl:choose>
                        <xsl:when test="string-length($Catch-Error-Message/ns12:ErrorMessage/ErrorCode)>0">
                            <ns12:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorCode"/>
                                </ErrorCode>
                                <ErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDescription"/>
                                </ErrorDescription>
                                <NativeErrorCode>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorCode"/>
                                </NativeErrorCode>
                                <NativeErrorDescription>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/NativeErrorDescription"/>
                                </NativeErrorDescription>
                                <StackTrace>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackTrace"/>
                                </StackTrace>
                                <ErrorDate>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ErrorDate"/>
                                </ErrorDate>
                                <StackProcess>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/StackProcess"/>
                                </StackProcess>
                                <Severity>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Severity"/>
                                </Severity>
                                <OriginalMessage>
                                    <xsl:value-of select="tib:render-xml($Start/group/ns12:Message)"/>
                                </OriginalMessage>
                                <Category>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/Category"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/ProcessInputMessage"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/IsResponse"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$Catch-Error-Message/ns12:ErrorMessage/MessageType"/>
                                </MessageType>
                                <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/PreviousErrorMessage"/>
                                <xsl:copy-of select="$Catch-Error-Message/ns12:ErrorMessage/FunctionalErrorData"/>
                            </ns12:ErrorMessage>
                        </xsl:when>
                        <xsl:otherwise>
                            <ns12:ErrorMessage>
                                <ErrorCode>
                                    <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GLB_CTE/ArchitectureParameters/CLECodes/Errors/GLB_ArchitectureCode"/>
                                </ErrorCode>
                                <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                    <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                        <ErrorDescription>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                        </ErrorDescription>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:if test="string-length($_error/ns1:ErrorReport/MsgCode)>0">
                                    <xsl:if test="$_error/ns1:ErrorReport/MsgCode">
                                        <NativeErrorCode>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/MsgCode"/>
                                        </NativeErrorCode>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:if test="string-length($_error/ns1:ErrorReport/Msg)>0">
                                    <xsl:if test="$_error/ns1:ErrorReport/Msg">
                                        <NativeErrorDescription>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/Msg"/>
                                        </NativeErrorDescription>
                                    </xsl:if>
                                </xsl:if>
                                <xsl:if test="string-length($_error/ns1:ErrorReport/StackTrace)>0">
                                    <xsl:if test="$_error/ns1:ErrorReport/StackTrace">
                                        <StackTrace>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/StackTrace"/>
                                        </StackTrace>
                                    </xsl:if>
                                </xsl:if>
                                <ErrorDate>
                                    <xsl:value-of select="tib:current-dateTime-timezone(0,0)"/>
                                </ErrorDate>
                                <xsl:if test="string-length($_error/ns1:ErrorReport/ProcessStack)>0">
                                    <xsl:if test="$_error/ns1:ErrorReport/ProcessStack">
                                        <StackProcess>
                                            <xsl:value-of select="$_error/ns1:ErrorReport/ProcessStack"/>
                                        </StackProcess>
                                    </xsl:if>
                                </xsl:if>
                                <Severity>
                                    <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Severities/GLB_SevereError"/>
                                </Severity>
                                <OriginalMessage>
                                    <xsl:value-of select="tib:render-xml($Start/group/ns12:Message)"/>
                                </OriginalMessage>
                                <Category>
                                    <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/Errors/Categories/GLB_Architecture"/>
                                </Category>
                                <ProcessInputMessage>
                                    <xsl:value-of select="tib:render-xml($Start/group)"/>
                                </ProcessInputMessage>
                                <IsResponse>
                                    <xsl:value-of select="0"/>
                                </IsResponse>
                                <MessageType>
                                    <xsl:value-of select="$_globalVariables/ns3:GlobalVariables/GeneralConstants/MessageType/GLB_CommonDataModel"/>
                                </MessageType>
                            </ns12:ErrorMessage>
                        </xsl:otherwise>
                    </xsl:choose>
                </data>
            </pfx10:ActivityInput>
        </pd:inputBindings>
    </pd:activity>
