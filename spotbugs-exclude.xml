<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
        Maven plugins use @Parameter fields that are injected by the Maven container.
        SpotBugs sees these as "unread" or "uninitialized" fields, which is a false positive.
    -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,URF_UNREAD_FIELD,UUF_UNUSED_FIELD"/>
        <Class name="~com\.tibco\.bw\.maven\.plugin\.packaging\..*Mojo"/>
    </Match>

    <!--
        SAXBuilder parsing local project files (not untrusted network input).
        XXE is not a realistic threat for a Maven build plugin reading local files.
    -->
    <Match>
        <Bug pattern="XXE_SAXPARSER,XXE_XMLREADER,XXE_DOCUMENT"/>
    </Match>

    <!--
        DateFormat used in single-threaded Mojo execute() — not shared across threads.
    -->
    <Match>
        <Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE,STCAL_STATIC_SIMPLE_DATE_FORMAT_INSTANCE"/>
    </Match>

    <!--
        DTO / parser / model fields that are populated from XML during parsing but not
        yet consumed by rendering code. These are intentional data-holder fields, not bugs.
    -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,UUF_UNUSED_FIELD,UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
        <Class name="~com\.tibco\.bw\.maven\.plugin\.descriptor\.(AliasLibParser.*|LibBuilderParser.*|ProcessParser.*)"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,UUF_UNUSED_FIELD,UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
        <Class name="~com\.tibco\.bw\.maven\.plugin\.doc\.(ProcessDocModel.*|SharedResourceModel.*)"/>
    </Match>

    <!--
        MavenProject is a Maven framework object injected by the container — it cannot
        and should not be deep-copied. Suppress EI_EXPOSE_REP2 for the project field.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~com\.tibco\.bw\.maven\.plugin\.doc\.(SiteHtmlGenerator|SiteMarkdownGenerator|SitePdfGenerator)"/>
        <Field name="project"/>
    </Match>

    <!--
        HelpMojo is auto-generated by the maven-plugin-plugin during build.
        Its source is not part of the project and should not be analyzed.
    -->
    <Match>
        <Class name="com.tibco.bw.bw5_maven_plugin.HelpMojo"/>
    </Match>

    <!--
        buildXsdNsIndex / buildXsdElementIndex intentionally swallow JDOMException and
        IOException when a project XSD cannot be parsed — a best-effort index is preferable
        to a build failure for a malformed schema file.
    -->
    <Match>
        <Bug pattern="DE_MIGHT_IGNORE"/>
        <Class name="com.tibco.bw.maven.plugin.packaging.BwEarMojo"/>
        <Method name="~build.*Index"/>
    </Match>

</FindBugsFilter>
